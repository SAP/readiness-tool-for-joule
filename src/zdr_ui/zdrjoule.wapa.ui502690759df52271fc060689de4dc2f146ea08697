sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/base/Object"                                                                                                                                                                                                                                          
], function (Object) {                                                                                                                                                                                                                                         
	var instance;                                                                                                                                                                                                                                                 
	var LogUserHelper = Object.extend("dr.joule.assistant.drjoule.helper.LogUserHelper", {                                                                                                                                                                        
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Create helper                                                                                                                                                                                                                                             
		 * */                                                                                                                                                                                                                                                        
		constructor: function () {                                                                                                                                                                                                                                   
			//Defaulted to a user that can be used in a test environment                                                                                                                                                                                                
			//as there is no user service available that would set this user                                                                                                                                                                                            
			this.user = "MOCKUSER";&nbsp;                                                                                                                                                                                                                               
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Sets the user for which the logs are currently retrieved                                                                                                                                                                                                  
		 *  @param{string}sLogUser - the log user                                                                                                                                                                                                                    
		 * */                                                                                                                                                                                                                                                        
		setLogUser: function(sLogUser) {                                                                                                                                                                                                                             
			this.user = sLogUser;                                                                                                                                                                                                                                       
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Returns if the user for which the logs are currently retrieved                                                                                                                                                                                            
		 *  @returns {string} the log user                                                                                                                                                                                                                           
		 * */                                                                                                                                                                                                                                                        
		getLogUser: function() {                                                                                                                                                                                                                                     
			return this.user;                                                                                                                                                                                                                                           
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
	                                                                                                                                                                                                                                                              
	return {                                                                                                                                                                                                                                                      
		getInstance: function () {                                                                                                                                                                                                                                   
			if (!instance) {                                                                                                                                                                                                                                            
				instance = new LogUserHelper();                                                                                                                                                                                                                            
			}                                                                                                                                                                                                                                                           
			return instance;                                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		destroy: function () {                                                                                                                                                                                                                                       
		if (instance) {                                                                                                                                                                                                                                              
				instance = null;                                                                                                                                                                                                                                           
			}                                                                                                                                                                                                                                                           
		}                                                                                                                                                                                                                                                            
	};                                                                                                                                                                                                                                                            
});                                                                                                                                                                                                                                                            