            /*                                                                                                                                                                                                                                                 
            ========================================================                                                                                                                                                                                           
            RUNTIME OBJECT SCAN                                                                                                                                                                                                                                
            ========================================================                                                                                                                                                                                           
            */                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            function deepScan(                                                                                                                                                                                                                                 
                obj,                                                                                                                                                                                                                                           
                path,                                                                                                                                                                                                                                          
                visited,                                                                                                                                                                                                                                       
                depth                                                                                                                                                                                                                                          
            ) {                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                if (!obj || typeof obj !== "object") {                                                                                                                                                                                                         
                    return;                                                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (visited.has(obj)) {                                                                                                                                                                                                                        
                    return;                                                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                visited.add(obj);                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                if (depth > 5) {                                                                                                                                                                                                                               
                    return;                                                                                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                Object.keys(obj).forEach(function (key) {                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    try {                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        const value = obj[key];                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                        const currentPath = path + "." + key;                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                        if (                                                                                                                                                                                                                                   
                            containsInterestingContent(key)                                                                                                                                                                                                    
                        ) {                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                            logMatch(                                                                                                                                                                                                                          
                                "OBJECT_SCAN",                                                                                                                                                                                                                 
                                currentPath,                                                                                                                                                                                                                   
                                value                                                                                                                                                                                                                          
                            );                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        if (                                                                                                                                                                                                                                   
                            value &&                                                                                                                                                                                                                           
                            typeof value === "object"                                                                                                                                                                                                          
                        ) {                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                            deepScan(                                                                                                                                                                                                                          
                                value,                                                                                                                                                                                                                         
                                currentPath,                                                                                                                                                                                                                   
                                visited,                                                                                                                                                                                                                       
                                depth + 1                                                                                                                                                                                                                      
                            );                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                    } catch (e) { }                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                deepScan(                                                                                                                                                                                                                                      
                    window.sap,                                                                                                                                                                                                                                
                    "window.sap",                                                                                                                                                                                                                              
                    new WeakSet(),                                                                                                                                                                                                                             
                    0                                                                                                                                                                                                                                          
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            } catch (e) {                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                console.error("Deep scan failed", e);                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
