        /**                                                                                                                                                                                                                                                    
         * Returns the shell renderer instance in a reliable way, i.e. independent&nbsp;                                                                                                                                                                       
         * from the initialization time of the plug-in. This means that the current&nbsp;                                                                                                                                                                      
         * renderer is returned immediately, if it is already created (plug-in is&nbsp;                                                                                                                                                                        
         * loaded after renderer creation) or it listens to the &quot;rendererCreated&quot;&nbsp;                                                                                                                                                              
         * event (plug-in is loaded before the renderer is created).                                                                                                                                                                                           
         *                                                                                                                                                                                                                                                     
         *  @returns {object} a jQuery promise, resolved with the renderer instance,&nbsp;                                                                                                                                                                     
         * or rejected with an error message.                                                                                                                                                                                                                  
         */                                                                                                                                                                                                                                                    
        _getRenderer: function () {                                                                                                                                                                                                                            
            var that = this,                                                                                                                                                                                                                                   
                oDeferred = new jQuery.Deferred(),                                                                                                                                                                                                             
                oRenderer;                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            that._oShellContainer = jQuery.sap.getObject("sap.ushell.Container");                                                                                                                                                                              
            if (!that._oShellContainer) {                                                                                                                                                                                                                      
                oDeferred.reject("Illegal state: shell container not available; it must be executed in a unified shell runtime context.");                                                                                                                     
            } else {                                                                                                                                                                                                                                           
                oRenderer = that._oShellContainer.getRenderer();                                                                                                                                                                                               
                if (oRenderer) {                                                                                                                                                                                                                               
                    oDeferred.resolve(oRenderer);                                                                                                                                                                                                              
                } else {                                                                                                                                                                                                                                       
                    // renderer not initialized yet, listen to rendererCreated event                                                                                                                                                                           
                    that._onRendererCreated = function (oEvent) {                                                                                                                                                                                              
                        oRenderer = oEvent.getParameter("renderer");                                                                                                                                                                                           
                        if (oRenderer) {                                                                                                                                                                                                                       
                            oDeferred.resolve(oRenderer);                                                                                                                                                                                                      
                        } else {                                                                                                                                                                                                                               
                            oDeferred.reject("Illegal state: shell renderer not available after recieving  'rendererLoaded' event.");                                                                                                                          
                        }                                                                                                                                                                                                                                      
                    };                                                                                                                                                                                                                                         
                    that._oShellContainer.attachRendererCreatedEvent(that._onRendererCreated);                                                                                                                                                                 
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
            return oDeferred.promise();                                                                                                                                                                                                                        
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _getJouleWebInfo: function () {                                                                                                                                                                                                                        
            var jouleURLs = {                                                                                                                                                                                                                                  
                url: this._getJouleWebClientURL(),                                                                                                                                                                                                             
                componentURL: this._getJouleWebClientURL() + "/Component-preload.js",                                                                                                                                                                          
                bootstrapURL: this._getBootstrapJsUrl(this._getJouleWebClientURL())                                                                                                                                                                            
            };                                                                                                                                                                                                                                                 
            return jouleURLs                                                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _getJouleWebClientURL: function () {                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 1: Check if window exists                                                                                                                                                                                                                  
            // ---------------------------------------------------------------------                                                                                                                                                                           
            if (typeof window === "undefined") {                                                                                                                                                                                                               
                console.warn("Window object is not available.");                                                                                                                                                                                               
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 2: Read sap-ushell-config safely                                                                                                                                                                                                           
            // ---------------------------------------------------------------------                                                                                                                                                                           
            var oUshellConfig = window["sap-ushell-config"];                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            if (!oUshellConfig || typeof oUshellConfig !== "object") {                                                                                                                                                                                         
                console.warn("sap-ushell-config is missing or invalid.");                                                                                                                                                                                      
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 3: Check bootstrapPlugins object                                                                                                                                                                                                           
            // ---------------------------------------------------------------------                                                                                                                                                                           
            var oBootstrapPlugins = oUshellConfig.bootstrapPlugins;                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            if (!oBootstrapPlugins || typeof oBootstrapPlugins !== "object") {                                                                                                                                                                                 
                console.warn("bootstrapPlugins is missing or invalid.");                                                                                                                                                                                       
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 4: Loop through all plugins                                                                                                                                                                                                                
            // ---------------------------------------------------------------------                                                                                                                                                                           
            for (var sPluginKey in oBootstrapPlugins) {                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                // Ensure property belongs directly to object                                                                                                                                                                                                  
                if (!Object.prototype.hasOwnProperty.call(oBootstrapPlugins, sPluginKey)) {                                                                                                                                                                    
                    continue;                                                                                                                                                                                                                                  
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                var oPlugin = oBootstrapPlugins[sPluginKey];                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                // Validate plugin object                                                                                                                                                                                                                      
                if (!oPlugin || typeof oPlugin !== "object") {                                                                                                                                                                                                 
                    continue;                                                                                                                                                                                                                                  
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // -----------------------------------------------------------------                                                                                                                                                                           
                // Step 5: Check component field safely                                                                                                                                                                                                        
                // -----------------------------------------------------------------                                                                                                                                                                           
                if (                                                                                                                                                                                                                                           
                    typeof oPlugin.component === "string" &&                                                                                                                                                                                                   
                    oPlugin.component === "sap.das.webclientplugin.s4"                                                                                                                                                                                         
                ) {                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                    // -------------------------------------------------------------                                                                                                                                                                           
                    // Step 6: Return URL safely if available                                                                                                                                                                                                  
                    // -------------------------------------------------------------                                                                                                                                                                           
                    if (                                                                                                                                                                                                                                       
                        typeof oPlugin.url === "string" &&                                                                                                                                                                                                     
                        oPlugin.url.trim() !== ""                                                                                                                                                                                                              
                    ) {                                                                                                                                                                                                                                        
                        return oPlugin.url;                                                                                                                                                                                                                    
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    console.warn("Matching plugin found but URL is missing.");                                                                                                                                                                                 
                    return null;                                                                                                                                                                                                                               
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 7: Plugin not found                                                                                                                                                                                                                        
            // ---------------------------------------------------------------------                                                                                                                                                                           
            console.warn("Plugin sap.das.webclientplugin.s4 not found.");                                                                                                                                                                                      
            return null;                                                                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _getBootstrapJsUrl: function (sInputUrl) {                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            // Validate input                                                                                                                                                                                                                                  
            // -----------------------------------------------------------------                                                                                                                                                                               
            if (                                                                                                                                                                                                                                               
                typeof sInputUrl !== "string" ||                                                                                                                                                                                                               
                sInputUrl.trim() === ""                                                                                                                                                                                                                        
            ) {                                                                                                                                                                                                                                                
                console.warn("Invalid input URL.");                                                                                                                                                                                                            
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // Remove trailing spaces                                                                                                                                                                                                                          
            var sUrl = sInputUrl.trim();                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            // Check whether URL ends with "/s4"                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            if (!sUrl.endsWith("/s4")) {                                                                                                                                                                                                                       
                console.warn("URL does not end with '/s4'.");                                                                                                                                                                                                  
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            // Replace "/s4" with "/bootstrap.js"                                                                                                                                                                                                              
            // -----------------------------------------------------------------                                                                                                                                                                               
            var sBootstrapUrl = sUrl.replace(/\/s4$/, "/bootstrap.js");                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            return sBootstrapUrl;                                                                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _openJouleWebServiceSocket: function (webClientUrl) {                                                                                                                                                                                                  
            if (!webClientUrl || typeof webClientUrl !== "string" || webClientUrl === null) {                                                                                                                                                                  
                console.log("Web client URL is not available. Cannot open WebSocket.");                                                                                                                                                                        
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // Extract origin                                                                                                                                                                                                                                  
            const url = new URL(webClientUrl);                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Build websocket endpoint                                                                                                                                                                                                                        
            const wsUrl =                                                                                                                                                                                                                                      
                `wss://${url.host}/api/protected/connect-ws/clientapi/ws`;                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            console.log("Opening WebSocket:", wsUrl);                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            // Create socket                                                                                                                                                                                                                                   
            const socket = new WebSocket(wsUrl);                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            // Optional event handlers                                                                                                                                                                                                                         
            socket.onopen = function () {                                                                                                                                                                                                                      
                console.log("WebSocket connected");                                                                                                                                                                                                            
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            socket.onmessage = function (event) {                                                                                                                                                                                                              
                console.log("Message received:", event.data);                                                                                                                                                                                                  
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            socket.onerror = function (error) {                                                                                                                                                                                                                
                console.error("WebSocket error:", error);                                                                                                                                                                                                      
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            socket.onclose = function (event) {                                                                                                                                                                                                                
                console.log("WebSocket closed:", event.code, event.reason);                                                                                                                                                                                    
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            return socket;                                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _injectJouleDebuggingScript: function () {                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            if (window.__jouleDebugInjected) {                                                                                                                                                                                                                 
                console.warn("Joule debug already injected");                                                                                                                                                                                                  
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            window.__jouleDebugInjected = true;                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            window.__jouleDebugData = {                                                                                                                                                                                                                        
                fetchCalls: [],                                                                                                                                                                                                                                
                xhrCalls: [],                                                                                                                                                                                                                                  
                wsMessages: [],                                                                                                                                                                                                                                
                matches: []                                                                                                                                                                                                                                    
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            console.clear();                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            console.log("========================================");                                                                                                                                                                                           
            console.log("JOULE DEBUG INJECTION STARTED");                                                                                                                                                                                                      
            console.log("========================================");                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            function logMatch(type, source, payload) {                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                const entry = {                                                                                                                                                                                                                                
                    type: type,                                                                                                                                                                                                                                
                    source: source,                                                                                                                                                                                                                            
                    payload: payload,                                                                                                                                                                                                                          
                    timestamp: new Date().toISOString()                                                                                                                                                                                                        
                };                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                window.__jouleDebugData.matches.push(entry);                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                console.log("========================================");                                                                                                                                                                                       
                console.log("JOULE MATCH FOUND");                                                                                                                                                                                                              
                console.log("TYPE:", type);                                                                                                                                                                                                                    
                console.log("SOURCE:", source);                                                                                                                                                                                                                
                console.log(payload);                                                                                                                                                                                                                          
                console.log("========================================");                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            function containsInterestingContent(text) {                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                if (!text || typeof text !== "string") {                                                                                                                                                                                                       
                    return false;                                                                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                const keywords = [                                                                                                                                                                                                                             
                    "scenario",                                                                                                                                                                                                                                
                    "capability",                                                                                                                                                                                                                              
                    "namespace",                                                                                                                                                                                                                               
                    "frontend_action",                                                                                                                                                                                                                         
                    "thread_id",                                                                                                                                                                                                                               
                    "exclusive_mode_scenarios",                                                                                                                                                                                                                
                    "assistant",                                                                                                                                                                                                                               
                    "navigation"                                                                                                                                                                                                                               
                ];                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                return keywords.some(function (keyword) {                                                                                                                                                                                                      
                    return text.toLowerCase().includes(keyword.toLowerCase());                                                                                                                                                                                 
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            /*                                                                                                                                                                                                                                                 
