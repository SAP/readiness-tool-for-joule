sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/base/Object",                                                                                                                                                                                                                                         
	"sap/base/Log",                                                                                                                                                                                                                                               
	"nw/core/flp/appdiagnostics/helper/LinkHelper"                                                                                                                                                                                                                
], function(BaseObject, Log, LinkHelper) {                                                                                                                                                                                                                     
	                                                                                                                                                                                                                                                              
	/**                                                                                                                                                                                                                                                           
	 * Link to SAP note for SAP UI5 pre-analysis.                                                                                                                                                                                                                 
	 */                                                                                                                                                                                                                                                           
	var UI5_SDK_MESSAGES_LINK = LinkHelper.createSAPNoteLink("2235320");                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
	return BaseObject.extend("dr.joule.assistant.drjoule.ui5Information.MessageProvider", {                                                                                                                                                                       
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Create a new instance of the UI5 information provider. This constructor loads and initializes                                                                                                                                                             
		 * all local information providers.                                                                                                                                                                                                                          
		 * @param {sap.base.i18n.ResourceBundle} i18nBundle - I18N resource bundle, e.g. provided from i18n model.                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		constructor: function(i18nBundle) {                                                                                                                                                                                                                          
			this._i18n = i18nBundle;                                                                                                                                                                                                                                    
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Get the ID of the information provider.                                                                                                                                                                                                                   
		 * @returns {string} Provider ID.                                                                                                                                                                                                                            
		 */                                                                                                                                                                                                                                                          
		getId: function() {                                                                                                                                                                                                                                          
			return "ui5messagemanager";                                                                                                                                                                                                                                 
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Get the name of the information provider to be shown on the UI.                                                                                                                                                                                           
		 * @returns {string} Provider name.                                                                                                                                                                                                                          
		 */                                                                                                                                                                                                                                                          
		getName: function() {                                                                                                                                                                                                                                        
			return this._i18n.getText("ui5messages");                                                                                                                                                                                                                   
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Return if the information from this provider should be shown as a table or as a form.                                                                                                                                                                     
		 * @returns {boolean} Shown as a table (`true`) or as a form (`false`).                                                                                                                                                                                      
		 */                                                                                                                                                                                                                                                          
		isTable: function() {                                                                                                                                                                                                                                        
			return true;                                                                                                                                                                                                                                                
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Collect the information.                                                                                                                                                                                                                                  
		 * @returns {Promise<object>} Promise resolves with the data collected by this provider.                                                                                                                                                                     
		 */                                                                                                                                                                                                                                                          
		collect: function() {                                                                                                                                                                                                                                        
			/**                                                                                                                                                                                                                                                         
			 * Map the SAPUI5 message type to the internal message type representation.                                                                                                                                                                                 
			 *&nbsp;                                                                                                                                                                                                                                                    
			 * @param {sap.ui.core.MessageType} type - SAPUI5 message type                                                                                                                                                                                              
			 * @returns {"I" | "W" | "E"} internal message type                                                                                                                                                                                                         
			 */                                                                                                                                                                                                                                                         
			function mapMessageType(type) {                                                                                                                                                                                                                             
				switch (type) {                                                                                                                                                                                                                                            
					case sap.ui.core.MessageType.None:                                                                                                                                                                                                                        
					case sap.ui.core.MessageType.Information:                                                                                                                                                                                                                 
					case sap.ui.core.MessageType.Success:                                                                                                                                                                                                                     
						return "I";                                                                                                                                                                                                                                              
					case sap.ui.core.MessageType.Warning:                                                                                                                                                                                                                     
						return "W";                                                                                                                                                                                                                                              
					default:                                                                                                                                                                                                                                                  
						return "E";                                                                                                                                                                                                                                              
				}                                                                                                                                                                                                                                                          
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			/**                                                                                                                                                                                                                                                         
			 * Map message into condensed structure.                                                                                                                                                                                                                    
			 *&nbsp;                                                                                                                                                                                                                                                    
			 * @param {sap.ui.core.message.Message} message - Message data                                                                                                                                                                                              
			 * @returns {object} UI5 message mapped to backend log message format                                                                                                                                                                                       
			 */                                                                                                                                                                                                                                                         
			function mapMessage(message) {                                                                                                                                                                                                                              
				return {                                                                                                                                                                                                                                                   
					System: message.getMessageProcessor() ? message.getMessageProcessor().getId() : "",                                                                                                                                                                       
					Client: "",                                                                                                                                                                                                                                               
					Username: "",                                                                                                                                                                                                                                             
					Source: "UI5 Message Manager",                                                                                                                                                                                                                            
					Type: mapMessageType(message.getType()),                                                                                                                                                                                                                  
					Date: new Date(message.getDate()),                                                                                                                                                                                                                        
					Time: new Date(message.getDate()),                                                                                                                                                                                                                        
					Context: message.getTarget() || "",                                                                                                                                                                                                                       
					ErrorText: message.getMessage(),                                                                                                                                                                                                                          
					MoreInfoLink: UI5_SDK_MESSAGES_LINK                                                                                                                                                                                                                       
				};                                                                                                                                                                                                                                                         
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			return new Promise(function(resolve, reject) {                                                                                                                                                                                                              
				setTimeout(function() {                                                                                                                                                                                                                                    
					try {                                                                                                                                                                                                                                                     
						resolve(sap.ui.getCore().getMessageManager().getMessageModel().getProperty("/").map(mapMessage));                                                                                                                                                        
					} catch (e) {                                                                                                                                                                                                                                             
						reject(e);                                                                                                                                                                                                                                               
					}                                                                                                                                                                                                                                                         
				}, 0);	                                                                                                                                                                                                                                                    
			});                                                                                                                                                                                                                                                         
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            