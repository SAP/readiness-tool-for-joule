sap.ui.define([], () => {                                                                                                                                                                                                                                      
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var oBundle = null;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
        init: function (oResourceBundle) {                                                                                                                                                                                                                     
            oBundle = oResourceBundle;                                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Returns true when the value is a non-empty string — used to enable/disable Link controls                                                                                                                                                            
        formatHasValue: function (sValue) {                                                                                                                                                                                                                    
            return !!(sValue && sValue.trim() !== "");                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatVersionInfo: function (sVersion, sDeployedVersion) {                                                                                                                                                                                             
            return sDeployedVersion;                                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatHealthText: function (sStatus) {                                                                                                                                                                                                                 
            switch (sStatus) {                                                                                                                                                                                                                                 
                case "S": return oBundle ? oBundle.getText("healthyStatusText") : "Healthy";                                                                                                                                                                   
                case "W": return oBundle ? oBundle.getText("warningStatusText") : "Warning";                                                                                                                                                                   
                case "E": return oBundle ? oBundle.getText("errorStatusText")   : "Error";                                                                                                                                                                     
                default:  return sStatus;                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _fetchi18nText: function (sKey, aArgs) {                                                                                                                                                                                                               
            if (oBundle) {                                                                                                                                                                                                                                     
                return oBundle.getText(sKey, aArgs);                                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
            // fallback: try via component model if called from XML binding context                                                                                                                                                                            
            if (this && this.getModel) {                                                                                                                                                                                                                       
                return this.getModel("i18n").getResourceBundle().getText(sKey, aArgs);                                                                                                                                                                         
            }                                                                                                                                                                                                                                                  
            return sKey;                                                                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatHealthState: function (sStatus) {                                                                                                                                                                                                                
            switch (sStatus) {                                                                                                                                                                                                                                 
                case "S": return "Success";                                                                                                                                                                                                                    
                case "W": return "Warning";                                                                                                                                                                                                                    
                case "E": return "Error";                                                                                                                                                                                                                      
                default:  return "None";                                                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatHealthIcon: function (sStatus) {                                                                                                                                                                                                                 
            switch (sStatus) {                                                                                                                                                                                                                                 
                case "S": return "sap-icon://status-positive";                                                                                                                                                                                                 
                case "W": return "sap-icon://status-critical";                                                                                                                                                                                                 
                case "E": return "sap-icon://status-negative";                                                                                                                                                                                                 
                default:  return "sap-icon://question-mark";                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Icon for the Overall Status card — driven by the raw S/W/E state field                                                                                                                                                                              
        formatOverallStatusIcon: function (sStateRaw) {                                                                                                                                                                                                        
            switch (sStateRaw) {                                                                                                                                                                                                                               
                case "S": return "sap-icon://status-positive";                                                                                                                                                                                                 
                case "W": return "sap-icon://status-critical";                                                                                                                                                                                                 
                case "E": return "sap-icon://status-negative";                                                                                                                                                                                                 
                default:  return "sap-icon://question-mark";                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // One-line description below the icon in the Overall Status card                                                                                                                                                                                      
        formatOverallStatusDescription: function (sStateRaw) {                                                                                                                                                                                                 
            switch (sStateRaw) {                                                                                                                                                                                                                               
                case "S": return oBundle ? oBundle.getText("overallStatusDescSuccess") : "Activated and Authorized";                                                                                                                                           
                case "E": return oBundle ? oBundle.getText("overallStatusDescError")   : "Activation of TMs or OData pending";                                                                                                                                 
                case "W": return oBundle ? oBundle.getText("overallStatusDescWarning") : "TMs and OData are active, but missing Authorizations";                                                                                                               
                default:  return "";                                                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // "18/18" label shown next to rating indicator                                                                                                                                                                                                        
        formatRatioText: function (iActive, iTotal) {                                                                                                                                                                                                          
            return (iActive || 0) + "/" + (iTotal || 0);                                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // valueState for RatingIndicatorDrJoule on pageScenario header:                                                                                                                                                                                       
        // 0/0 → None (grey, value=0), 100% non-zero → Success, <50% → Error, else → Warning                                                                                                                                                                   
        formatScenarioActivationState: function (iActive, iTotal) {                                                                                                                                                                                            
            var n = parseInt(iActive, 10) || 0;                                                                                                                                                                                                                
            var d = parseInt(iTotal, 10) || 0;                                                                                                                                                                                                                 
            if (d === 0) { return "None"; }                                                                                                                                                                                                                    
            if (n === d)  { return "Success"; }                                                                                                                                                                                                                
            return ((n / d) * 100) < 50 ? "Error" : "Warning";                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Converts active/total to a 0-5 filled value for the RatingIndicator                                                                                                                                                                                 
        formatRatingValue: function (iActive, iTotal) {                                                                                                                                                                                                        
            if (!iTotal || iTotal === 0) { return 0; }                                                                                                                                                                                                         
            return Math.round((iActive / iTotal) * 5);                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Returns CSS class for the RatingIndicator based on % active                                                                                                                                                                                         
        // green ≥ 100%, amber > 40%, red ≤ 40%                                                                                                                                                                                                                
        formatRatingClass: function (iActive, iTotal) {                                                                                                                                                                                                        
            if (!iTotal || iTotal === 0) { return "drJouleRatingRed"; }                                                                                                                                                                                        
            var iPct = (iActive / iTotal) * 100;                                                                                                                                                                                                               
            if (iPct >= 100) { return "drJouleRatingGreen"; }                                                                                                                                                                                                  
            if (iPct > 40)   { return "drJouleRatingAmber"; }                                                                                                                                                                                                  
            return "drJouleRatingRed";                                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // For ActivationStatus columns — shows "Active" / "Inactive" / "Warning"                                                                                                                                                                              
        formatActivationText: function (sStatus) {                                                                                                                                                                                                             
            switch (sStatus) {                                                                                                                                                                                                                                 
                case "S": return oBundle ? oBundle.getText("activationActiveText")   : "Active";                                                                                                                                                               
                case "W": return oBundle ? oBundle.getText("activationWarningText")  : "Warning";                                                                                                                                                              
                case "E": return oBundle ? oBundle.getText("activationInactiveText") : "Inactive";                                                                                                                                                             
                default:  return sStatus;                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // For AuthorizationStatus columns — shows "Authorized" / "No Authorization"                                                                                                                                                                           
        formatAuthorizationText: function (sStatus) {                                                                                                                                                                                                          
            switch (sStatus) {                                                                                                                                                                                                                                 
                case "S": return oBundle ? oBundle.getText("authAuthorizedText")     : "Authorized";                                                                                                                                                           
                case "W": return oBundle ? oBundle.getText("authWarningText")        : "Auth Warning";                                                                                                                                                         
                case "E": return oBundle ? oBundle.getText("authNoAuthorizationText"): "No Authorization";                                                                                                                                                     
                default:  return sStatus;                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatCapabilitiesSummaryTexts: function (i18nkey, iCount) {                                                                                                                                                                                           
            if (oBundle) {                                                                                                                                                                                                                                     
                return oBundle.getText(i18nkey, [iCount]);                                                                                                                                                                                                     
            }                                                                                                                                                                                                                                                  
            if (this && this.getModel) {                                                                                                                                                                                                                       
                return this.getModel("i18n").getResourceBundle().getText(i18nkey, [iCount]);                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
            return i18nkey;                                                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // "Save Selection" when 0, "Save Selection (N)" when N > 0                                                                                                                                                                                            
        formatSaveSelectionBtnText: function (iCount) {                                                                                                                                                                                                        
            if (!iCount || iCount === 0) {                                                                                                                                                                                                                     
                return oBundle ? oBundle.getText("tmSaveSelectionBtn") : "Save Selection";                                                                                                                                                                     
            }                                                                                                                                                                                                                                                  
            return oBundle ? oBundle.getText("tmSaveSelectionBtnWithCount", [iCount]) : "Save Selection (" + iCount + ")";                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Converts a 0-100 percentage to a 0-5 rating value                                                                                                                                                                                                   
        // Converts a 0-100 float percentage to a display string like "75%"                                                                                                                                                                                    
        formatPercentageDisplay: function (fPct) {                                                                                                                                                                                                             
            if (!fPct || isNaN(fPct)) { return "0%"; }                                                                                                                                                                                                         
            return Math.round(parseFloat(fPct)) + "%";                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Parses OData Edm.Decimal percentage string to a JS float for ProgressIndicator.percentValue                                                                                                                                                         
        // Derives ProgressIndicator state from active/total counts:                                                                                                                                                                                           
        // 100% or 0 of 0 → Success, anything else → Error                                                                                                                                                                                                     
        formatCountToState: function (iActive, iTotal) {                                                                                                                                                                                                       
            var n = parseInt(iActive, 10) || 0;                                                                                                                                                                                                                
            var d = parseInt(iTotal, 10) || 0;                                                                                                                                                                                                                 
            if (d === 0 || n === d) { return "Success"; }                                                                                                                                                                                                      
            return "Error";                                                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Calculates % from active/total for ProgressIndicator percentValue.                                                                                                                                                                                  
        // Returns 100 if total is 0 (safe default).                                                                                                                                                                                                           
        formatCountToPercent: function (iActive, iTotal) {                                                                                                                                                                                                     
            var n = parseInt(iActive, 10) || 0;                                                                                                                                                                                                                
            var d = parseInt(iTotal, 10) || 0;                                                                                                                                                                                                                 
            if (d === 0) { return 100; }                                                                                                                                                                                                                       
            return Math.round((n / d) * 100);                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Builds the displayValue label: "X / Y ... (NN%)"                                                                                                                                                                                                    
        // Parts order: sKey, iX, iY, iActiveForPct, iTotalForPct                                                                                                                                                                                              
        formatCountLabelWithPercent: function (sKey, iX, iY, iActiveForPct, iTotalForPct) {                                                                                                                                                                    
            var n = parseInt(iActiveForPct, 10) || 0;                                                                                                                                                                                                          
            var d = parseInt(iTotalForPct, 10) || 0;                                                                                                                                                                                                           
            var iPct = (d === 0) ? 100 : Math.round((n / d) * 100);                                                                                                                                                                                            
            var sPct = iPct + "%";                                                                                                                                                                                                                             
            var aArgs = [iX, iY, sPct];                                                                                                                                                                                                                        
            if (oBundle) { return oBundle.getText(sKey, aArgs); }                                                                                                                                                                                              
            return iX + " / " + iY + " (" + sPct + ")";                                                                                                                                                                                                        
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatPercentageToFloat: function (fPct) {                                                                                                                                                                                                             
            if (!fPct || isNaN(fPct)) { return 0; }                                                                                                                                                                                                            
            return parseFloat(fPct);                                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatPercentageToRating: function (fPct) {                                                                                                                                                                                                            
            if (!fPct || isNaN(fPct)) { return 0; }                                                                                                                                                                                                            
            return Math.round((parseFloat(fPct) / 100) * 5 * 2) / 2; // rounds to 0.5                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Maps S/W/E state code to sap.ui.core.ValueState for RatingIndicatorDrJoule                                                                                                                                                                          
        formatRatingState: function (sState) {                                                                                                                                                                                                                 
            switch (sState) {                                                                                                                                                                                                                                  
                case "S": return "Success";                                                                                                                                                                                                                    
                case "W": return "Warning";                                                                                                                                                                                                                    
                case "E": return "Error";                                                                                                                                                                                                                      
                default:  return "None";                                                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // "{0} / {1} ... ({2})" — sKey from i18n, iX, iY counts, optional fPct raw float                                                                                                                                                                      
        formatTwoParamText: function (sKey, iX, iY, fPct) {                                                                                                                                                                                                    
            var sPct = (fPct !== undefined && fPct !== null && !isNaN(fPct))                                                                                                                                                                                   
                ? Math.round(parseFloat(fPct)) + "%"                                                                                                                                                                                                           
                : undefined;                                                                                                                                                                                                                                   
            var aArgs = sPct !== undefined ? [iX, iY, sPct] : [iX, iY];                                                                                                                                                                                        
            if (oBundle) { return oBundle.getText(sKey, aArgs); }                                                                                                                                                                                              
            return iX + " / " + iY + (sPct ? " (" + sPct + ")" : "");                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // AuthorizationMatchType → label, state, tooltip for the Match Type column                                                                                                                                                                            
        formatMatchTypeLabel: function (sType) {                                                                                                                                                                                                               
            switch (sType) {                                                                                                                                                                                                                                   
                case "EXACT_MATCH": return oBundle ? oBundle.getText("apiaMatchExact")    : "Exact Match";                                                                                                                                                     
                case "IWSG":        return oBundle ? oBundle.getText("apiaMatchIWSG")     : "IWSG Auth only";                                                                                                                                                  
                case "IWSV":        return oBundle ? oBundle.getText("apiaMatchIWSV")     : "IWSV Auth only";                                                                                                                                                  
                case "WILD_CARD":   return oBundle ? oBundle.getText("apiaMatchWildcard") : "Wild Card Role";                                                                                                                                                  
                default:            return sType || "";                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
        formatMatchTypeState: function (sType) {                                                                                                                                                                                                               
            switch (sType) {                                                                                                                                                                                                                                   
                case "EXACT_MATCH": return "Success";                                                                                                                                                                                                          
                case "IWSG":        return "Warning";                                                                                                                                                                                                          
                case "IWSV":        return "Warning";                                                                                                                                                                                                          
                case "WILD_CARD":   return "Error";                                                                                                                                                                                                            
                default:            return "None";                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
        formatMatchTypeIcon: function (sType) {                                                                                                                                                                                                                
            switch (sType) {                                                                                                                                                                                                                                   
                case "EXACT_MATCH": return "sap-icon://status-positive";                                                                                                                                                                                       
                case "IWSG":        return "sap-icon://status-critical";                                                                                                                                                                                       
                case "IWSV":        return "sap-icon://status-critical";                                                                                                                                                                                       
                case "WILD_CARD":   return "sap-icon://status-negative";                                                                                                                                                                                       
                default:            return "";                                                                                                                                                                                                                 
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
        formatMatchTypeTooltip: function (sType) {                                                                                                                                                                                                             
            switch (sType) {                                                                                                                                                                                                                                   
                case "EXACT_MATCH": return oBundle ? oBundle.getText("apiaMatchExactTooltip")    : "Recommended Role";                                                                                                                                         
                case "IWSG":        return oBundle ? oBundle.getText("apiaMatchPartialTooltip")  : "Role contains partial authorizations";                                                                                                                     
                case "IWSV":        return oBundle ? oBundle.getText("apiaMatchPartialTooltip")  : "Role contains partial authorizations";                                                                                                                     
                case "WILD_CARD":   return oBundle ? oBundle.getText("apiaMatchWildcardTooltip") : "Role not recommended, has a wild card authorization";                                                                                                      
                default:            return "";                                                                                                                                                                                                                 
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // HasWildcardAuth field: "X" = has wildcard, "" = none                                                                                                                                                                                                
        formatWildcardState: function (sVal) {                                                                                                                                                                                                                 
            return sVal === "X" ? "Success" : "None";                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
        formatWildcardIcon: function (sVal) {                                                                                                                                                                                                                  
            return sVal === "X" ? "sap-icon://accept" : "";                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ── TMA formatters (identical logic to tma/webapp/model/formatter.js) ──                                                                                                                                                                             
                                                                                                                                                                                                                                                               
        navigationIntent: function (sObject, sAction) {                                                                                                                                                                                                        
            return (sObject || "") + "-" + (sAction || "");                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        catalogOriginLabel: function (sOrigin) {                                                                                                                                                                                                               
            if (sOrigin === "LADI") { return "LADI"; }                                                                                                                                                                                                         
            return oBundle ? oBundle.getText("tmCatalogOriginLabelTM") : "TM";                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
        catalogOriginState: function (sOrigin) {                                                                                                                                                                                                               
            return sOrigin === "LADI" ? "Success" : "Warning";                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
        catalogOriginIcon: function (sOrigin) {                                                                                                                                                                                                                
            return sOrigin === "LADI" ? "sap-icon://sys-enter-2" : "sap-icon://alert";                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
        catalogOriginTooltip: function (sOrigin) {                                                                                                                                                                                                             
            if (sOrigin === "LADI") {                                                                                                                                                                                                                          
                return oBundle ? oBundle.getText("tmCatalogOriginTooltipLADI") : "Usage of LADIs, Recommended";                                                                                                                                                
            }                                                                                                                                                                                                                                                  
            return oBundle ? oBundle.getText("tmCatalogOriginTooltipTM") : "Obsolete FLP Content Model, Not recommended";                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        tmTypeState: function (sTmType) {                                                                                                                                                                                                                      
            return sTmType === "Base Catalog" ? "Success" : "Information";                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
        tmTypeIcon: function (sTmType) {                                                                                                                                                                                                                       
            return sTmType === "Base Catalog" ? "sap-icon://sys-enter-2" : "sap-icon://information";                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
        tmTypeLabel: function (sTmType) {                                                                                                                                                                                                                      
            if (sTmType === "Base Catalog") {                                                                                                                                                                                                                  
                return oBundle ? oBundle.getText("tmTypeLabelOriginal") : "Original";                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
            return oBundle ? oBundle.getText("tmTypeLabelReferenced") : "Referenced";                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
        tmTypeTooltip: function (sTmType, sCatalogName, sOriginalCatalogId) {                                                                                                                                                                                  
            if (sTmType === "Base Catalog") {                                                                                                                                                                                                                  
                return oBundle                                                                                                                                                                                                                                 
                    ? oBundle.getText("tmTypeTooltipBase", [sCatalogName || ""])                                                                                                                                                                               
                    : "Original TM in " + (sCatalogName || "");                                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
            var sRef = sOriginalCatalogId ? sOriginalCatalogId.split(":").pop() : "";                                                                                                                                                                          
            return oBundle                                                                                                                                                                                                                                     
                ? oBundle.getText("tmTypeTooltipRef", [sRef])                                                                                                                                                                                                  
                : "TM referenced from " + sRef;                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // DB Sync formatters                                                                                                                                                                                                                                  
        formatImportTimestamp: function (vTs) {                                                                                                                                                                                                                
            if (!vTs) { return ""; }                                                                                                                                                                                                                           
            var s = String(vTs).replace(/\.\d+$/, ""); // strip decimal                                                                                                                                                                                        
            if (s.length >= 14) {                                                                                                                                                                                                                              
                return s.substr(0,4) + "-" + s.substr(4,2) + "-" + s.substr(6,2) + " " +                                                                                                                                                                       
                       s.substr(8,2) + ":" + s.substr(10,2) + ":" + s.substr(12,2);                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
            return s;                                                                                                                                                                                                                                          
        },                                                                                                                                                                                                                                                     
        formatImportStatus: function (sStatus) {                                                                                                                                                                                                               
            return sStatus === "SUCCESS" ? "Success" : "Error";                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // true when AuthorizationStatus === "E" — used to show the Analyze button                                                                                                                                                                             
        formatIsUnauthorized: function (sAuthStatus) {                                                                                                                                                                                                         
            return sAuthStatus === "E";                                                                                                                                                                                                                        
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // true when ActivationStatus === "W" — used to show the Activation Summary button                                                                                                                                                                     
        formatIsWarning: function (sStatus) {                                                                                                                                                                                                                  
            return sStatus === "W";                                                                                                                                                                                                                            
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // "Error" (red) when catalog ID is present but CatalogExists flag is not "X" (catalog missing in system)                                                                                                                                              
        formatCatalogIdState: function (sCatalogExists, sCatalogId) {                                                                                                                                                                                          
            if (sCatalogId && sCatalogExists !== "X") {                                                                                                                                                                                                        
                return "Error";                                                                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
            return "None";                                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // true when catalog ID is present but CatalogExists flag is not "X" — shows the info button                                                                                                                                                           
        formatCatalogIdMissing: function (sCatalogExists, sCatalogId) {                                                                                                                                                                                        
            return !!(sCatalogId && sCatalogExists !== "X");                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // "Error" when SemanticObject or SemanticAction does not exist in the system                                                                                                                                                                          
        formatNavIntentState: function (sSOExists, sSAExists) {                                                                                                                                                                                                
            return (sSOExists !== "X" || sSAExists !== "X") ? "Error" : "None";                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // true when SemanticObject or SemanticAction does not exist — makes the ObjectStatus active/clickable                                                                                                                                                 
        formatNavIntentMissing: function (sSOExists, sSAExists) {                                                                                                                                                                                              
            return sSOExists !== "X" || sSAExists !== "X";                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // "Save Selection" when 0, "Save Selection (N)" when N > 0 — APIA page                                                                                                                                                                                
        formatAPIASaveSelectionBtnText: function (iCount) {                                                                                                                                                                                                    
            if (!iCount || iCount === 0) {                                                                                                                                                                                                                     
                return oBundle ? oBundle.getText("apiaSaveSelectionBtn") : "Save Selection";                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
            return oBundle ? oBundle.getText("apiaSaveSelectionBtnWithCount", [iCount]) : "Save Selection (" + iCount + ")";                                                                                                                                   
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ── end TMA formatters ────────────────────────────────────────────────                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        formatJoulePluginIconStatus: function (bJoulePluginFound) {                                                                                                                                                                                            
            var oButton = sap.ui.getCore().byId("jouleStatusBtn");                                                                                                                                                                                             
            if (oButton && oButton.addStyleClass && oButton.removeStyleClass) {                                                                                                                                                                                
                oButton.removeStyleClass("drjouleActiveStatus").removeStyleClass("drjouleInactiveStatus");                                                                                                                                                     
                if (bJoulePluginFound) {                                                                                                                                                                                                                       
                    oButton.addStyleClass("drjouleActiveStatus");                                                                                                                                                                                              
                    if (oBundle) { oButton.setTooltip(oBundle.getText("drJouleActiveTooltip")); }                                                                                                                                                              
                } else {                                                                                                                                                                                                                                       
                    oButton.addStyleClass("drjouleInactiveStatus");                                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        formatJoulePluginTooltip: function (bJoulePluginFound) {                                                                                                                                                                                               
            if (!oBundle) { return ""; }                                                                                                                                                                                                                       
            return bJoulePluginFound                                                                                                                                                                                                                           
                ? oBundle.getText("drJouleActiveTooltip")                                                                                                                                                                                                      
                : oBundle.getText("drJouleInActiveTooltip");                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               