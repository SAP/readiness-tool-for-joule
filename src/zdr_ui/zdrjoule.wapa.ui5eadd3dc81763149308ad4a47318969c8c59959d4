sap.ui.define([                                                                                                                                                                                                                                                
	"sap/base/Log"                                                                                                                                                                                                                                                
], function(Log) {                                                                                                                                                                                                                                             
	return {                                                                                                                                                                                                                                                      
		createSAPNoteLink: function(sNoteNumber) {                                                                                                                                                                                                                   
			if (! /^\d+$/.test(sNoteNumber)) {                                                                                                                                                                                                                          
				Log.error(sNoteNumber + " is not a valid SAP note number");                                                                                                                                                                                                
				throw new Error("Invalid note number");                                                                                                                                                                                                                    
			}                                                                                                                                                                                                                                                           
			return "https://me.sap.com/notes/" + sNoteNumber; /* eslint-disable-line sap-no-hardcoded-url -- Legitimate link to external SAP-owned site. */                                                                                                             
		}	                                                                                                                                                                                                                                                           
	};                                                                                                                                                                                                                                                            
});                                                                                                                                                                                                                                                            