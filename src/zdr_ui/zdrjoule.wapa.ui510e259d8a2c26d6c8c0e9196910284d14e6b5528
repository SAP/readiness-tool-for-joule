sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/base/Object",                                                                                                                                                                                                                                      
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/base/Log"                                                                                                                                                                                                                                             
], function (BaseObject, MessageToast, Log) {                                                                                                                                                                                                                  
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    // Private module state to maintain conversation tracking pointer session-wide                                                                                                                                                                             
    let _sActiveThreadId = null;                                                                                                                                                                                                                               
    const DEFAULT_CONVERSATION_TITLE = "Testing Prompts with Readiness Inspection and Guidance Tool for Joule Scenarios";                                                                                                                                      
                                                                                                                                                                                                                                                               
    const JouleHelper = BaseObject.extend("dr.joule.assistant.drjoule.helper.JouleHelper", {});                                                                                                                                                                
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Internal safe check to verify if the global API exists.                                                                                                                                                                                                 
     * @private                                                                                                                                                                                                                                                
     * @returns {object|null} The Joule WebClient API or null if uninitialized.                                                                                                                                                                                
     */                                                                                                                                                                                                                                                        
    function _getWebClientAPI() {                                                                                                                                                                                                                              
        if (window.sap && window.sap.das && window.sap.das.webclient) {                                                                                                                                                                                        
            return window.sap.das.webclient;                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
        if (window.sapdas && window.sapdas.webclientBridge) {                                                                                                                                                                                                  
            Log.warning("[JouleHelper] Found legacy bridge namespace but main API remains uninitialized.");                                                                                                                                                    
        }                                                                                                                                                                                                                                                      
        return null;                                                                                                                                                                                                                                           
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Internal helper to retrieve an i18n string from the active component's model,                                                                                                                                                                           
     * falling back cleanly to a provided default string.                                                                                                                                                                                                      
     * @private                                                                                                                                                                                                                                                
     */                                                                                                                                                                                                                                                        
    function _getText(sKey, sDefault, aArgs) {                                                                                                                                                                                                                 
        try {                                                                                                                                                                                                                                                  
            const oCore = sap.ui.getCore();                                                                                                                                                                                                                    
            const oComponent = oCore.getComponent(oCore.getCurrentOwnerId());                                                                                                                                                                                  
            if (oComponent && oComponent.getModel("i18n")) {                                                                                                                                                                                                   
                const oBundle = oComponent.getModel("i18n").getResourceBundle();                                                                                                                                                                               
                return oBundle.getText(sKey, aArgs) || sDefault;                                                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
        } catch (e) {                                                                                                                                                                                                                                          
            Log.error("[JouleHelper] Failed to locate application i18n bundle framework.", e);                                                                                                                                                                 
        }                                                                                                                                                                                                                                                      
        return sDefault;                                                                                                                                                                                                                                       
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Dispatches a localized MessageToast string to the screen layout.                                                                                                                                                                                        
     * @private                                                                                                                                                                                                                                                
     */                                                                                                                                                                                                                                                        
    function _raiseToastError(sKey, sDefaultValue, aArgs) {                                                                                                                                                                                                    
        const sMessage = _getText(sKey, sDefaultValue, aArgs);                                                                                                                                                                                                 
        MessageToast.show(sMessage, {                                                                                                                                                                                                                          
            duration: 4000,                                                                                                                                                                                                                                    
            closeOnBrowserNavigation: false                                                                                                                                                                                                                    
        });                                                                                                                                                                                                                                                    
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Helper method to scan the server side list for existing threads matching our title.                                                                                                                                                                     
     * @private                                                                                                                                                                                                                                                
     * @returns {Promise<string|null>} The existing thread ID or null.                                                                                                                                                                                         
     */                                                                                                                                                                                                                                                        
    async function _findExistingThreadIdOnServer(oJoule, sTargetTitle) {                                                                                                                                                                                       
        try {                                                                                                                                                                                                                                                  
            Log.info("[JouleHelper] Inspecting server active threads list...");                                                                                                                                                                                
            const aThreads = await oJoule.getThreads(true) || [];                                                                                                                                                                                              
            const oExistingThread = aThreads.find(t => t.title === sTargetTitle && !t.expired);                                                                                                                                                                
            if (oExistingThread) {                                                                                                                                                                                                                             
                return oExistingThread.thread_id || oExistingThread.id;                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
        } catch (e) {                                                                                                                                                                                                                                          
            Log.error("[JouleHelper] Failed to fetch existing conversation list from server context.", e);                                                                                                                                                     
        }                                                                                                                                                                                                                                                      
        return null;                                                                                                                                                                                                                                           
    }                                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    // =========================================================================                                                                                                                                                                               
    // PUBLIC HELPER METHOD PIPELINE                                                                                                                                                                                                                           
    // =========================================================================                                                                                                                                                                               
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Sends a targeted testing prompt text to Joule. Automatically wakes up the layout,                                                                                                                                                                       
     * inspects active threads for an existing matching context title, or creates a new one.                                                                                                                                                                   
     * @param {string} sPromptText The message payload context to send to Joule.                                                                                                                                                                               
     * @param {string} [sCustomTitle] Optional override for the session thread name.                                                                                                                                                                           
     */                                                                                                                                                                                                                                                        
    JouleHelper.sendPrompt = async function (sPromptText, sCustomTitle) {                                                                                                                                                                                      
        const oJoule = _getWebClientAPI();                                                                                                                                                                                                                     
        const sTargetTitle = sCustomTitle || _getText("jouleThreadTitle", DEFAULT_CONVERSATION_TITLE);                                                                                                                                                         
                                                                                                                                                                                                                                                               
        Log.info(`[JouleHelper] Preparing to process prompt: "${sPromptText}" under Title context: "${sTargetTitle}"`);                                                                                                                                        
                                                                                                                                                                                                                                                               
        if (!oJoule) {                                                                                                                                                                                                                                         
            Log.error("[JouleHelper] Execution rejected: 'window.sap.das.webclient' is completely unavailable.");                                                                                                                                              
            _raiseToastError("jouleErrNotInitialized", "Error: Readiness Inspection and Guidance Tool for Joule Scenarios is not yet initialized! Please wait for cold boot or load context.");                                                                
            return;                                                                                                                                                                                                                                            
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
            Log.info("[JouleHelper] Triggering show() to activate the iframe pipeline focus.");                                                                                                                                                                
            oJoule.show();                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            await new Promise(resolve => setTimeout(resolve, 250));                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            if (!_sActiveThreadId) {                                                                                                                                                                                                                           
                _sActiveThreadId = await _findExistingThreadIdOnServer(oJoule, sTargetTitle);                                                                                                                                                                  
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (_sActiveThreadId) {                                                                                                                                                                                                                            
                Log.info(`[JouleHelper] Found matching thread context: ${_sActiveThreadId}. Directing display focus.`);                                                                                                                                        
                await oJoule.setActiveThread(_sActiveThreadId);                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                Log.info(`[JouleHelper] Forwarding prompt payload inside existing thread context.`);                                                                                                                                                           
                oJoule.sendMessage(sPromptText, _sActiveThreadId);                                                                                                                                                                                             
            } else {                                                                                                                                                                                                                                           
                Log.info("[JouleHelper] No existing thread matches target title. Instantiating via newConversation()...");                                                                                                                                     
                const oNewThread = await oJoule.newConversation(sPromptText, sTargetTitle);                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                if (oNewThread && (oNewThread.thread_id || oNewThread.id)) {                                                                                                                                                                                   
                    _sActiveThreadId = oNewThread.thread_id || oNewThread.id;                                                                                                                                                                                  
                    Log.info(`[JouleHelper] New thread registered into session state: ${_sActiveThreadId}`);                                                                                                                                                   
                } else {                                                                                                                                                                                                                                       
                    Log.warning("[JouleHelper] Conversation response omitted explicit UUID context. Executing fallback broadcast...");                                                                                                                         
                    oJoule.sendMessage(sPromptText);                                                                                                                                                                                                           
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        } catch (oError) {                                                                                                                                                                                                                                     
            Log.error("[JouleHelper] Runtime Exception captured inside execution pipeline", oError);                                                                                                                                                           
            _raiseToastError("jouleExecutionFailed", "Failed to communicate with Readiness Inspection and Guidance Tool for Joule Scenarios. Error Type: {0}", [oError.name || "Unknown"]);                                                                    
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Filters a provided list of scenario objects to return only those accessible by the logged-on user.                                                                                                                                                      
     * @param {object[]|object} vScenariosInput - An array of scenario objects or a single scenario metadata container layout.                                                                                                                                 
     * @returns {Promise<object[]>} A filtered subset array containing only authorized scenarios.                                                                                                                                                              
     */                                                                                                                                                                                                                                                        
    JouleHelper.filterScenariosByAccess = async function (vScenariosInput) {                                                                                                                                                                                   
        const oJoule = _getWebClientAPI();                                                                                                                                                                                                                     
        let aScenariosToFilter = [];                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
        // Styling constants for high-visibility console log reporting                                                                                                                                                                                         
        const logHeader = "%c[Joule Security-Audit]";                                                                                                                                                                                                          
        const styles = {                                                                                                                                                                                                                                       
            info: "color: #00bfff; font-weight: bold;",                                                                                                                                                                                                        
            success: "color: #00ff7f; font-weight: bold;",                                                                                                                                                                                                     
            warn: "color: #ffaa00; font-weight: bold;",                                                                                                                                                                                                        
            error: "color: #ff3333; font-weight: bold;",                                                                                                                                                                                                       
            metrics: "color: #ffff00; background: #222; padding: 4px 8px; border-radius: 4px; font-weight: bold; font-size: 11px;"                                                                                                                             
        };                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        console.log(`${logHeader} filterScenariosByAccess execution triggered...`, styles.info);                                                                                                                                                               
                                                                                                                                                                                                                                                               
        // 1. Structural runtime pre-validation check                                                                                                                                                                                                          
        if (!oJoule) {                                                                                                                                                                                                                                         
            Log.error("[JouleHelper] Filter rejected: Joule API is uninitialized.");                                                                                                                                                                           
            _raiseToastError("jouleErrNotInitialized", "Error: Readiness Inspection and Guidance Tool for Joule Scenarios is not yet initialized!");                                                                                                           
            return [];                                                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        // 2. Normalize input layout variants (handles raw array or wrapper object structures safely)                                                                                                                                                          
        if (Array.isArray(vScenariosInput)) {                                                                                                                                                                                                                  
            aScenariosToFilter = vScenariosInput;                                                                                                                                                                                                              
        } else if (vScenariosInput && Array.isArray(vScenariosInput.scenarios)) {                                                                                                                                                                              
            aScenariosToFilter = vScenariosInput.scenarios;                                                                                                                                                                                                    
        } else if (vScenariosInput && typeof vScenariosInput === "object") {                                                                                                                                                                                   
            aScenariosToFilter = [vScenariosInput];                                                                                                                                                                                                            
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        const iTotalRequested = aScenariosToFilter.length;                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        if (iTotalRequested === 0) {                                                                                                                                                                                                                           
            console.warn(`${logHeader} Empty or invalid scenario container layout schema provided. Execution halted.`, styles.warn);                                                                                                                           
            return [];                                                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
            console.log(`${logHeader} Transmitting list to Joule to cross-reference permission scopes...`, styles.info);                                                                                                                                       
            console.dir(aScenariosToFilter);                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // 3. Dispatch to the native client permissions checker                                                                                                                                                                                            
            const aFilteredSubset = await oJoule.filterScenariosByAccess(aScenariosToFilter) || [];                                                                                                                                                            
            const iTotalAccessible = aFilteredSubset.length;                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // 4. Calculate the specific access coverage metrics percentage&nbsp;                                                                                                                                                                              
            const fPercentageAccessible = iTotalRequested > 0 ? ((iTotalAccessible / iTotalRequested) * 100).toFixed(1) : 0;                                                                                                                                   
                                                                                                                                                                                                                                                               
            // 5. Build a rich high-visibility console output trace report                                                                                                                                                                                     
            console.log(`${logHeader} SECURITY CONTEXT METRICS FOR LOGGED-ON USER:`, styles.success);                                                                                                                                                          
            console.log(                                                                                                                                                                                                                                       
                `%c→ Requested: ${iTotalRequested} | Accessible: ${iTotalAccessible} | Coverage Rate: ${fPercentageAccessible}%`,                                                                                                                              
                styles.metrics                                                                                                                                                                                                                                 
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Optional: Output a clean trace table layout matching authorized capabilities if data is returned                                                                                                                                                
            if (iTotalAccessible > 0) {                                                                                                                                                                                                                        
                console.log(`${logHeader} Listing fully authorized target items below:`, styles.success);                                                                                                                                                      
                console.table(aFilteredSubset);                                                                                                                                                                                                                
            } else {                                                                                                                                                                                                                                           
                console.warn(`${logHeader} Zero matching clearance roles found. Current user context lacks capability access.`, styles.warn);                                                                                                                  
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            return aFilteredSubset;                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
        } catch (oError) {                                                                                                                                                                                                                                     
            Log.error("[JouleHelper] Error occurred while calling filterScenariosByAccess", oError);                                                                                                                                                           
            _raiseToastError("jouleExecutionFailed", "Failed to filter scenarios. Error Type: {0}", [oError.name || "Unknown"]);                                                                                                                               
            return [];                                                                                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Focus and display the ongoing testing conversation without sending an initial message payload.                                                                                                                                                          
     */                                                                                                                                                                                                                                                        
    JouleHelper.showOngoingConversation = async function (sCustomTitle) {                                                                                                                                                                                      
        const oJoule = _getWebClientAPI();                                                                                                                                                                                                                     
        const sTargetTitle = sCustomTitle || _getText("jouleThreadTitle", DEFAULT_CONVERSATION_TITLE);                                                                                                                                                         
                                                                                                                                                                                                                                                               
        if (!oJoule) {                                                                                                                                                                                                                                         
            _raiseToastError("jouleErrNotInitialized", "Error: Readiness Inspection and Guidance Tool for Joule Scenarios is not yet initialized!");                                                                                                           
            return;                                                                                                                                                                                                                                            
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        try {                                                                                                                                                                                                                                                  
            Log.info("[JouleHelper] Asserting UI presentation layer focus...");                                                                                                                                                                                
            oJoule.show();                                                                                                                                                                                                                                     
            await new Promise(resolve => setTimeout(resolve, 250));                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            if (!_sActiveThreadId) {                                                                                                                                                                                                                           
                _sActiveThreadId = await _findExistingThreadIdOnServer(oJoule, sTargetTitle);                                                                                                                                                                  
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (_sActiveThreadId) {                                                                                                                                                                                                                            
                Log.info(`[JouleHelper] Restoring display view context onto Thread: ${_sActiveThreadId}`);                                                                                                                                                     
                await oJoule.setActiveThread(_sActiveThreadId);                                                                                                                                                                                                
            } else {                                                                                                                                                                                                                                           
                Log.info("[JouleHelper] No thread matching title discovered. Starting a clean environment context thread.");                                                                                                                                   
                const oNewThread = await oJoule.newConversation("", sTargetTitle);                                                                                                                                                                             
                if (oNewThread && (oNewThread.thread_id || oNewThread.id)) {                                                                                                                                                                                   
                    _sActiveThreadId = oNewThread.thread_id || oNewThread.id;                                                                                                                                                                                  
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        } catch (oError) {                                                                                                                                                                                                                                     
            Log.error("[JouleHelper] Error encountered restoring conversation alignment focus:", oError);                                                                                                                                                      
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Resets the module's session-wide cached variable thread tracking pointer.                                                                                                                                                                               
     */                                                                                                                                                                                                                                                        
    JouleHelper.clearSessionCache = function () {                                                                                                                                                                                                              
        Log.info("[JouleHelper] Clearing local session thread references state mapping.");                                                                                                                                                                     
        _sActiveThreadId = null;                                                                                                                                                                                                                               
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    // =========================================================================                                                                                                                                                                               
    // SURFACED PASSTHROUGH WRAPPER METHODS FROM NATIVE API                                                                                                                                                                                                    
    // =========================================================================                                                                                                                                                                               
                                                                                                                                                                                                                                                               
    JouleHelper.show = function () {                                                                                                                                                                                                                           
        const api = _getWebClientAPI();                                                                                                                                                                                                                        
        if (api) { api.show(); } else { Log.error("[JouleHelper] Cannot execute show(). API missing."); }                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    JouleHelper.hide = function () {                                                                                                                                                                                                                           
        const api = _getWebClientAPI();                                                                                                                                                                                                                        
        if (api) { api.hide(); }                                                                                                                                                                                                                               
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    JouleHelper.toggle = function () {                                                                                                                                                                                                                         
        const api = _getWebClientAPI();                                                                                                                                                                                                                        
        if (api) { api.toggle(); }                                                                                                                                                                                                                             
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    JouleHelper.expand = function () {                                                                                                                                                                                                                         
        const api = _getWebClientAPI();                                                                                                                                                                                                                        
        if (api) { api.expand(); }                                                                                                                                                                                                                             
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    JouleHelper.collapse = function () {                                                                                                                                                                                                                       
        const api = _getWebClientAPI();                                                                                                                                                                                                                        
        if (api) { api.collapse(); }                                                                                                                                                                                                                           
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    JouleHelper.toggleFullScreen = function () {                                                                                                                                                                                                               
        const api = _getWebClientAPI();                                                                                                                                                                                                                        
        if (api) { api.toggleFullScreen(); }                                                                                                                                                                                                                   
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    /**                                                                                                                                                                                                                                                        
     * Deletes the conversation associated with the helper's active track context.                                                                                                                                                                             
     */                                                                                                                                                                                                                                                        
    JouleHelper.deleteCurrentSessionThread = async function () {                                                                                                                                                                                               
        const api = _getWebClientAPI();                                                                                                                                                                                                                        
        if (!api) { return; }                                                                                                                                                                                                                                  
        if (!_sActiveThreadId) {                                                                                                                                                                                                                               
            const sTargetTitle = _getText("jouleThreadTitle", DEFAULT_CONVERSATION_TITLE);                                                                                                                                                                     
            _sActiveThreadId = await _findExistingThreadIdOnServer(api, sTargetTitle);                                                                                                                                                                         
        }                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
        if (_sActiveThreadId) {                                                                                                                                                                                                                                
            Log.info(`[JouleHelper] Tearing down thread metadata instance: ${_sActiveThreadId}`);                                                                                                                                                              
            await api.deleteConversation(_sActiveThreadId);                                                                                                                                                                                                    
            JouleHelper.clearSessionCache();                                                                                                                                                                                                                   
            MessageToast.show("Test conversation context successfully removed.");                                                                                                                                                                              
        } else {                                                                                                                                                                                                                                               
            Log.warning("[JouleHelper] No active matching testing threads discovered to purge.");                                                                                                                                                              
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    return JouleHelper;                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
