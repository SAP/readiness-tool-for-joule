		 			new sap.ui.table.Column({                                                                                                                                                                                                                                
					 	label: new sap.m.Label({text: oResourceBundle.getText("statusTabStatus"), wrapping:true}),                                                                                                                                                              
    					template: oObjectStatus,                                                                                                                                                                                                                              
