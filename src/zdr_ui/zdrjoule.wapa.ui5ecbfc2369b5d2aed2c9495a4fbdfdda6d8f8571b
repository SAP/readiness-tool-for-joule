		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Sets the text for the overview information error                                                                                                                                                                                                          
		 * @param{object}oEvent - event from setMenuCount.                                                                                                                                                                                                           
		 */                                                                                                                                                                                                                                                          
		_setAppInformationErrorText: function (oEvent) {                                                                                                                                                                                                             
			var oResourceBundle, oMessageStrip;                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
			oResourceBundle = oEvent.getSource().getModel("i18n").getResourceBundle();                                                                                                                                                                                  
			oMessageStrip = new sap.m.MessageStrip("ade-error-status", {                                                                                                                                                                                                
				showIcon: true,                                                                                                                                                                                                                                            
				text: oResourceBundle.getText("appInformationText", oResourceBundle.getText("errorType")),                                                                                                                                                                 
				type: "Warning"                                                                                                                                                                                                                                            
			});                                                                                                                                                                                                                                                         
			                                                                                                                                                                                                                                                            
			oMessageStrip.setLink(                                                                                                                                                                                                                                      
				new sap.m.Link({                                                                                                                                                                                                                                           
					text: oResourceBundle.getText("overviewLinkText"),                                                                                                                                                                                                        
					target: "_blank"                                                                                                                                                                                                                                          
				}).attachPress(function () {                                                                                                                                                                                                                               
					//Click the button for downloading the logs                                                                                                                                                                                                               
					sap.ui.getCore().byId("ade-download-btn").firePress();                                                                                                                                                                                                    
				}));                                                                                                                                                                                                                                                       
			oMessageStrip.addStyleClass("sapUiSmallMargin");                                                                                                                                                                                                            
			var oAdeAppInfo = sap.ui.getCore().byId("adeAppInfo");                                                                                                                                                                                                      
			//Only add the error message if there are no other elements than the form itself                                                                                                                                                                            
