    					sortProperty: "FieldText",                                                                                                                                                                                                                            
						filterProperty: "FieldText",                                                                                                                                                                                                                             
						width: "55%"                                                                                                                                                                                                                                             
					})                                                                                                                                                                                                                                                        
				);                                                                                                                                                                                                                                                         
				                                                                                                                                                                                                                                                           
				oStatusTable.addColumn(				                                                                                                                                                                                                                                
		 			new sap.ui.table.Column({                                                                                                                                                                                                                                
					 	label: new sap.m.Label({text: "" }),                                                                                                                                                                                                                    
    					template: new sap.m.Link({                                                                                                                                                                                                                            
    						target:"_blank",                                                                                                                                                                                                                                     
							text: oResourceBundle.getText("statusTabManualLink"),                                                                                                                                                                                                   
							wrapping: true                                                                                                                                                                                                                                          
    					}).bindProperty("href", "Url"),                                                                                                                                                                                                                       
    					sortProperty: "FieldText",                                                                                                                                                                                                                            
						filterProperty: "FieldText"                                                                                                                                                                                                                              
					})                                                                                                                                                                                                                                                        
				);                                                                                                                                                                                                                                                         
				                                                                                                                                                                                                                                                           
				oStatusTable.setShowNoData(false);                                                                                                                                                                                                                         
				oStatusTable.setModel(oModel);                                                                                                                                                                                                                             
				oStatusTable.bindRows("/statusItems");                                                                                                                                                                                                                     
				oStatusTable.autoResizeColumn(0);                                                                                                                                                                                                                          
