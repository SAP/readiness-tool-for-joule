		 */                                                                                                                                                                                                                                                          
		buildLevel1Pages: function (sAppkey, sAppType, oItem) {                                                                                                                                                                                                      
			var that = this;                                                                                                                                                                                                                                            
			//prepare keys for Odata call                                                                                                                                                                                                                               
			var sLvl1Id = oItem.getKey();                                                                                                                                                                                                                               
			var sServiceUrl = this._prepareMenuModelCall(sLvl1Id, "", "OverviewEntitySet");                                                                                                                                                                             
			var oScrollContainer = this.makeScrollContainer(sLvl1Id);                                                                                                                                                                                                   
			oScrollContainer.setBusy(true);                                                                                                                                                                                                                             
			this.oServiceModel.read(sServiceUrl, {                                                                                                                                                                                                                      
				success: function (results, error) {                                                                                                                                                                                                                       
					//check results                                                                                                                                                                                                                                           
					if (!results) {                                                                                                                                                                                                                                           
						return;                                                                                                                                                                                                                                                  
					}                                                                                                                                                                                                                                                         
					var oResults = results.results;                                                                                                                                                                                                                           
					var oSmartForm = new sap.ui.comp.smartform.SmartForm();                                                                                                                                                                                                   
					oSmartForm.setLayout(                                                                                                                                                                                                                                     
						new sap.ui.comp.smartform.Layout(                                                                                                                                                                                                                        
							{                                                                                                                                                                                                                                                       
								columnsL: 1,                                                                                                                                                                                                                                           
								columnsM: 1,                                                                                                                                                                                                                                           
								columnsXL: 1                                                                                                                                                                                                                                           
							}                                                                                                                                                                                                                                                       
						)                                                                                                                                                                                                                                                        
					 );                                                                                                                                                                                                                                                       
					//get i18n model to set texts                                                                                                                                                                                                                             
					var oResourceBundle = that.oContainer.getModel("i18n").getResourceBundle();                                                                                                                                                                               
					var sDetailLvl1Name = oItem.getText();                                                                                                                                                                                                                    
					var oSystemInformation = new sap.ui.comp.smartform.Group();                                                                                                                                                                                               
					oSystemInformation.setLabel(                                                                                                                                                                                                                              
						sDetailLvl1Name + " - " +                                                                                                                                                                                                                                
						oResourceBundle.getText("SystemInformation")                                                                                                                                                                                                             
					);                                                                                                                                                                                                                                                        
					var sGroupId;                                                                                                                                                                                                                                             
					oSmartForm.addGroup(oSystemInformation);                                                                                                                                                                                                                  
					var systemStatusItems = [];                                                                                                                                                                                                                               
					                                                                                                                                                                                                                                                          
					for (var i = 0; i < oResults.length; i++) {                                                                                                                                                                                                               
						//Loop over Data from servers in question                                                                                                                                                                                                                
						if (!sGroupId) {                                                                                                                                                                                                                                         
							sGroupId = oResults[i].GroupId;                                                                                                                                                                                                                         
						}                                                                                                                                                                                                                                                        
						if (sGroupId === oResults[i].GroupId) {                                                                                                                                                                                                                  
							var oGroupElement = Formatter.createGroupElementLvl1(oResults[i], oResourceBundle);                                                                                                                                                                     
							                                                                                                                                                                                                                                                        
							if (!oResults[i].FieldType || !oResults[i].FieldType === "") {                                                                                                                                                                                          
								oSystemInformation.addGroupElement(oGroupElement).setVisible(true);                                                                                                                                                                                    
							} else {                                                                                                                                                                                                                                                
								oResults[i] = that.setItemStatus(oResults[i], oResourceBundle);                                                                                                                                                                                        
								systemStatusItems.push(oResults[i]);                                                                                                                                                                                                                   
							}                                                                                                                                                                                                                                                       
						}                                                                                                                                                                                                                                                        
						//place in App Information section                                                                                                                                                                                                                       
						oScrollContainer.addContent(oSmartForm);                                                                                                                                                                                                                 
					}                                                                                                                                                                                                                                                         
					                                                                                                                                                                                                                                                          
					var oStatusTable = that.createSystemStatusTable(systemStatusItems,&nbsp;                                                                                                                                                                                  
																	oResourceBundle,&nbsp;                                                                                                                                                                                                                        
																	sDetailLvl1Name,&nbsp;                                                                                                                                                                                                                        
																	Table);                                                                                                                                                                                                                                       
					if (oStatusTable) {                                                                                                                                                                                                                                       
						oScrollContainer.addContent(oStatusTable);                                                                                                                                                                                                               
						that.setMenuIconWhenError(systemStatusItems);                                                                                                                                                                                                            
					}                                                                                                                                                                                                                                                         
					oScrollContainer.setBusy(false);                                                                                                                                                                                                                          
				}                                                                                                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Builds                                                                                                                                                                                                                                                    
