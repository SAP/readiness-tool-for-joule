		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Sets the error icon when there is a bad status among the status items                                                                                                                                                                                     
		 * @param{object}oStatusItems - Status Items                                                                                                                                                                                                                 
		 */                                                                                                                                                                                                                                                          
		setMenuIconWhenError: function(oStatusItems) {                                                                                                                                                                                                               
