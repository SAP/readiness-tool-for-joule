sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/base/Object",                                                                                                                                                                                                                                         
	"sap/ui/model/json/JSONModel",                                                                                                                                                                                                                                
	"sap/ui/core/util/Export",                                                                                                                                                                                                                                    
	"sap/ui/core/util/ExportTypeCSV",                                                                                                                                                                                                                             
	"sap/ui/export/Spreadsheet",                                                                                                                                                                                                                                  
	"nw/core/flp/appdiagnostics/formatter/Formatter",                                                                                                                                                                                                             
	"nw/core/flp/appdiagnostics/helper/TableHelper",                                                                                                                                                                                                              
	"sap/ui/table/Table",                                                                                                                                                                                                                                         
	"sap/ui/core/CustomData",                                                                                                                                                                                                                                     
	"sap/ui/comp/smartform/SmartForm"                                                                                                                                                                                                                             
], function (Object, JSONModel, Export, ExportTypeCSV, Spreadsheet, Formatter, TableHelperManager, Table, CustomData) {                                                                                                                                        
	"use strict";                                                                                                                                                                                                                                                 
	var instance;                                                                                                                                                                                                                                                 
	var ViewHelper = Object.extend("dr.joule.assistant.drjoule.helper.ViewHelper", {                                                                                                                                                                              
		//keys for accessing Overview (App Information) service                                                                                                                                                                                                      
		oMenuEntityKeys: {                                                                                                                                                                                                                                           
			Appkey: "",                                                                                                                                                                                                                                                 
			Id: "",                                                                                                                                                                                                                                                     
			IdLvl1: "",                                                                                                                                                                                                                                                 
			Username: ""                                                                                                                                                                                                                                                
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Constructor sets app type and service id only once                                                                                                                                                                                                        
		 * They should never change in the app context                                                                                                                                                                                                               
		 * @param{string}sAppkey - Key for the current App                                                                                                                                                                                                           
		 * */                                                                                                                                                                                                                                                        
		constructor: function (sAppkey) {                                                                                                                                                                                                                            
			this.oMenuEntityKeys.Appkey = sAppkey;                                                                                                                                                                                                                      
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Sets the Container and the i18n model                                                                                                                                                                                                                     
		 * @param{object} oServiceModel - Model of the oData Service.                                                                                                                                                                                                
		 * @param{object} oContainer - Container of the plugin.                                                                                                                                                                                                      
		 * @param{object} oFormatter - View Formatter.                                                                                                                                                                                                               
		 * @param{object} oOwnerComponent - Owner Component from controller.                                                                                                                                                                                         
		 * */                                                                                                                                                                                                                                                        
		initialize: function (oServiceModel, oContainer, oFormatter, oOwnerComponent) {                                                                                                                                                                              
			this.oServiceModel = oServiceModel;                                                                                                                                                                                                                         
			this.oContainer = oContainer;                                                                                                                                                                                                                               
			this.Formatter = oFormatter;                                                                                                                                                                                                                                
			this.oTableHelper = TableHelperManager.getInstance();                                                                                                                                                                                                       
			this.oTableHelper.initialize(this, oContainer.getModel("i18n"), oFormatter);                                                                                                                                                                                
			this.oOwnerComponent = oOwnerComponent;                                                                                                                                                                                                                     
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Create scrollcontainer for menu items content                                                                                                                                                                                                             
		 * @param{object} sContainerId - Id of container.                                                                                                                                                                                                            
		 * @returns {object} creates ScrollContainer.                                                                                                                                                                                                                
		 * */                                                                                                                                                                                                                                                        
		makeScrollContainer: function (sContainerId) {                                                                                                                                                                                                               
			var oScrollContainer;                                                                                                                                                                                                                                       
			oScrollContainer = new sap.m.ScrollContainer(sContainerId);                                                                                                                                                                                                 
			// set Height to 99% to receive scrollbar in combination with vertical true                                                                                                                                                                                 
			oScrollContainer.setHeight("99%").setVertical(true);                                                                                                                                                                                                        
			this.addPage(oScrollContainer);                                                                                                                                                                                                                             
			return oScrollContainer;                                                                                                                                                                                                                                    
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Creates the app information page&nbsp;                                                                                                                                                                                                                    
		 * @constructor&nbsp;                                                                                                                                                                                                                                        
		 * @param{object}oConfigData - Array with names of the app information overview.                                                                                                                                                                             
		 */                                                                                                                                                                                                                                                          
		buildAppInformation: function (oConfigData) {                                                                                                                                                                                                                
			var oScrollContainer, oSmartForm, oResourceBundle, oOverviewGroup, oTechnicalDetailsGroup, oGroupElement, sValueInternalAppType, sLabel;                                                                                                                    
			//get i18n model to set texts                                                                                                                                                                                                                               
			oResourceBundle = this.oContainer.getModel("i18n").getResourceBundle();                                                                                                                                                                                     
			//Build ScrollContainer with id = overview                                                                                                                                                                                                                  
			oScrollContainer = this.makeScrollContainer("adeAppInfo");                                                                                                                                                                                                  
			//set as start view                                                                                                                                                                                                                                         
			this.navigateTo("adeAppInfo");                                                                                                                                                                                                                              
			//request app parameter section                                                                                                                                                                                                                             
			this.buildExtendedAppInfo(this.oMenuEntityKeys.Appkey);                                                                                                                                                                                                     
			//Build SmartForm with Layout and add to ScrollContainer                                                                                                                                                                                                    
			oSmartForm = new sap.ui.comp.smartform.SmartForm( "appInformationSmartform", {                                                                                                                                                                              
							title: oResourceBundle.getText("appInformation")                                                                                                                                                                                                        
						}).setLayout(                                                                                                                                                                                                                                            
							new sap.ui.comp.smartform.Layout(                                                                                                                                                                                                                       
								{                                                                                                                                                                                                                                                      
									columnsL: 1,                                                                                                                                                                                                                                          
									columnsM: 1,                                                                                                                                                                                                                                          
									columnsXL: 1                                                                                                                                                                                                                                          
								}                                                                                                                                                                                                                                                      
							)                                                                                                                                                                                                                                                       
						 );                                                                                                                                                                                                                                                      
			oScrollContainer.addContent(oSmartForm);                                                                                                                                                                                                                    
			//Add groups                                                                                                                                                                                                                                                
			oOverviewGroup = new sap.ui.comp.smartform.Group("adeOverviewGroup").setLabel(oResourceBundle.getText("overviewGroupName"));                                                                                                                                
			oSmartForm.addGroup(oOverviewGroup);                                                                                                                                                                                                                        
			oTechnicalDetailsGroup = new sap.ui.comp.smartform.Group("adeTechnicalDetailsGroup").setLabel(oResourceBundle.getText("technicalDetailsGroupName"));                                                                                                        
			oSmartForm.addGroup(oTechnicalDetailsGroup);                                                                                                                                                                                                                
			                                                                                                                                                                                                                                                            
			//get base URL for apps library                                                                                                                                                                                                                             
			var oOverviewConfig = new sap.ui.model.json.JSONModel();                                                                                                                                                                                                    
			oOverviewConfig.loadData(jQuery.sap.getModulePath("nw.core.flp.appdiagnostics") + "/config/overviewConfiguration.json", null, false);                                                                                                                       
			var oOverviewConfigData = oOverviewConfig.getData();                                                                                                                                                                                                        
			                                                                                                                                                                                                                                                            
			sValueInternalAppType	  = oConfigData.internalAppType.value;                                                                                                                                                                                                
			//Default the value in case the app type cannot be determined                                                                                                                                                                                               
			//If the app lifecycle service is missing                                                                                                                                                                                                                   
			oConfigData.appType.value = oConfigData.internalAppType.value;                                                                                                                                                                                              
			                                                                                                                                                                                                                                                            
			this.oConfigDataModel = new sap.ui.model.json.JSONModel({                                                                                                                                                                                                   
				configData: oConfigData&nbsp;                                                                                                                                                                                                                              
			});                                                                                                                                                                                                                                                         
			//Determines the app type displayed on the frontend in app information                                                                                                                                                                                      
			this.determineAppType();                                                                                                                                                                                                                                    
			var that = this;                                                                                                                                                                                                                                            
			//Loop over Data from UI5 App and generate Outputs                                                                                                                                                                                                          
			for (var key in oConfigData) {                                                                                                                                                                                                                              
				//Do not set intial values except for the app type as it is determined async                                                                                                                                                                               
				//do not add the internal app type to the output                                                                                                                                                                                                           
				if ((oConfigData[key].value !== undefined &&&nbsp;                                                                                                                                                                                                         
					oConfigData[key].value !== null &&                                                                                                                                                                                                                        
					key !== "internalAppType") ||                                                                                                                                                                                                                             
					key === "appType") {                                                                                                                                                                                                                                      
					                                                                                                                                                                                                                                                          
					if (key === "appDescription" && oConfigData[key].value === "appDescription") {                                                                                                                                                                            
						//Workaround implemented for now in case the appDescription cannot be retrieved                                                                                                                                                                          
						//the description will not appear in the app information                                                                                                                                                                                                 
						continue;                                                                                                                                                                                                                                                
					}                                                                                                                                                                                                                                                         
					                                                                                                                                                                                                                                                          
					sLabel = Formatter.setLabelforAppInformation(                                                                                                                                                                                                             
								key,&nbsp;                                                                                                                                                                                                                                             
								sValueInternalAppType,&nbsp;                                                                                                                                                                                                                           
								oConfigData[key].label,&nbsp;                                                                                                                                                                                                                          
								this.oContainer.getModel("i18n").getResourceBundle()                                                                                                                                                                                                   
							  );                                                                                                                                                                                                                                                    
					oGroupElement = new sap.ui.comp.smartform.GroupElement().setLabel(sLabel);                                                                                                                                                                                
                                                                                                                                                                                                                                                               
					if (oConfigData[key].isTechnical === false) {                                                                                                                                                                                                             
						//non technical details will be in the overview                                                                                                                                                                                                          
						oOverviewGroup.addGroupElement(oGroupElement).setVisible(true);                                                                                                                                                                                          
					} else {                                                                                                                                                                                                                                                  
						//technical details will be in the technical details section                                                                                                                                                                                             
						oTechnicalDetailsGroup.addGroupElement(oGroupElement).setVisible(true);                                                                                                                                                                                  
					}                                                                                                                                                                                                                                                         
					//Maybe formatter later on required for the binded group element text                                                                                                                                                                                     
					that.oConfigDataModel.setProperty("/configData/" + key + "/value", Formatter.setValueforAppInformation(key, oConfigData[key].value));                                                                                                                     
					if (key === "fioriId" && oConfigData[key].value && oOverviewConfigData.appsLibrary ){                                                                                                                                                                     
						oGroupElement.addElement( new sap.m.Link({&nbsp;                                                                                                                                                                                                         
							text: oConfigData[key].value,&nbsp;                                                                                                                                                                                                                     
							href: oOverviewConfigData.appsLibrary + "Apps('" + oConfigData[key].value + "')",                                                                                                                                                                       
							target: "_blank"                                                                                                                                                                                                                                        
						}) );                                                                                                                                                                                                                                                    
					}else{                                                                                                                                                                                                                                                    
						oGroupElement.addField(new sap.m.Text().setModel(that.oConfigDataModel).bindText("/configData/" + key + "/value")).setVisible(true);                                                                                                                     
					}                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
				}                                                                                                                                                                                                                                                          
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Build the UI5 information pages.                                                                                                                                                                                                                          
		 *&nbsp;                                                                                                                                                                                                                                                     
		 * @param {nw.core.flp.appdiagnostics.ui5Information.Ui5InformationProvider} oUi5InformationProvider UI5 information provider instance.                                                                                                                      
		 * @param {sap.tnt.NavigationListItem} oMenuItem - Level 1 menu item for Fiori information                                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		buildUI5Information: function(oUi5InformationProvider, oMenuItem) {                                                                                                                                                                                          
			//get i18n model to set texts                                                                                                                                                                                                                               
			var oResourceBundle = this.oContainer.getModel("i18n").getResourceBundle();                                                                                                                                                                                 
			//Build ScrollContainer with id = adeUi5Info and add to nav container                                                                                                                                                                                       
			var oScrollContainer = this.makeScrollContainer(oMenuItem.getKey());                                                                                                                                                                                        
			                                                                                                                                                                                                                                                            
			//Build SmartForm with Layout and add to ScrollContainer                                                                                                                                                                                                    
			var oSmartForm = new sap.ui.comp.smartform.SmartForm({                                                                                                                                                                                                      
							title: oResourceBundle.getText("ui5Information")                                                                                                                                                                                                        
						}).setLayout(                                                                                                                                                                                                                                            
							new sap.ui.comp.smartform.Layout(                                                                                                                                                                                                                       
								{                                                                                                                                                                                                                                                      
									columnsL: 1,                                                                                                                                                                                                                                          
									columnsM: 1,                                                                                                                                                                                                                                          
									columnsXL: 1                                                                                                                                                                                                                                          
								}                                                                                                                                                                                                                                                      
							)                                                                                                                                                                                                                                                       
						 );                                                                                                                                                                                                                                                      
			oScrollContainer.addContent(oSmartForm);                                                                                                                                                                                                                    
			                                                                                                                                                                                                                                                            
			//Add groups                                                                                                                                                                                                                                                
			this._buildUi5InformationGroup(oSmartForm, "adeUi5OverviewGroup", oResourceBundle.getText("overviewGroupName"), "/sapui5");                                                                                                                                 
			this._buildUi5InformationGroup(oSmartForm, "adeUi5FormatSettings", oResourceBundle.getText("formatSettings"), "/formatSettings");                                                                                                                           
			this._buildUi5InformationGroup(oSmartForm, "adeUi5LoadedLibrariesGroup", oResourceBundle.getText("loadedLibrariesGroupName"), "/loadedLibraries");                                                                                                          
			this._buildUi5InformationGroup(oSmartForm, "adeUi5CompatibilityVersions", oResourceBundle.getText("compatibilityVersions"), "/compatibilityVersions");                                                                                                      
			this._buildUi5InformationGroup(oSmartForm, "adeUi5LibrariesGroup", oResourceBundle.getText("allLibrariesGroupName"), "/libraries");                                                                                                                         
			                                                                                                                                                                                                                                                            
			//Build detail pages for each provider                                                                                                                                                                                                                      
			oUi5InformationProvider.getModel().getProperty("/providers").forEach(function(oProvider) {                                                                                                                                                                  
				this._buildUi5DetailPage(oProvider);                                                                                                                                                                                                                       
			}.bind(this));                                                                                                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Build a group on the UI5 information page.                                                                                                                                                                                                                
		 *&nbsp;                                                                                                                                                                                                                                                     
		 * @param {sap.ui.comp.smartform.SmartForm} oSmartForm Smart form on the page.                                                                                                                                                                               
		 * @param {string} sGroupId - ID of the group.                                                                                                                                                                                                               
		 * @param {string} sGroupTitle - Title for the group.                                                                                                                                                                                                        
		 * @param {string} sPath - Path in the UI5 info model with the information to be shown in this group.                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		_buildUi5InformationGroup: function(oSmartForm, sGroupId, sGroupTitle, sPath) {                                                                                                                                                                              
			var oGroup = new sap.ui.comp.smartform.Group(sGroupId).setLabel(sGroupTitle);                                                                                                                                                                               
			oSmartForm.addGroup(oGroup);                                                                                                                                                                                                                                
			                                                                                                                                                                                                                                                            
			//Loop over data from UI5 App and generate Outputs                                                                                                                                                                                                          
			var fnGroupElementFactory = function(sId, oContext) {                                                                                                                                                                                                       
				//Do not set intial values except for the app type as it is determined async                                                                                                                                                                               
				//do not add the internal app type to the output                                                                                                                                                                                                           
				var oGroupElement = new sap.ui.comp.smartform.GroupElement(sGroupId + "-" + oContext.getProperty("key")).setLabel(oContext.getProperty("title"));                                                                                                          
				oGroupElement.addField(new sap.m.Text().setText(oContext.getProperty("value"))).setVisible(true);                                                                                                                                                          
				return oGroupElement;                                                                                                                                                                                                                                      
			};                                                                                                                                                                                                                                                          
			oGroup.bindAggregation("groupElements", {                                                                                                                                                                                                                   
				model: "ui5info",                                                                                                                                                                                                                                          
				path: sPath,                                                                                                                                                                                                                                               
				factory: fnGroupElementFactory                                                                                                                                                                                                                             
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Build the detail page for a provider.                                                                                                                                                                                                                     
		 * @param {object} oProvider - Provider                                                                                                                                                                                                                      
		 * @param {string} oProvider.id - Provider ID, used as page ID                                                                                                                                                                                               
		 * @param {string} oProvider.name - User-facing name of the provider                                                                                                                                                                                         
		 * @param {boolean} oProvider.table - Provider data is table or form&nbsp;                                                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		_buildUi5DetailPage: function(oProvider) {                                                                                                                                                                                                                   
			var oScrollContainer = this.makeScrollContainer(oProvider.id);                                                                                                                                                                                              
			var oResourceBundle = this.oContainer.getModel("i18n").getResourceBundle();                                                                                                                                                                                 
			var sTableHeader = oResourceBundle.getText("ui5Information") + " - " + oProvider.name;                                                                                                                                                                      
			                                                                                                                                                                                                                                                            
			var aCustomData = [                                                                                                                                                                                                                                         
				new CustomData({                                                                                                                                                                                                                                           
					key: "UsernameVisible",                                                                                                                                                                                                                                   
					value: false                                                                                                                                                                                                                                              
				}),                                                                                                                                                                                                                                                        
				new CustomData({                                                                                                                                                                                                                                           
					key: "LinkToLog",                                                                                                                                                                                                                                         
					value: false                                                                                                                                                                                                                                              
				})                                                                                                                                                                                                                                                         
			];                                                                                                                                                                                                                                                          
			                                                                                                                                                                                                                                                            
			if (oProvider.table) {                                                                                                                                                                                                                                      
				var oTable = this.oTableHelper.createTableFromFragment(oProvider.id, "/" + oProvider.id, sTableHeader, aCustomData, "ui5info");                                                                                                                            
				this.hideDefaultColumns(oTable, true);                                                                                                                                                                                                                     
				oTable.setBusy(false);                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
				//place table in view section                                                                                                                                                                                                                              
				oTable.placeAt(oScrollContainer);                                                                                                                                                                                                                          
			} else {                                                                                                                                                                                                                                                    
				//TODO: Build form page                                                                                                                                                                                                                                    
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		* Determines the real app type of the application and save it to the config data                                                                                                                                                                             
		*/                                                                                                                                                                                                                                                           
		determineAppType: function() {                                                                                                                                                                                                                               
			var that = this;                                                                                                                                                                                                                                            
			                                                                                                                                                                                                                                                            
			//Only executable if the AppLifeCycle service is available                                                                                                                                                                                                  
			if (sap.ushell &&&nbsp;                                                                                                                                                                                                                                     
				sap.ushell.Container &&&nbsp;                                                                                                                                                                                                                              
				sap.ushell.Container.getService("AppLifeCycle") &&                                                                                                                                                                                                         
				sap.ushell.Container.getService("AppLifeCycle").getCurrentApplication()) {                                                                                                                                                                                 
					                                                                                                                                                                                                                                                          
				var oAppLifeCycleApp = sap.ushell.Container.getService("AppLifeCycle").getCurrentApplication();                                                                                                                                                            
				                                                                                                                                                                                                                                                           
				if (oAppLifeCycleApp.getInfo) {                                                                                                                                                                                                                            
					oAppLifeCycleApp.getInfo(["appFrameworkId"])                                                                                                                                                                                                              
				    	.then(function (oInfo) {                                                                                                                                                                                                                              
				    		//In later releases the method getInfo will lead to a unified output                                                                                                                                                                                 
				    		//The about dialog and app support are showing the same app type for users                                                                                                                                                                           
				        	var sAppFramewordId = oInfo.appFrameworkId;                                                                                                                                                                                                       
				        	that.oConfigDataModel.setProperty("/configData/appType/value" ,sAppFramewordId);                                                                                                                                                                  
				    });                                                                                                                                                                                                                                                    
				} else {                                                                                                                                                                                                                                                   
					//In lower releases where the AppLifeCycle service exists but the method getInfo is not available                                                                                                                                                         
					//the applicationType will be taken instead. There is no mismatch between the about dialog and app support                                                                                                                                                
					//as the about dialog does not have the application type attribute in these releases                                                                                                                                                                      
					that.oConfigDataModel.setProperty(                                                                                                                                                                                                                        
						"/configData/appType/value" ,&nbsp;                                                                                                                                                                                                                      
						Formatter.convertAppTypeToFrameworkID(                                                                                                                                                                                                                   
							oAppLifeCycleApp.applicationType,                                                                                                                                                                                                                       
							this.oContainer.getModel("i18n").getResourceBundle()                                                                                                                                                                                                    
						)                                                                                                                                                                                                                                                        
					);                                                                                                                                                                                                                                                        
				}                                                                                                                                                                                                                                                          
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Hides default columns which are the same among all different log kinds                                                                                                                                                                                    
		 * @param{object}oTable - Table                                                                                                                                                                                                                              
		 * @param{boolean} bLocal - `true` if data is local and system-relevant columns should be hidden.                                                                                                                                                            
		 */                                                                                                                                                                                                                                                          
		hideDefaultColumns: function (oTable, bLocal) {                                                                                                                                                                                                              
			oTable.getColumns().forEach(function(column) {                                                                                                                                                                                                              
				var id = column.getId().split("--")[1];                                                                                                                                                                                                                    
				if (id === "system" ||                                                                                                                                                                                                                                     
					id === "client" ||                                                                                                                                                                                                                                        
					id === "user" ||                                                                                                                                                                                                                                          
					id === "source") {                                                                                                                                                                                                                                        
					column.setVisible(false);                                                                                                                                                                                                                                 
				}                                                                                                                                                                                                                                                          
				if (bLocal && (                                                                                                                                                                                                                                            
					id === "context" ||                                                                                                                                                                                                                                       
					id === "link" ||                                                                                                                                                                                                                                          
					id === "date"                                                                                                                                                                                                                                             
				)) {                                                                                                                                                                                                                                                       
					column.setVisible(false);                                                                                                                                                                                                                                 
				}                                                                                                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Builds the tables and sets them in the corresponding pages                                                                                                                                                                                                
		 * @param{string}sAppkey - Id of the opened App.                                                                                                                                                                                                             
		 * @param{object}oSubItem - Menu subentry.                                                                                                                                                                                                                   
		 * @param{string}sAppType - Type of the current application                                                                                                                                                                                                  
		 * @param{object}oLvl1Item - Main level menu item.                                                                                                                                                                                                           
		 */                                                                                                                                                                                                                                                          
		buildDetailPages: function (sAppkey, oSubItem, sAppType, oLvl1Item) {                                                                                                                                                                                        
			var that, oTable, oScrollContainer, sTableHeader, sServiceUrl;                                                                                                                                                                                              
			var oResourceBundle = this.oContainer.getModel("i18n").getResourceBundle();                                                                                                                                                                                 
			// create container for table                                                                                                                                                                                                                               
			oScrollContainer = this.makeScrollContainer(oSubItem.getKey());                                                                                                                                                                                             
			that = this;                                                                                                                                                                                                                                                
	                                                                                                                                                                                                                                                              
			sTableHeader = oLvl1Item.getText() +                                                                                                                                                                                                                        
				" - " + oSubItem.getText().substring(0, oSubItem.getText().indexOf("("));                                                                                                                                                                                  
			sServiceUrl = this._prepareMenuModelCall(oLvl1Item.getKey(), oSubItem.getKey(), "DiagnosticLogSet");                                                                                                                                                        
			//get table from xml fragment                                                                                                                                                                                                                               
			oTable = this.oTableHelper.createTableFromFragment(oSubItem.getKey(), sServiceUrl, sTableHeader, oSubItem.getCustomData());                                                                                                                                 
			oTable.attachEvent("updateFinished",                                                                                                                                                                                                                        
				function (oEvent) {                                                                                                                                                                                                                                        
					that.setMenuCount(oEvent);                                                                                                                                                                                                                                
					oTable.setBusy(false);                                                                                                                                                                                                                                    
				});                                                                                                                                                                                                                                                        
			                                                                                                                                                                                                                                                            
			this.hideDefaultColumns(oTable);                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
			//Add timestamp                                                                                                                                                                                                                                             
			var oMessageStrip = new sap.m.MessageStrip({                                                                                                                                                                                                                
				text: oResourceBundle.getText("logRetrievedAt", this._getCurrentDateTime())                                                                                                                                                                                
			}).addStyleClass("sapUiSmallMargin");                                                                                                                                                                                                                       
