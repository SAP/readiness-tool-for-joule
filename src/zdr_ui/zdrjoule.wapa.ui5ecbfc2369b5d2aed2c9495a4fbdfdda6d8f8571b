			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Counts the number of errors to show them in the menu and set error text to overview                                                                                                                                                                       
		 * @param{object}oEvent - updateFinished Event of table.                                                                                                                                                                                                     
		 * */                                                                                                                                                                                                                                                        
		setMenuCount: function (oEvent) {                                                                                                                                                                                                                            
			var iLength, sId, oMenuItem, sText;                                                                                                                                                                                                                         
			var oTable = oEvent.getSource();                                                                                                                                                                                                                            
			//Begin correction 3536614 - 06 Nov 2024 - use inline count from odata instead                                                                                                                                                                              
			//check the number of log entries                                                                                                                                                                                                                           
			iLength = oEvent.getParameter("total");                                                                                                                                                                                                                     
			//End correction 3536614 - 06 Nov 2024                                                                                                                                                                                                                      
			//get the Id of the menu item                                                                                                                                                                                                                               
			sId = oTable.getId().replace("--log-table", "");                                                                                                                                                                                                            
			oMenuItem = sap.ui.getCore().byId(sId + "-menuItem");                                                                                                                                                                                                       
			//get old text from menu item and replace number of errors                                                                                                                                                                                                  
			sText = oMenuItem.getText();                                                                                                                                                                                                                                
			sText = sText.substr(0, (sText.indexOf("(") + 1)) + iLength + ")";                                                                                                                                                                                          
			oMenuItem.setText(sText);                                                                                                                                                                                                                                   
			//proof, if text is already set, case not, place it                                                                                                                                                                                                         
			if (iLength > 0 && !this.errorTextIsSet) {                                                                                                                                                                                                                  
				//get i18n model to set texts                                                                                                                                                                                                                              
				this._setAppInformationErrorText(oEvent);                                                                                                                                                                                                                  
				this.errorTextIsSet = true;                                                                                                                                                                                                                                
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Prepare oData call to backend                                                                                                                                                                                                                             
		 * @param{string}sLvl1Id - Level 1 Id                                                                                                                                                                                                                        
		 * @param{string}sId - Id for view                                                                                                                                                                                                                           
		 * @param{string}sToEntity - Entity appended to service Url                                                                                                                                                                                                  
		 * @returns{string}sServiceUrl - Complete Url of service                                                                                                                                                                                                     
		 * */                                                                                                                                                                                                                                                        
		_prepareMenuModelCall: function (sLvl1Id, sId, sToEntity) {                                                                                                                                                                                                  
			this.oMenuEntityKeys.IdLvl1 = sLvl1Id;                                                                                                                                                                                                                      
			this.oMenuEntityKeys.Id = sId;                                                                                                                                                                                                                              
			var sServiceUrl = this.oServiceModel.createKey("/MenuEntitySet", this.oMenuEntityKeys);                                                                                                                                                                     
			sServiceUrl += "/" + sToEntity;                                                                                                                                                                                                                             
			return sServiceUrl;                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Builds the parameter view, as the info is coming from the backend                                                                                                                                                                                         
		 * @param{string}sAppkey - Id of the called app.                                                                                                                                                                                                             
		 */                                                                                                                                                                                                                                                          
		buildExtendedAppInfo: function(sAppkey) {                                                                                                                                                                                                                    
		    sap.ui.require([                                                                                                                                                                                                                                         
		        "sap/ui/model/Filter",                                                                                                                                                                                                                               
		        "sap/ui/model/FilterOperator",                                                                                                                                                                                                                       
		        "sap/base/Log"                                                                                                                                                                                                                                       
		    ], function(Filter, FilterOperator, Log) {                                                                                                                                                                                                               
		        var oFilter = new Filter("Appkey", FilterOperator.EQ, sAppkey);                                                                                                                                                                                      
		&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                                                             
		        this.oServiceModel.read("/SUI_FLP_AS_APP_INFORMATION_EXT", {                                                                                                                                                                                         
		            filters: [oFilter],                                                                                                                                                                                                                              
		            urlParameters: { "$expand": "to_Values" },                                                                                                                                                                                                       
		            success: this.setExtendedAppInfo.bind(this),                                                                                                                                                                                                     
		            error: function(e) {                                                                                                                                                                                                                             
		                Log.error(e);                                                                                                                                                                                                                                
		            }                                                                                                                                                                                                                                                
		        });                                                                                                                                                                                                                                                  
		    }.bind(this));                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Builds the app information extended view, as the info is coming from the backend                                                                                                                                                                          
		 * Callback function                                                                                                                                                                                                                                         
		 * @param {object} oData - Result of the oData call to backend                                                                                                                                                                                               
		 */                                                                                                                                                                                                                                                          
		setExtendedAppInfo: function(oData) {                                                                                                                                                                                                                        
		    if (!oData || !oData.results || !oData.results.length) {                                                                                                                                                                                                 
		        return;                                                                                                                                                                                                                                              
		    }                                                                                                                                                                                                                                                        
		                                                                                                                                                                                                                                                             
		    sap.ui.require([                                                                                                                                                                                                                                         
		        "sap/ui/comp/smartform/Group",                                                                                                                                                                                                                       
		        "sap/ui/comp/smartform/GroupElement",                                                                                                                                                                                                                
		        "sap/m/Text"                                                                                                                                                                                                                                         
		    ], function(Group, GroupElement, Text) {                                                                                                                                                                                                                 
		        var oSmartForm = sap.ui.getCore().byId("appInformationSmartform");                                                                                                                                                                                   
		        //loop over groups                                                                                                                                                                                                                                   
		        oData.results.forEach(function(oCurrentResult) {                                                                                                                                                                                                     
		            //only add group, if there are group values available                                                                                                                                                                                            
		            if (oCurrentResult.to_Values && oCurrentResult.to_Values.results.length) {                                                                                                                                                                       
		                var oAppInfoGroup = new Group({                                                                                                                                                                                                              
		                    id: oCurrentResult.GroupID,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                        
		                    label: oCurrentResult.GroupName,                                                                                                                                                                                                         
		                    groupElements: this.createGroupElements(oCurrentResult, Group, GroupElement, Text)                                                                                                                                                       
		                });                                                                                                                                                                                                                                          
		                oSmartForm.addGroup(oAppInfoGroup);                                                                                                                                                                                                          
		            }                                                                                                                                                                                                                                                
		        }.bind(this));                                                                                                                                                                                                                                       
		    }.bind(this));                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Creates group elements based on the GroupID                                                                                                                                                                                                               
		 * @param {object} oCurrentResult - Current group data                                                                                                                                                                                                       
		 * @param {function} Group - Group constructor                                                                                                                                                                                                               
		 * @param {function} GroupElement - GroupElement constructor                                                                                                                                                                                                 
		 * @param {function} Text - Text constructor                                                                                                                                                                                                                 
		 * @returns {array} Array of GroupElements                                                                                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		createGroupElements: function(oCurrentResult, Group, GroupElement, Text) {                                                                                                                                                                                   
		    if (oCurrentResult.GroupID === "ADEAppInfoTMParameters") {                                                                                                                                                                                               
		        return this.createTMParametersGroupElements(oCurrentResult, GroupElement, Text);                                                                                                                                                                     
		    } else {                                                                                                                                                                                                                                                 
		        return this.createDefaultGroupElements(oCurrentResult, GroupElement, Text);                                                                                                                                                                          
		    }                                                                                                                                                                                                                                                        
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Creates default group elements                                                                                                                                                                                                                            
		 * @param {object} oCurrentResult - Current group data                                                                                                                                                                                                       
		 * @param {function} GroupElement - GroupElement constructor                                                                                                                                                                                                 
		 * @param {function} Text - Text constructor                                                                                                                                                                                                                 
		 * @returns {array} Array of GroupElements                                                                                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		createDefaultGroupElements: function(oCurrentResult, GroupElement, Text) {                                                                                                                                                                                   
		    return oCurrentResult.to_Values.results.map(function(oResultValue) {                                                                                                                                                                                     
		        return new GroupElement({                                                                                                                                                                                                                            
		            id: oCurrentResult.GroupID + "-" + oResultValue.ValueName.replace(/[^a-zA-Z0-9]/g, ''),                                                                                                                                                          
		            label: oResultValue.ValueName,                                                                                                                                                                                                                   
		            visible: true,                                                                                                                                                                                                                                   
		            fields: [                                                                                                                                                                                                                                        
		                new Text({                                                                                                                                                                                                                                   
		                    text: oResultValue.Value || oResultValue.DefaultValue                                                                                                                                                                                    
		                })                                                                                                                                                                                                                                           
		            ]                                                                                                                                                                                                                                                
		        });                                                                                                                                                                                                                                                  
		    });                                                                                                                                                                                                                                                      
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Creates group elements for TMParameters                                                                                                                                                                                                                   
		 * @param {object} oCurrentResult - Current group data                                                                                                                                                                                                       
		 * @param {function} GroupElement - GroupElement constructor                                                                                                                                                                                                 
		 * @param {function} Text - Text constructor                                                                                                                                                                                                                 
		 * @returns {array} Array of GroupElements                                                                                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		createTMParametersGroupElements: function(oCurrentResult, GroupElement, Text) {                                                                                                                                                                              
			//special handling of target mapping parameters -> read first from startup parameter then from user settings or default                                                                                                                                     
		    var oStartupParameters = this.oOwnerComponent.getComponentData() ? this.oOwnerComponent.getComponentData().startupParameters : {};                                                                                                                       
		    return oCurrentResult.to_Values.results.map(function(oResultValue) {                                                                                                                                                                                     
		        return new GroupElement({                                                                                                                                                                                                                            
		            id: oCurrentResult.GroupID + "-" + oResultValue.ValueName.replace(/[^a-zA-Z0-9]/g, ''),                                                                                                                                                          
		            label: oResultValue.ValueName,                                                                                                                                                                                                                   
		            visible: true,                                                                                                                                                                                                                                   
		            fields: [                                                                                                                                                                                                                                        
		                new Text({                                                                                                                                                                                                                                   
		                    text: oStartupParameters.hasOwnProperty(oResultValue.ValueName) ?&nbsp;                                                                                                                                                                  
		                    			oStartupParameters[oResultValue.ValueName].toString() :&nbsp;                                                                                                                                                                         
		                    			oResultValue.Value || oResultValue.DefaultValue                                                                                                                                                                                       
		                })                                                                                                                                                                                                                                           
		            ]                                                                                                                                                                                                                                                
		        });                                                                                                                                                                                                                                                  
		    });                                                                                                                                                                                                                                                      
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * navigate to content of menu item                                                                                                                                                                                                                          
		 * @param{string}sId - Id of page.                                                                                                                                                                                                                           
		 * */                                                                                                                                                                                                                                                        
		navigateTo: function (sId) {                                                                                                                                                                                                                                 
			this.oContainer.to(sId);                                                                                                                                                                                                                                    
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * insert content in container of the right menu item&nbsp;                                                                                                                                                                                                  
		 * @param{object}oPage - page, which should be added.                                                                                                                                                                                                        
		 * */                                                                                                                                                                                                                                                        
		addPage: function (oPage) {                                                                                                                                                                                                                                  
			this.oContainer.insertPage(oPage);                                                                                                                                                                                                                          
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
	// Singleton handling                                                                                                                                                                                                                                         
	return {                                                                                                                                                                                                                                                      
		getInstance: function (sAppkey, sAppType) {                                                                                                                                                                                                                  
			if (!instance) {                                                                                                                                                                                                                                            
				instance = new ViewHelper(sAppkey, sAppType);                                                                                                                                                                                                              
			}                                                                                                                                                                                                                                                           
			return instance;                                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		destroy: function () {                                                                                                                                                                                                                                       
			if (instance) {                                                                                                                                                                                                                                             
				instance.oMenuEntityKeys = null;                                                                                                                                                                                                                           
				TableHelperManager.destroy();                                                                                                                                                                                                                              
				instance.oTableHelper = null;                                                                                                                                                                                                                              
				instance = null;                                                                                                                                                                                                                                           
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		menuEntryIds: {                                                                                                                                                                                                                                              
			FioriOverview: "adeFioriOverview"                                                                                                                                                                                                                           
		}                                                                                                                                                                                                                                                            
	};                                                                                                                                                                                                                                                            
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               