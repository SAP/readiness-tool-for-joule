				if (oStatusItem.FieldType && oStatusItem.FieldType !== "I") {                                                                                                                                                                                              
					var oMenuEntry = sap.ui.getCore().byId(oStatusItem.IdLvl1 + "-menuItem");                                                                                                                                                                                 
					oMenuEntry.setIcon("sap-icon://status-error");                                                                                                                                                                                                            
					return;                                                                                                                                                                                                                                                   
				}                                                                                                                                                                                                                                                          
			});	                                                                                                                                                                                                                                                        
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Adds the status text to each system information item                                                                                                                                                                                                      
		 * @param{object}oStatusItem - System information item                                                                                                                                                                                                       
		 * @param{object}oResourceBundle - Ressource Bundle                                                                                                                                                                                                          
		 * @return{object} - System information item with status                                                                                                                                                                                                     
		 */                                                                                                                                                                                                                                                          
		setItemStatus: function(oStatusItem, oResourceBundle) {                                                                                                                                                                                                      
