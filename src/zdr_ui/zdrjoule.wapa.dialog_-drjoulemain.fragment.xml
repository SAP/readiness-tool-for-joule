<Dialog&nbsp;                                                                                                                                                                                                                                                  
	title="{i18n>plugin_title}"&nbsp;                                                                                                                                                                                                                             
	contentHeight="100%"&nbsp;                                                                                                                                                                                                                                    
	contentWidth="85%"&nbsp;                                                                                                                                                                                                                                      
	xmlns:mvc="sap.ui.core.mvc"&nbsp;                                                                                                                                                                                                                             
	xmlns:core="sap.ui.core"                                                                                                                                                                                                                                      
	xmlns="sap.m"&nbsp;                                                                                                                                                                                                                                           
	xmlns:html="http://www.w3.org/1999/xhtml"&nbsp;                                                                                                                                                                                                               
	xmlns:f="sap.f"&nbsp;                                                                                                                                                                                                                                         
	xmlns:l="sap.ui.layout"&nbsp;                                                                                                                                                                                                                                 
	xmlns:tnt="sap.tnt"                                                                                                                                                                                                                                           
	class="sapUshellUserSetting sapContrastPlus"                                                                                                                                                                                                                  
    showHeader="true"                                                                                                                                                                                                                                          
    stretch="{device>/system/phone}">                                                                                                                                                                                                                          
	<content>                                                                                                                                                                                                                                                     
		<mvc:XMLView&nbsp;                                                                                                                                                                                                                                           
			viewName="dr.joule.assistant.drjoule.dialog.DrJouleMain"&nbsp;                                                                                                                                                                                              
			height="100%"/>                                                                                                                                                                                                                                             
	</content>                                                                                                                                                                                                                                                    
	<buttons>                                                                                                                                                                                                                                                     
		<Button id="dr-joule-download-btn" text="{i18n>downloadBtnText}" icon="sap-icon://download" type="Emphasized"></Button>                                                                                                                                      
		<Button id="dr-joule-close-btn" text="{i18n>closeBtnText}"></Button>                                                                                                                                                                                         
	</buttons>                                                                                                                                                                                                                                                    
</Dialog>                                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               