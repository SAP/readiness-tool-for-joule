sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/base/Object"                                                                                                                                                                                                                                          
], function (Object) {                                                                                                                                                                                                                                         
	var instance;                                                                                                                                                                                                                                                 
	var TestSwitchHelper = Object.extend("dr.joule.assistant.drjoule.helper.TestSwitchHelper", {                                                                                                                                                                  
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Create helper                                                                                                                                                                                                                                             
		 * */                                                                                                                                                                                                                                                        
		constructor: function () {                                                                                                                                                                                                                                   
			this.testIsActive = false;&nbsp;                                                                                                                                                                                                                            
			this.isSandbox    = false;                                                                                                                                                                                                                                  
			this.isLimitedInformation = false;                                                                                                                                                                                                                          
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Sets the Switch if the program is executed in a test environment or not                                                                                                                                                                                   
		 *  @param{boolean}isTestActive - is the test mode activated                                                                                                                                                                                                 
		 * */                                                                                                                                                                                                                                                        
		setTestSwitch: function(isTestActive) {                                                                                                                                                                                                                      
			if (isTestActive && isTestActive === true) {                                                                                                                                                                                                                
				this.testIsActive = true;                                                                                                                                                                                                                                  
			} else {                                                                                                                                                                                                                                                    
				this.testIsActive = false;                                                                                                                                                                                                                                 
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Returns if the test switch is active or not                                                                                                                                                                                                               
		 *  @returns {boolean} test switch active                                                                                                                                                                                                                    
		 * */                                                                                                                                                                                                                                                        
		isTestSwitchActive: function() {                                                                                                                                                                                                                             
			//also consider sandbox in the same way                                                                                                                                                                                                                     
			if(this.isSandboxSwitchActive()) {                                                                                                                                                                                                                          
				this.testIsActive = true;                                                                                                                                                                                                                                  
			}                                                                                                                                                                                                                                                           
			return this.testIsActive;                                                                                                                                                                                                                                   
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Returns if the sandbox switch is active or not                                                                                                                                                                                                            
		 * @returns {boolean} sandbox switch active                                                                                                                                                                                                                  
		 * */                                                                                                                                                                                                                                                        
		 isSandboxSwitchActive: function(){                                                                                                                                                                                                                          
			if(sap && sap.ushell && sap.ushell.__sandbox__) {                                                                                                                                                                                                           
				this.isSandbox = true;                                                                                                                                                                                                                                     
			}                                                                                                                                                                                                                                                           
			return this.isSandbox;                                                                                                                                                                                                                                      
		 },                                                                                                                                                                                                                                                          
		&nbsp;                                                                                                                                                                                                                                                       
		 /**                                                                                                                                                                                                                                                         
		  * Set the switch to display limited information. This simulates restricted                                                                                                                                                                                 
		  * authorizations in the backend.                                                                                                                                                                                                                           
		  * @param {boolean} isLimitedInformation Limited information mode on or off.                                                                                                                                                                                
		  */                                                                                                                                                                                                                                                         
		 setLimitedInformationSwitch: function(isLimitedInformation) {                                                                                                                                                                                               
		 	if (isLimitedInformation && isLimitedInformation == true) {                                                                                                                                                                                                
		 		this.isLimitedInformation = true;                                                                                                                                                                                                                         
		 	} else {                                                                                                                                                                                                                                                   
		 		this.isLimitedInformation = false;                                                                                                                                                                                                                        
		 	}                                                                                                                                                                                                                                                          
		 },                                                                                                                                                                                                                                                          
		&nbsp;                                                                                                                                                                                                                                                       
		 /**                                                                                                                                                                                                                                                         
		  * Returns if the limmited information mode is active or not. This simulates restricted                                                                                                                                                                     
		  * authorizations in the backend.                                                                                                                                                                                                                           
		  * @returns {boolean} limited information mode on or off.                                                                                                                                                                                                   
		  */                                                                                                                                                                                                                                                         
		 isLimitedInformationSwitchActive: function() {                                                                                                                                                                                                              
		 	return this.isLimitedInformation;                                                                                                                                                                                                                          
		 }                                                                                                                                                                                                                                                           
	});                                                                                                                                                                                                                                                           
	                                                                                                                                                                                                                                                              
	return {                                                                                                                                                                                                                                                      
		getInstance: function () {                                                                                                                                                                                                                                   
			if (!instance) {                                                                                                                                                                                                                                            
				instance = new TestSwitchHelper();                                                                                                                                                                                                                         
			}                                                                                                                                                                                                                                                           
			return instance;                                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		destroy: function () {                                                                                                                                                                                                                                       
		if (instance) {                                                                                                                                                                                                                                              
				instance = null;                                                                                                                                                                                                                                           
			}                                                                                                                                                                                                                                                           
		}                                                                                                                                                                                                                                                            
	};                                                                                                                                                                                                                                                            
});                                                                                                                                                                                                                                                            