sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/base/Object",                                                                                                                                                                                                                                      
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/base/Log"                                                                                                                                                                                                                                             
], function (                                                                                                                                                                                                                                                  
    Object,                                                                                                                                                                                                                                                    
    MessageToast,                                                                                                                                                                                                                                              
    Log                                                                                                                                                                                                                                                        
) {                                                                                                                                                                                                                                                            
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var instance;                                                                                                                                                                                                                                              
    var SESSION_THREAD_ID = "drJouleTestingThreadId";                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
    var JouleWebClientHelper = Object.extend(                                                                                                                                                                                                                  
        "dr.joule.assistant.drjoule.helper.JouleWebClientHelper",                                                                                                                                                                                              
        {                                                                                                                                                                                                                                                      
            constructor: function () {                                                                                                                                                                                                                         
                this._oI18nModel = null;                                                                                                                                                                                                                       
                this._sThreadTitle = "Testing Standard Prompts with Readiness Inspection and Guidance Tool for Joule Scenarios";                                                                                                                               
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            initialize: function (oI18nModel) {                                                                                                                                                                                                                
                this._oI18nModel = oI18nModel;                                                                                                                                                                                                                 
                try {                                                                                                                                                                                                                                          
                    if (oI18nModel && oI18nModel.getResourceBundle) {                                                                                                                                                                                          
                        this._sThreadTitle = oI18nModel                                                                                                                                                                                                        
                            .getResourceBundle()                                                                                                                                                                                                               
                            .getText("jouleTestThreadTitle") || this._sThreadTitle;                                                                                                                                                                            
                    }                                                                                                                                                                                                                                          
                } catch (e) {                                                                                                                                                                                                                                  
                    Log.warning("Could not read jouleTestThreadTitle from i18n");                                                                                                                                                                              
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            /* =========================================================== */                                                                                                                                                                                  
            /* PUBLIC API                                                  */                                                                                                                                                                                  
            /* =========================================================== */                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // Condition 1: Check if global window object is initialized                                                                                                                                                                                       
            isAvailable: function () {                                                                                                                                                                                                                         
                return !!(                                                                                                                                                                                                                                     
                    window.sap &&                                                                                                                                                                                                                              
                    window.sap.das &&                                                                                                                                                                                                                          
                    window.sap.das.webclient                                                                                                                                                                                                                   
                );                                                                                                                                                                                                                                             
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Condition 1, 2, 3, 4, 5: Handles message submission and thread routing                                                                                                                                                                          
            sendPrompt: async function (sPrompt) {                                                                                                                                                                                                             
                try {                                                                                                                                                                                                                                          
                    // Condition 1: If not initialized, throw error/toast                                                                                                                                                                                      
                    if (!this.isAvailable()) {                                                                                                                                                                                                                 
                        this._showError("jouleErrorNotInitialized");                                                                                                                                                                                           
                        return;                                                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    if (!sPrompt) {                                                                                                                                                                                                                            
                        return;                                                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Condition 4: Make sure the main Joule window is open before executing prompt logic                                                                                                                                                      
                    this.show();                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                    // Condition 2 & 3: Find existing thread ID or create a fresh tracking sequence                                                                                                                                                            
                    var sThreadId = await this.getOrCreateTestingThread(sPrompt);                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                    // If it was a brand new thread created via getOrCreateTestingThread,&nbsp;                                                                                                                                                                
                    // it already dispatched the initial message with the custom title.                                                                                                                                                                        
                    // If it was an *existing* thread, we must explicitly send the prompt now.                                                                                                                                                                 
                    if (sThreadId && sThreadId !== "CREATED_NEW_WITH_PROMPT") {                                                                                                                                                                                
                        await window.sap.das.webclient.setActiveThread(sThreadId);                                                                                                                                                                             
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                               
                        window.sap.das.webclient.sendMessage(                                                                                                                                                                                                  
                            sPrompt,                                                                                                                                                                                                                           
                            sThreadId,                                                                                                                                                                                                                         
                            true                                                                                                                                                                                                                               
                        );                                                                                                                                                                                                                                     
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Fix 1: Explicit success notification after window animation fires                                                                                                                                                                       
                    this._showSuccessNotification();                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                } catch (e) {                                                                                                                                                                                                                                  
                    Log.error("sendPrompt failed", e && e.message);                                                                                                                                                                                            
                    this._showError("jouleErrorSendPrompt");                                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Wrapper utility if consumers explicitly want to drive window visibility + text simultaneously                                                                                                                                                   
            sendPromptAndShow: async function (sPrompt) {                                                                                                                                                                                                      
                await this.sendPrompt(sPrompt);                                                                                                                                                                                                                
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Condition 2, 3, 5, 6: State machine evaluating active session cache and server title indexes                                                                                                                                                    
            getOrCreateTestingThread: async function (sInitialPromptIfNew) {                                                                                                                                                                                   
                try {                                                                                                                                                                                                                                          
                    // Condition 5: Check session instance cache first (same tab/session context)                                                                                                                                                              
                    var sThreadId = sessionStorage.getItem(SESSION_THREAD_ID);                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    if (sThreadId) {                                                                                                                                                                                                                           
                        var bSelected = await window.sap.das.webclient.setActiveThread(sThreadId);                                                                                                                                                             
                        if (bSelected) {                                                                                                                                                                                                                       
                            return sThreadId;                                                                                                                                                                                                                  
                        }                                                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Condition 6 & Fix 2: Fresh session fallback. Fetch ONLY active threads by title string matches                                                                                                                                          
                    var aThreads = await this.getThreads();                                                                                                                                                                                                    
                    var oExistingThread = this._findLatestTestingThread(aThreads);                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                    if (oExistingThread) {                                                                                                                                                                                                                     
                        sessionStorage.setItem(SESSION_THREAD_ID, oExistingThread.thread_id);                                                                                                                                                                  
                        return oExistingThread.thread_id;                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Condition 2: If no thread matches locally or on the server, create it with the prompt and sticky title                                                                                                                                  
                    if (sInitialPromptIfNew) {                                                                                                                                                                                                                 
                        await this._createTestingThread(sInitialPromptIfNew);                                                                                                                                                                                  
                        return "CREATED_NEW_WITH_PROMPT";&nbsp;                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    return null;                                                                                                                                                                                                                               
                } catch (e) {                                                                                                                                                                                                                                  
                    Log.error("getOrCreateTestingThread failed", e && e.message);                                                                                                                                                                              
                    this._showError("jouleErrorCreateThread");                                                                                                                                                                                                 
                    throw e;                                                                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Forces creation of a thread completely isolated from session rules                                                                                                                                                                              
            startNewThread: async function (sInitialPrompt) {                                                                                                                                                                                                  
                return await this._createTestingThread(sInitialPrompt || "Hello");                                                                                                                                                                             
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Condition 9: Show/Focus the current active window thread&nbsp;                                                                                                                                                                                  
            showTestingConversation: async function () {                                                                                                                                                                                                       
                try {                                                                                                                                                                                                                                          
                    if (!this.isAvailable()) {                                                                                                                                                                                                                 
                        this._showError("jouleErrorNotInitialized");                                                                                                                                                                                           
                        return null;                                                                                                                                                                                                                           
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    this.show();                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                    // Looks up the thread via cache or title, without blindly creating an empty conversation                                                                                                                                                  
                    var sThreadId = await this.getOrCreateTestingThread();                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                    if (sThreadId && sThreadId !== "CREATED_NEW_WITH_PROMPT") {                                                                                                                                                                                
                        // setActiveThread shifts UI focus, highlights the list selection, and displays content historical state                                                                                                                               
                        await window.sap.das.webclient.setActiveThread(sThreadId);                                                                                                                                                                             
                        return sThreadId;                                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    return null;                                                                                                                                                                                                                               
                } catch (e) {                                                                                                                                                                                                                                  
                    Log.error("showTestingConversation failed", e && e.message);                                                                                                                                                                               
                    this._showError("jouleErrorShowConversation");                                                                                                                                                                                             
                    return null;                                                                                                                                                                                                                               
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            hasTestingThread: async function () {                                                                                                                                                                                                              
                var aThreads = await this.getThreads();                                                                                                                                                                                                        
                return !!this._findLatestTestingThread(aThreads);                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            getTestingThreadId: function () {                                                                                                                                                                                                                  
                return sessionStorage.getItem(SESSION_THREAD_ID);                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Condition 7: Cleans up both local session footprints and drops server conversation channels completely                                                                                                                                          
            deleteTestingThread: async function () {                                                                                                                                                                                                           
                try {                                                                                                                                                                                                                                          
                    if (!this.isAvailable()) {                                                                                                                                                                                                                 
                        return;                                                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    var aThreads = await this.getThreads();                                                                                                                                                                                                    
                    var aMatchingThreads = (aThreads || []).filter(                                                                                                                                                                                            
                        function (oThread) {                                                                                                                                                                                                                   
                            return oThread.title === this._sThreadTitle;                                                                                                                                                                                       
                        }.bind(this)                                                                                                                                                                                                                           
                    );                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                    for (var i = 0; i < aMatchingThreads.length; i++) {                                                                                                                                                                                        
                        await window.sap.das.webclient.deleteConversation(                                                                                                                                                                                     
                            aMatchingThreads[i].thread_id                                                                                                                                                                                                      
                        );                                                                                                                                                                                                                                     
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    this.clearSession();                                                                                                                                                                                                                       
                } catch (e) {                                                                                                                                                                                                                                  
                    Log.error("deleteTestingThread failed", e && e.message);                                                                                                                                                                                   
                    this._showError("jouleErrorDeleteThread");                                                                                                                                                                                                 
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            clearSession: function () {                                                                                                                                                                                                                        
                sessionStorage.removeItem(SESSION_THREAD_ID);                                                                                                                                                                                                  
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Condition 6: Web Client API passing title objects along with thread arrays                                                                                                                                                                      
            getThreads: async function () {                                                                                                                                                                                                                    
                try {                                                                                                                                                                                                                                          
                    if (!this.isAvailable()) {                                                                                                                                                                                                                 
                        return [];                                                                                                                                                                                                                             
                    }                                                                                                                                                                                                                                          
                    // Fix 2: Changed from false to true to only retrieve active conversations, preventing reuse of expired threads                                                                                                                            
                    return await window.sap.das.webclient.getThreads(true);                                                                                                                                                                                    
                } catch (e) {                                                                                                                                                                                                                                  
                    Log.error("getThreads failed", e && e.message);                                                                                                                                                                                            
                    return [];                                                                                                                                                                                                                                 
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            /* =========================================================== */                                                                                                                                                                                  
            /* SCENARIO AUTHORIZATION                                      */                                                                                                                                                                                  
            /* =========================================================== */                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            filterScenariosByAccess: async function (oScenarioPayload) {                                                                                                                                                                                       
                try {                                                                                                                                                                                                                                          
                    if (!this.isAvailable()) {                                                                                                                                                                                                                 
                        this._showError("jouleErrorNotInitialized");                                                                                                                                                                                           
                        return { scenarios: [] };                                                                                                                                                                                                              
                    }                                                                                                                                                                                                                                          
                    if (!oScenarioPayload || !oScenarioPayload.scenarios) {                                                                                                                                                                                    
                        return { scenarios: [] };                                                                                                                                                                                                              
                    }                                                                                                                                                                                                                                          
                    return await window.sap.das.webclient.filterScenariosByAccess(oScenarioPayload);                                                                                                                                                           
                } catch (e) {                                                                                                                                                                                                                                  
                    Log.error("filterScenariosByAccess failed", e && e.message);                                                                                                                                                                               
                    this._showError("jouleErrorFilterScenarios");                                                                                                                                                                                              
                    return { scenarios: [] };                                                                                                                                                                                                                  
                }                                                                                                                                                                                                                                              
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            filterScenarioArrayByAccess: async function (aScenarios) {                                                                                                                                                                                         
                var oResult = await this.filterScenariosByAccess({                                                                                                                                                                                             
                    scenarios: aScenarios || []                                                                                                                                                                                                                
                });                                                                                                                                                                                                                                            
                return (oResult && oResult.scenarios) || [];                                                                                                                                                                                                   
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            getAccessibleScenarioNames: async function (aScenarios) {                                                                                                                                                                                          
                var aFiltered = await this.filterScenarioArrayByAccess(aScenarios);                                                                                                                                                                            
                return aFiltered.map(function (oScenario) {                                                                                                                                                                                                    
                    return [                                                                                                                                                                                                                                   
                        oScenario.namespace,                                                                                                                                                                                                                   
                        oScenario.capability,                                                                                                                                                                                                                  
                        oScenario.name                                                                                                                                                                                                                         
                    ].join("|");                                                                                                                                                                                                                               
                });                                                                                                                                                                                                                                            
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            /* =========================================================== */                                                                                                                                                                                  
            /* CONDITION 8: SURFACE WINDOW WRAPPERS FROM THE NATIVE API     */                                                                                                                                                                                 
            /* =========================================================== */                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            show: function () {                                                                                                                                                                                                                                
                if (this.isAvailable()) { window.sap.das.webclient.show(); }                                                                                                                                                                                   
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            hide: function () {                                                                                                                                                                                                                                
                if (this.isAvailable()) { window.sap.das.webclient.hide(); }                                                                                                                                                                                   
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            toggle: function () {                                                                                                                                                                                                                              
                if (this.isAvailable()) { window.sap.das.webclient.toggle(); }                                                                                                                                                                                 
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            expand: function () {                                                                                                                                                                                                                              
                if (this.isAvailable()) { window.sap.das.webclient.expand(); }                                                                                                                                                                                 
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            collapse: function () {                                                                                                                                                                                                                            
                if (this.isAvailable()) { window.sap.das.webclient.collapse(); }                                                                                                                                                                               
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            toggleFullScreen: function () {                                                                                                                                                                                                                    
                if (this.isAvailable()) { window.sap.das.webclient.toggleFullScreen(); }                                                                                                                                                                       
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            openNavigationPanel: function () {                                                                                                                                                                                                                 
                if (this.isAvailable()) { window.sap.das.webclient.openNavigationPanel(); }                                                                                                                                                                    
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            closeNavigationPanel: function () {                                                                                                                                                                                                                
                if (this.isAvailable()) { window.sap.das.webclient.closeNavigationPanel(); }                                                                                                                                                                   
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            toggleNavigationPanel: function () {                                                                                                                                                                                                               
                if (this.isAvailable()) { window.sap.das.webclient.toggleNavigationPanel(); }                                                                                                                                                                  
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            showAssistantsSelection: function () {                                                                                                                                                                                                             
                if (this.isAvailable()) { window.sap.das.webclient.showAssistantsSelection(); }                                                                                                                                                                
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            openDebug: async function () {                                                                                                                                                                                                                     
                try {                                                                                                                                                                                                                                          
                    if (this.isAvailable()) { await window.sap.das.webclient.openDebug(); }                                                                                                                                                                    
                } catch (e) { this._showError("jouleErrorOpenDebug"); }                                                                                                                                                                                        
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            closeDebug: function () {                                                                                                                                                                                                                          
                if (this.isAvailable()) { window.sap.das.webclient.closeDebug(); }                                                                                                                                                                             
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            toggleDebug: async function () {                                                                                                                                                                                                                   
                try {                                                                                                                                                                                                                                          
                    if (this.isAvailable()) { await window.sap.das.webclient.toggleDebug(); }                                                                                                                                                                  
                } catch (e) { this._showError("jouleErrorOpenDebug"); }                                                                                                                                                                                        
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            /* =========================================================== */                                                                                                                                                                                  
            /* INTERNAL HELPERS                                            */                                                                                                                                                                                  
            /* =========================================================== */                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // Condition 2: Safely instantiate a thread with title and prompt bound together                                                                                                                                                                   
            _createTestingThread: async function (sInitialPrompt) {                                                                                                                                                                                            
                var oThread = await window.sap.das.webclient.newConversation(                                                                                                                                                                                  
                    sInitialPrompt,                                                                                                                                                                                                                            
                    this._sThreadTitle                                                                                                                                                                                                                         
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                if (!oThread || !oThread.thread_id) {                                                                                                                                                                                                          
                    throw new Error("Unable to create testing thread");                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                sessionStorage.setItem(SESSION_THREAD_ID, oThread.thread_id);                                                                                                                                                                                  
                return oThread.thread_id;                                                                                                                                                                                                                      
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            _findLatestTestingThread: function (aThreads) {                                                                                                                                                                                                    
                var aMatchingThreads = (aThreads || []).filter(                                                                                                                                                                                                
                    function (oThread) {                                                                                                                                                                                                                       
                        return oThread.title === this._sThreadTitle;                                                                                                                                                                                           
                    }.bind(this)                                                                                                                                                                                                                               
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                if (!aMatchingThreads.length) {                                                                                                                                                                                                                
                    return null;                                                                                                                                                                                                                               
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // Sorting to find the freshest thread instance matching the string title                                                                                                                                                                      
                aMatchingThreads.sort(function (a, b) {                                                                                                                                                                                                        
                    return (b.last_message_timestamp || 0) - (a.last_message_timestamp || 0);                                                                                                                                                                  
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                return aMatchingThreads[0];                                                                                                                                                                                                                    
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            _showSuccessNotification: function () {                                                                                                                                                                                                            
                var sText = "Prompt sent. Please verify the Joule window panel.";                                                                                                                                                                              
                try {                                                                                                                                                                                                                                          
                    if (this._oI18nModel && this._oI18nModel.getResourceBundle) {                                                                                                                                                                              
                        sText = this._oI18nModel.getResourceBundle().getText("joulePromptSentSuccess") || sText;                                                                                                                                               
                    }                                                                                                                                                                                                                                          
                } catch (e) { /* fallback string retained */ }                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                // Using a slight delay ensures the toast sits over everything after panel layouts stabilize                                                                                                                                                   
                setTimeout(function () {                                                                                                                                                                                                                       
                    MessageToast.show(sText, {                                                                                                                                                                                                                 
                        duration: 3500,                                                                                                                                                                                                                        
                        closeOnBrowserNavigation: false                                                                                                                                                                                                        
                    });                                                                                                                                                                                                                                        
                }, 150);                                                                                                                                                                                                                                       
            },                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            _showError: function (sI18nKey) {                                                                                                                                                                                                                  
                var sText = "Joule operation failed";                                                                                                                                                                                                          
                try {                                                                                                                                                                                                                                          
                    if (this._oI18nModel && this._oI18nModel.getResourceBundle) {                                                                                                                                                                              
                        sText = this._oI18nModel.getResourceBundle().getText(sI18nKey);                                                                                                                                                                        
                    }                                                                                                                                                                                                                                          
                } catch (e) { /* fallback string retained */ }                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                MessageToast.show(sText);                                                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
        }                                                                                                                                                                                                                                                      
    );                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    return {                                                                                                                                                                                                                                                   
        getInstance: function () {                                                                                                                                                                                                                             
            if (!instance) {                                                                                                                                                                                                                                   
                instance = new JouleWebClientHelper();                                                                                                                                                                                                         
            }                                                                                                                                                                                                                                                  
            return instance;                                                                                                                                                                                                                                   
        },                                                                                                                                                                                                                                                     
        destroy: function () {                                                                                                                                                                                                                                 
            instance = null;                                                                                                                                                                                                                                   
        }                                                                                                                                                                                                                                                      
    };                                                                                                                                                                                                                                                         
});                                                                                                                                                                                                                                                            