sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/base/Object",                                                                                                                                                                                                                                         
	"sap/base/Log",                                                                                                                                                                                                                                               
	"nw/core/flp/appdiagnostics/helper/LinkHelper"                                                                                                                                                                                                                
], function(BaseObject, Log, LinkHelper) {                                                                                                                                                                                                                     
	                                                                                                                                                                                                                                                              
	/**                                                                                                                                                                                                                                                           
	 * Link to SAP note for SAP UI5 pre-analysis.                                                                                                                                                                                                                 
	 */                                                                                                                                                                                                                                                           
	var UI5_SDK_TROUBLESHOOTING_LINK = LinkHelper.createSAPNoteLink("2235320");                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
	return BaseObject.extend("dr.joule.assistant.drjoule.ui5Information.Ui5LogProvider", {                                                                                                                                                                        
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Create a new instance of the UI5 information provider. This constructor loads and initializes                                                                                                                                                             
		 * all local information providers.                                                                                                                                                                                                                          
		 * @param {sap.base.i18n.ResourceBundle} i18nBundle - I18N resource bundle, e.g. provided from i18n model.                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		constructor: function(i18nBundle) {                                                                                                                                                                                                                          
			this._i18n = i18nBundle;                                                                                                                                                                                                                                    
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Get the ID of the information provider.                                                                                                                                                                                                                   
		 * @returns {string} Provider ID.                                                                                                                                                                                                                            
		 */                                                                                                                                                                                                                                                          
		getId: function() {                                                                                                                                                                                                                                          
			return "ui5log";                                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Get the name of the information provider to be shown on the UI.                                                                                                                                                                                           
		 * @returns {string} Provider name.                                                                                                                                                                                                                          
		 */                                                                                                                                                                                                                                                          
		getName: function() {                                                                                                                                                                                                                                        
			return this._i18n.getText("ui5log");                                                                                                                                                                                                                        
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Return if the information from this provider should be shown as a table or as a form.                                                                                                                                                                     
		 * @returns {boolean} Shown as a table (`true`) or as a form (`false`).                                                                                                                                                                                      
		 */                                                                                                                                                                                                                                                          
		isTable: function() {                                                                                                                                                                                                                                        
			return true;                                                                                                                                                                                                                                                
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Collect the information.                                                                                                                                                                                                                                  
		 * @returns {Promise<object>} Promise resolves with the data collected by this provider.                                                                                                                                                                     
		 */                                                                                                                                                                                                                                                          
		collect: function() {                                                                                                                                                                                                                                        
			/**                                                                                                                                                                                                                                                         
			 * Map the console log level to the internal message type representation.                                                                                                                                                                                   
			 *&nbsp;                                                                                                                                                                                                                                                    
			 * @param {sap.base.Log.Level} level - Log level                                                                                                                                                                                                            
			 * @returns {"I" | "W" | "E"} message type                                                                                                                                                                                                                  
			 */                                                                                                                                                                                                                                                         
			function mapLogLevel(level) {                                                                                                                                                                                                                               
				switch (level) {                                                                                                                                                                                                                                           
					case Log.Level.DEBUG:                                                                                                                                                                                                                                     
					case Log.Level.INFO:                                                                                                                                                                                                                                      
					case Log.Level.TRACE:                                                                                                                                                                                                                                     
						return "I";                                                                                                                                                                                                                                              
					case Log.Level.WARNING:                                                                                                                                                                                                                                   
						return "W";                                                                                                                                                                                                                                              
					default:                                                                                                                                                                                                                                                  
						return "E";                                                                                                                                                                                                                                              
				}                                                                                                                                                                                                                                                          
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			/**                                                                                                                                                                                                                                                         
			 * Map log entry into internal data structure.                                                                                                                                                                                                              
			 * @param {object} logEntry - UI5 log entry                                                                                                                                                                                                                 
			 * @returns {object} Internal data structure                                                                                                                                                                                                                
			 */                                                                                                                                                                                                                                                         
			function mapLogEntry(logEntry) {                                                                                                                                                                                                                            
				return {                                                                                                                                                                                                                                                   
					System: "Fiori",                                                                                                                                                                                                                                          
					Client: "",                                                                                                                                                                                                                                               
					Username: "",                                                                                                                                                                                                                                             
					Source: "UI5 Logging",                                                                                                                                                                                                                                    
					Type: mapLogLevel(logEntry.level),                                                                                                                                                                                                                        
					Date: new Date(logEntry.timestamp),                                                                                                                                                                                                                       
					Time: new Date(logEntry.timestamp),                                                                                                                                                                                                                       
					Context: "",                                                                                                                                                                                                                                              
					ErrorText: logEntry.message,                                                                                                                                                                                                                              
					MoreInfoLink: UI5_SDK_TROUBLESHOOTING_LINK                                                                                                                                                                                                                
				};                                                                                                                                                                                                                                                         
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			return new Promise(function(resolve, reject) {                                                                                                                                                                                                              
				setTimeout(function() {                                                                                                                                                                                                                                    
					try {                                                                                                                                                                                                                                                     
						resolve(Log.getLogEntries().map(mapLogEntry));                                                                                                                                                                                                           
					} catch (e) {                                                                                                                                                                                                                                             
						reject(e);                                                                                                                                                                                                                                               
					}                                                                                                                                                                                                                                                         
				}, 0);	                                                                                                                                                                                                                                                    
			});                                                                                                                                                                                                                                                         
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            