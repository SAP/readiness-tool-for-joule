sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/base/Object",                                                                                                                                                                                                                                         
	"sap/ui/model/json/JSONModel",                                                                                                                                                                                                                                
	"sap/ui/VersionInfo",                                                                                                                                                                                                                                         
	"./Ui5LogProvider",                                                                                                                                                                                                                                           
	"./MessageProvider",                                                                                                                                                                                                                                          
	"../helper/FileHelper"                                                                                                                                                                                                                                        
], function(BaseObject, JSONModel, VersionInfo, Ui5LogProvider, MessageProvider, FileHelper) {                                                                                                                                                                 
	var SAPUI5_INFO = "/sapui5";                                                                                                                                                                                                                                  
	var LIBRARIES_INFO = "/libraries";                                                                                                                                                                                                                            
	var LOADED_LIBRARIES_INFO = "/loadedLibraries";                                                                                                                                                                                                               
	var COMPATIBILITY_VERSIONS = "/compatibilityVersions";                                                                                                                                                                                                        
	var FORMAT_SETTINGS = "/formatSettings";                                                                                                                                                                                                                      
	                                                                                                                                                                                                                                                              
	return BaseObject.extend("dr.joule.assistant.drjoule.ui5Information.Ui5InformationProvider", {                                                                                                                                                                
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Create a new instance of the UI5 information provider. This constructor loads and initializes                                                                                                                                                             
		 * all local information providers.                                                                                                                                                                                                                          
		 * @param {sap.base.i18n.ResourceBundle} i18nBundle - I18N resource bundle, e.g. provided from i18n model.                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		constructor: function(i18nBundle) {                                                                                                                                                                                                                          
			if (!i18nBundle || typeof i18nBundle.getText !== "function" ) {                                                                                                                                                                                             
				//Resource bundle is required                                                                                                                                                                                                                              
				throw new Error("UI5 information provider requires a resource bundle instance");                                                                                                                                                                           
			}                                                                                                                                                                                                                                                           
			this._i18n = i18nBundle;                                                                                                                                                                                                                                    
			                                                                                                                                                                                                                                                            
			this._model = new JSONModel({                                                                                                                                                                                                                               
				enabled: false,                                                                                                                                                                                                                                            
				sapui5: [],                                                                                                                                                                                                                                                
				libraries: [],                                                                                                                                                                                                                                             
				providers: []                                                                                                                                                                                                                                              
			});                                                                                                                                                                                                                                                         
			                                                                                                                                                                                                                                                            
			// When new providers are created they must be added to this method call                                                                                                                                                                                    
			this._loadProviders(Ui5LogProvider, MessageProvider);                                                                                                                                                                                                       
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		setEnabled: function(bEnabled) {                                                                                                                                                                                                                             
			this._model.setProperty("/enabled", Boolean(bEnabled));                                                                                                                                                                                                     
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		getProviders: function() {                                                                                                                                                                                                                                   
			return this._model.getProperty("/providers");	                                                                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Load information providers.                                                                                                                                                                                                                               
		 *&nbsp;                                                                                                                                                                                                                                                     
		 * @param {object[]} provider - Provider classes.                                                                                                                                                                                                            
		 */                                                                                                                                                                                                                                                          
		_loadProviders: function() {                                                                                                                                                                                                                                 
			var aProviders = [];                                                                                                                                                                                                                                        
			for (var index = 0; index < arguments.length; index++) {                                                                                                                                                                                                    
				var provider = new arguments[index](this._i18n);                                                                                                                                                                                                           
				aProviders.push({                                                                                                                                                                                                                                          
					id: provider.getId(),                                                                                                                                                                                                                                     
					name: provider.getName(),                                                                                                                                                                                                                                 
					table: provider.isTable()                                                                                                                                                                                                                                 
				});                                                                                                                                                                                                                                                        
				//Initialize model with empty data                                                                                                                                                                                                                         
				this._model.setProperty("/" + provider.getId(), provider.isTable() ? [] : {});                                                                                                                                                                             
				//Start collecting data                                                                                                                                                                                                                                    
				provider.collect().then(function(currentProvider, data) { this._model.setProperty("/" + currentProvider.getId(), data); }.bind(this, provider));                                                                                                           
			}                                                                                                                                                                                                                                                           
			this._model.setProperty("/providers", aProviders);                                                                                                                                                                                                          
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Get the model instance containing the collected UI5 information.                                                                                                                                                                                          
		 *&nbsp;                                                                                                                                                                                                                                                     
		 * @returns {sap.ui.model.Model} UI5 information model.                                                                                                                                                                                                      
		 */                                                                                                                                                                                                                                                          
		getModel: function() {                                                                                                                                                                                                                                       
			return this._model;                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Start collecting information. Information collection is done asynchronously.                                                                                                                                                                              
		 *&nbsp;                                                                                                                                                                                                                                                     
		 * @returns {Promise<void>} Promise resolves when information collection is finished.                                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		initialize: function() {                                                                                                                                                                                                                                     
			if (!this._initializePromise) {                                                                                                                                                                                                                             
				this._initializePromise = new Promise(function(resolve, reject) {                                                                                                                                                                                          
					setTimeout(function () {                                                                                                                                                                                                                                  
						try {                                                                                                                                                                                                                                                    
							this._collectUi5Information();                                                                                                                                                                                                                          
							resolve();                                                                                                                                                                                                                                              
						} catch (e) {                                                                                                                                                                                                                                            
							reject(e);                                                                                                                                                                                                                                              
						}                                                                                                                                                                                                                                                        
					}.bind(this), 0);                                                                                                                                                                                                                                         
				}.bind(this));                                                                                                                                                                                                                                             
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			return this._initializePromise;                                                                                                                                                                                                                             
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Collect support information from UI5.                                                                                                                                                                                                                     
		 */                                                                                                                                                                                                                                                          
		_collectUi5Information: function() {                                                                                                                                                                                                                         
			                                                                                                                                                                                                                                                            
			this._collectBasicInformation();                                                                                                                                                                                                                            
			this._collectLoadedLibraryVersions();                                                                                                                                                                                                                       
			this._collectAvailableLibraryVersions();                                                                                                                                                                                                                    
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Read compatibility versions.                                                                                                                                                                                                                              
		 *&nbsp;                                                                                                                                                                                                                                                     
		 * @param {sap.ui.core.Configuration} oConfig - UI5 configuration                                                                                                                                                                                            
		 * @see https://sapui5.hana.ondemand.com/sdk/#/topic/9feb96da02c2429bb1afcf6534d77c79                                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		_getCompatibilityVersions: function(oConfig) {                                                                                                                                                                                                               
			var aKnownCompatibilityFeatures = [                                                                                                                                                                                                                         
				"data-sap-ui-compatVersion-sapMeTabContainer",                                                                                                                                                                                                             
				"data-sap-ui-compatVersion-sapMeProgessIndicator",                                                                                                                                                                                                         
				"data-sap-ui-compatVersion-sapMGrowingList",                                                                                                                                                                                                               
				"data-sap-ui-compatVersion-sapMListAsTable",                                                                                                                                                                                                               
				"data-sap-ui-compatVersion-sapMDialogWithPadding",                                                                                                                                                                                                         
				"data-sap-ui-bindingSyntax"                                                                                                                                                                                                                                
			];                                                                                                                                                                                                                                                          
			var aCompatibilityVersions = aKnownCompatibilityFeatures.map(function (sFeature) {                                                                                                                                                                          
				return {                                                                                                                                                                                                                                                   
					key: sFeature.replaceAll("-", ""), // dashes are not allowed in control IDs                                                                                                                                                                               
					title: sFeature.substring(sFeature.lastIndexOf("-") + 1),                                                                                                                                                                                                 
					value: oConfig.getCompatibilityVersion(sFeature).toString()                                                                                                                                                                                               
				};                                                                                                                                                                                                                                                         
			});                                                                                                                                                                                                                                                         
			this.getModel().setProperty(COMPATIBILITY_VERSIONS, aCompatibilityVersions);                                                                                                                                                                                
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Collect basic information from UI5 configuration.                                                                                                                                                                                                         
		 */                                                                                                                                                                                                                                                          
		_collectBasicInformation: function() {                                                                                                                                                                                                                       
			var oConfig = sap.ui.getCore().getConfiguration();                                                                                                                                                                                                          
			                                                                                                                                                                                                                                                            
			var aConfig = [                                                                                                                                                                                                                                             
				{                                                                                                                                                                                                                                                          
					key: "language",                                                                                                                                                                                                                                          
					title: this._i18n.getText("language"),                                                                                                                                                                                                                    
					value: oConfig.getLanguage()                                                                                                                                                                                                                              
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "locale",                                                                                                                                                                                                                                            
					title: this._i18n.getText("locale"),                                                                                                                                                                                                                      
					value: oConfig.getLocale()                                                                                                                                                                                                                                
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "timezone",                                                                                                                                                                                                                                          
					title: this._i18n.getText("timezone"),                                                                                                                                                                                                                    
					value: typeof oConfig.getTimezone === "function" ? oConfig.getTimezone() : ""                                                                                                                                                                             
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "terminologies",                                                                                                                                                                                                                                     
					title: this._i18n.getText("activeTerminologies"),                                                                                                                                                                                                         
					value: oConfig.getActiveTerminologies() ? oConfig.getActiveTerminologies().join(", ") : this._i18n.getText("none")                                                                                                                                        
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "debug",                                                                                                                                                                                                                                             
					title: this._i18n.getText("debugEnabled"),                                                                                                                                                                                                                
					value: Boolean(oConfig.getDebug()).toString()                                                                                                                                                                                                             
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "fioriAdaptation",                                                                                                                                                                                                                                   
					title: this._i18n.getText("fioriAdaptation"),                                                                                                                                                                                                             
					value: oConfig.getFiori2Adaptation()                                                                                                                                                                                                                      
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					// The SAPUI5 version is loaded asynchronously and added to this                                                                                                                                                                                          
					// array at a later point in time. To ensure that both versions                                                                                                                                                                                           
					// are presented next to each other, this object must be the last                                                                                                                                                                                         
					// in the array returned from this method.                                                                                                                                                                                                                
					key: "openui5version",                                                                                                                                                                                                                                    
					title: this._i18n.getText("openui5Version"),                                                                                                                                                                                                              
					value: oConfig.getVersion().toString()                                                                                                                                                                                                                    
				}                                                                                                                                                                                                                                                          
			];                                                                                                                                                                                                                                                          
			this.getModel().setProperty(SAPUI5_INFO, aConfig);                                                                                                                                                                                                          
			this._getCompatibilityVersions(oConfig);                                                                                                                                                                                                                    
			this._getFormatOptions(oConfig);                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		_getFormatOptions: function(oConfig) {                                                                                                                                                                                                                       
			var oFormatSettings = oConfig.getFormatSettings();                                                                                                                                                                                                          
			                                                                                                                                                                                                                                                            
			var aFormatSettings = [                                                                                                                                                                                                                                     
				{                                                                                                                                                                                                                                                          
					key: "decimalSeparator",                                                                                                                                                                                                                                  
					title: this._i18n.getText("decimalSeparator"),                                                                                                                                                                                                            
					value: oFormatSettings.getNumberSymbol("decimal")                                                                                                                                                                                                         
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "groupingSeparator",                                                                                                                                                                                                                                 
					title: this._i18n.getText("groupingSeparator"),                                                                                                                                                                                                           
					value: oFormatSettings.getNumberSymbol("group")                                                                                                                                                                                                           
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "datePattern",                                                                                                                                                                                                                                       
					title: this._i18n.getText("datePattern"),                                                                                                                                                                                                                 
					value: oFormatSettings.getDatePattern("short") //medium, long                                                                                                                                                                                             
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "timePattern",                                                                                                                                                                                                                                       
					title: this._i18n.getText("timePattern"),                                                                                                                                                                                                                 
					value: oFormatSettings.getTimePattern("short")                                                                                                                                                                                                            
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "legacyDateFormat",                                                                                                                                                                                                                                  
					title: this._i18n.getText("legacyDateFormat"),                                                                                                                                                                                                            
					value: oFormatSettings.getLegacyDateFormat()                                                                                                                                                                                                              
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "legacyTimeFormat",                                                                                                                                                                                                                                  
					title: this._i18n.getText("legacyTimeFormat"),                                                                                                                                                                                                            
					value: oFormatSettings.getLegacyTimeFormat()                                                                                                                                                                                                              
				},                                                                                                                                                                                                                                                         
				{                                                                                                                                                                                                                                                          
					key: "legacyNumberFormat",                                                                                                                                                                                                                                
					title: this._i18n.getText("legacyNumberFormat"),                                                                                                                                                                                                          
					value: oFormatSettings.getLegacyNumberFormat()                                                                                                                                                                                                            
				}                                                                                                                                                                                                                                                          
			];                                                                                                                                                                                                                                                          
			this.getModel().setProperty(FORMAT_SETTINGS, aFormatSettings);                                                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Collect versions of loaded libraries.                                                                                                                                                                                                                     
		 */                                                                                                                                                                                                                                                          
		_collectLoadedLibraryVersions: function() {                                                                                                                                                                                                                  
			var mLoadedLibraries = sap.ui.getCore().getLoadedLibraries();                                                                                                                                                                                               
			var aLoadedLibraries = Object.entries(mLoadedLibraries).map(function(aEntry) {                                                                                                                                                                              
				return {                                                                                                                                                                                                                                                   
					key: aEntry[0],                                                                                                                                                                                                                                           
					title: aEntry[1].name,                                                                                                                                                                                                                                    
					value: aEntry[1].version                                                                                                                                                                                                                                  
				};                                                                                                                                                                                                                                                         
			});                                                                                                                                                                                                                                                         
			this.getModel().setProperty(LOADED_LIBRARIES_INFO, aLoadedLibraries);                                                                                                                                                                                       
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Collect versions of all libraries available from the UI5 framework, including the                                                                                                                                                                         
		 * core framework version. This method processes the information asynchronously.                                                                                                                                                                             
		 */                                                                                                                                                                                                                                                          
		_collectAvailableLibraryVersions: function() {                                                                                                                                                                                                               
			VersionInfo.load().then(function(oVersionInfo) {                                                                                                                                                                                                            
				//SAPUI5 version is added to information read in _collectBasicInformation()                                                                                                                                                                                
				var aExistingConfig = this.getModel().getProperty(SAPUI5_INFO);                                                                                                                                                                                            
				aExistingConfig.push({                                                                                                                                                                                                                                     
					key: "sapui5version",                                                                                                                                                                                                                                     
					title: this._i18n.getText("sapui5Version"),                                                                                                                                                                                                               
					value: oVersionInfo.version                                                                                                                                                                                                                               
				});                                                                                                                                                                                                                                                        
				this.getModel().setProperty(SAPUI5_INFO, aExistingConfig);                                                                                                                                                                                                 
				                                                                                                                                                                                                                                                           
				//Other library versions are stored separately                                                                                                                                                                                                             
				this.getModel().setProperty(LIBRARIES_INFO, oVersionInfo.libraries.map(function(library) {                                                                                                                                                                 
					return {                                                                                                                                                                                                                                                  
						key: library.name,                                                                                                                                                                                                                                       
						title: library.name,                                                                                                                                                                                                                                     
						value: library.version                                                                                                                                                                                                                                   
					};                                                                                                                                                                                                                                                        
				}));                                                                                                                                                                                                                                                       
			}.bind(this));                                                                                                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Generate download file. The generated URL should be released to free consumed memory by                                                                                                                                                                   
		 * calling `URL.revokeObjectURL(url)`.                                                                                                                                                                                                                       
		 * @returns {Promise<URL>} Data URL with the generated download file.                                                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		generateDownload: function() {                                                                                                                                                                                                                               
			return this.initialize().then(function() {                                                                                                                                                                                                                  
				var downloadFilePromise = this._createDownloadFile(true);                                                                                                                                                                                                  
				return downloadFilePromise.then(function(file) { return URL.createObjectURL(file); });                                                                                                                                                                     
			}.bind(this));                                                                                                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Create a download file.                                                                                                                                                                                                                                   
		 * @param {boolean} compress - Enable compression of the file (of available)                                                                                                                                                                                 
		 * @returns {Promise<File>} File containing log data.                                                                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		_createDownloadFile: function(compress) {                                                                                                                                                                                                                    
			var data = this.getModel().getJSON();                                                                                                                                                                                                                       
			if (compress && FileHelper.isCompressionAvailable()) {                                                                                                                                                                                                      
				return FileHelper.gzip(data, "fioriLogs.json.gz");                                                                                                                                                                                                         
			} else {                                                                                                                                                                                                                                                    
				return FileHelper.raw(data, "fioriLogs.json", "application/json");                                                                                                                                                                                         
			}                                                                                                                                                                                                                                                           
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
});                                                                                                                                                                                                                                                            