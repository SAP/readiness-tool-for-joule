sap.ui.define(["sap/base/Log"], function(Log) {                                                                                                                                                                                                                
	return {                                                                                                                                                                                                                                                      
		/**                                                                                                                                                                                                                                                          
		 * Check if compression is available in the browser.                                                                                                                                                                                                         
		 * @returns {boolean} `true` if compression is available, `false` otherwise.                                                                                                                                                                                 
		 */                                                                                                                                                                                                                                                          
		isCompressionAvailable: function() {                                                                                                                                                                                                                         
			return ("CompressionStream" in window);                                                                                                                                                                                                                     
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Generate a gzip-compressed file.                                                                                                                                                                                                                          
		 * @param {string | ReadableStream | Blob} data Data to be compressed.                                                                                                                                                                                       
		 * @param {string} fileName Name of the generated file. Default: `data.gz`                                                                                                                                                                                   
		 * @returns {Promise<File>} Promise that resolves with the generated file object.                                                                                                                                                                            
		 */                                                                                                                                                                                                                                                          
		gzip: function(data, fileName) {                                                                                                                                                                                                                             
			if (!this.isCompressionAvailable()) {                                                                                                                                                                                                                       
				Log.error("Compression requested but not available in the current environment");                                                                                                                                                                           
				throw new Error("Compression is not available in the current environment");                                                                                                                                                                                
			}                                                                                                                                                                                                                                                           
			var compressedData = new Response(data).body.pipeThrough(new CompressionStream("gzip"));                                                                                                                                                                    
			return this._createFile(compressedData, fileName || "data.gz", "application/gzip");                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Generate a file.                                                                                                                                                                                                                                          
		 * @param {string | Blob} data Data to be written to the file.                                                                                                                                                                                               
		 * @param {string} fileName Name of the generated file.                                                                                                                                                                                                      
		 * @param {string} mimeType MIME type of the generated file. Default: "application/octet-stream".                                                                                                                                                            
		 * @returns {Promise<File>} Promise that resolves with the generated file object.                                                                                                                                                                            
		 */                                                                                                                                                                                                                                                          
		raw: function(data, fileName, mimeType) {                                                                                                                                                                                                                    
			return Promise.resolve(new File([data], fileName, {type: mimeType || "application/octet-stream"}));                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**                                                                                                                                                                                                                                                          
		 * Create a file from a stream.                                                                                                                                                                                                                              
		 * @param {ReadableStream} stream Input stream.                                                                                                                                                                                                              
		 * @param {string} fileName File name of the generated file.                                                                                                                                                                                                 
		 * @param {string} mimeType MIME type of the generated file.                                                                                                                                                                                                 
		 * @returns {Promise<File>} Promise that resolves with the generated file object.                                                                                                                                                                            
		 */                                                                                                                                                                                                                                                          
		_createFile: function(stream, fileName, mimeType) {                                                                                                                                                                                                          
			return new Response(stream).blob().then(function(content) {&nbsp;                                                                                                                                                                                           
				return new File([content], fileName, {type: mimeType});                                                                                                                                                                                                    
			});                                                                                                                                                                                                                                                         
		}                                                                                                                                                                                                                                                            
	};                                                                                                                                                                                                                                                            
});                                                                                                                                                                                                                                                            