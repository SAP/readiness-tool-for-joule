sap.ui.define([                                                                                                                                                                                                                                                
    "sap/m/RatingIndicator",                                                                                                                                                                                                                                   
    "sap/m/RatingIndicatorRenderer",                                                                                                                                                                                                                           
    "sap/ui/core/library"                                                                                                                                                                                                                                      
], function (RatingIndicator, RatingIndicatorRenderer, coreLibrary) {                                                                                                                                                                                          
    "use strict";                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
    var ValueState = coreLibrary.ValueState;                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
    // CSS class applied to the root element per state                                                                                                                                                                                                         
    var mStateClass = {                                                                                                                                                                                                                                        
        "Success": "drjRatingSuccess",                                                                                                                                                                                                                         
        "Warning": "drjRatingWarning",                                                                                                                                                                                                                         
        "Error":   "drjRatingError",                                                                                                                                                                                                                           
        "None":    "drjRatingNone"                                                                                                                                                                                                                             
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    return RatingIndicator.extend("dr.joule.assistant.drjoule.control.RatingIndicatorDrJoule", {                                                                                                                                                               
                                                                                                                                                                                                                                                               
        metadata: {                                                                                                                                                                                                                                            
            properties: {                                                                                                                                                                                                                                      
                valueState: {                                                                                                                                                                                                                                  
                    type: "sap.ui.core.ValueState",                                                                                                                                                                                                            
                    group: "Appearance",                                                                                                                                                                                                                       
                    defaultValue: ValueState.Warning                                                                                                                                                                                                           
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Explicitly reuse the parent renderer — prevents UI5 from looking for                                                                                                                                                                                
        // a sibling RatingIndicatorDrJouleRenderer.js file that doesn't exist.                                                                                                                                                                                
        renderer: RatingIndicatorRenderer,                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onAfterRendering: function () {                                                                                                                                                                                                                        
            RatingIndicator.prototype.onAfterRendering.apply(this, arguments);                                                                                                                                                                                 
            this._applyStateClass();                                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        setValueState: function (sValueState) {                                                                                                                                                                                                                
            this.setProperty("valueState", sValueState, true);                                                                                                                                                                                                 
            this._applyStateClass();                                                                                                                                                                                                                           
            return this;                                                                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _applyStateClass: function () {                                                                                                                                                                                                                        
            var $root = this.$();                                                                                                                                                                                                                              
            if (!$root.length) { return; }                                                                                                                                                                                                                     
            Object.values(mStateClass).forEach(function (sCls) {                                                                                                                                                                                               
                $root.removeClass(sCls);                                                                                                                                                                                                                       
            });                                                                                                                                                                                                                                                
            $root.addClass(mStateClass[this.getValueState()] || mStateClass["None"]);                                                                                                                                                                          
        }                                                                                                                                                                                                                                                      
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               