<core:FragmentDefinition                                                                                                                                                                                                                                       
	xmlns="sap.m"                                                                                                                                                                                                                                                 
	xmlns:core="sap.ui.core">                                                                                                                                                                                                                                     
	<SelectDialog                                                                                                                                                                                                                                                 
		id="selectUserDialog"                                                                                                                                                                                                                                        
		noDataText="{i18n>dialogNoData}"                                                                                                                                                                                                                             
		title="{i18n>dialogTitle}"                                                                                                                                                                                                                                   
		rememberSelections="true"                                                                                                                                                                                                                                    
		search=".onSearchUser"                                                                                                                                                                                                                                       
		confirm=".onSwitchUserContextDialogClose"                                                                                                                                                                                                                    
		cancel=".onSwitchUserContextDialogClose"                                                                                                                                                                                                                     
		items="{path: 'capabilitiesModel>/Users'}">                                                                                                                                                                                                                  
		<StandardListItem                                                                                                                                                                                                                                            
			id="userListItem"                                                                                                                                                                                                                                           
			title="{capabilitiesModel>UserName}"                                                                                                                                                                                                                        
			description="{capabilitiesModel>FirstName} {capabilitiesModel>LastName}"                                                                                                                                                                                    
			info="{capabilitiesModel>EmailAddress}"                                                                                                                                                                                                                     
			type="Active" />                                                                                                                                                                                                                                            
	</SelectDialog>                                                                                                                                                                                                                                               
</core:FragmentDefinition>                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               