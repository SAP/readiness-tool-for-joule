		 * @param{object}oEvent - Event of the toolbar button                                                                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		handleSortButtonPressed: function(oEvent) {                                                                                                                                                                                                                  
			this.openViewSettingsDialog(oEvent, "sort");                                                                                                                                                                                                                
