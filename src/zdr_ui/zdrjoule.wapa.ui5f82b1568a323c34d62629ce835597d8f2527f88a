sap.ui.define([                                                                                                                                                                                                                                                
	"sap/ui/base/Object",                                                                                                                                                                                                                                         
	"sap/ui/model/json/JSONModel",                                                                                                                                                                                                                                
	"nw/core/flp/appdiagnostics/formatter/Formatter",                                                                                                                                                                                                             
	"sap/m/TablePersoController",                                                                                                                                                                                                                                 
	"sap/ui/model/Filter",                                                                                                                                                                                                                                        
	"sap/ui/model/FilterOperator",                                                                                                                                                                                                                                
	"nw/core/flp/appdiagnostics/helper/LogUserHelper",                                                                                                                                                                                                            
	"sap/ui/model/Sorter"                                                                                                                                                                                                                                         
], function (Object, JSONModel, Formatter, TablePersoController, Filter, FilterOperator, LogUserHelper) {                                                                                                                                                      
	"use strict";                                                                                                                                                                                                                                                 
	var instance;                                                                                                                                                                                                                                                 
	var TableHelper = Object.extend("dr.joule.assistant.drjoule.helper.TableHelper", {                                                                                                                                                                            
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Create helper                                                                                                                                                                                                                                             
		 * */                                                                                                                                                                                                                                                        
		constructor: function () {                                                                                                                                                                                                                                   
			this._mViewSettingsDialogs = [];                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Initialize helper with required data                                                                                                                                                                                                                      
		 *  @param{object}oViewHelper - object of ViewHelper.js                                                                                                                                                                                                      
		 *  @param{object}oI18n - i18n model for the app                                                                                                                                                                                                             
		 *  @param{object}oFormatter - object of Formatter.js                                                                                                                                                                                                        
		 *  @param{object}oServiceModel - Service Model                                                                                                                                                                                                              
		 * */                                                                                                                                                                                                                                                        
		initialize: function (oViewHelper, oI18n, oFormatter) {                                                                                                                                                                                                      
			this._oViewHelper = oViewHelper;                                                                                                                                                                                                                            
			this._oI18n = oI18n;                                                                                                                                                                                                                                        
			this.Formatter = oFormatter;                                                                                                                                                                                                                                
			// saves the last correct item binding of the log tables                                                                                                                                                                                                    
			// required to make a prober change of usernames                                                                                                                                                                                                            
			this.itemBindingBuffer = [];                                                                                                                                                                                                                                
			                                                                                                                                                                                                                                                            
			//initialize user model for binding the other user field in table header                                                                                                                                                                                    
			this.oUserModel = new sap.ui.model.json.JSONModel({                                                                                                                                                                                                         
				userName: "", //user in the UI input                                                                                                                                                                                                                       
				loggedInUser: "", //user which is currently logged in (default)                                                                                                                                                                                            
				userList: [],                                                                                                                                                                                                                                              
				userListInputID: "",                                                                                                                                                                                                                                       
				userFilterSet: false                                                                                                                                                                                                                                       
			});                                                                                                                                                                                                                                                         
			                                                                                                                                                                                                                                                            
			//when launched in a productive environment the username is defaulted to the system user                                                                                                                                                                    
			//for showing the logs                                                                                                                                                                                                                                      
			var that = this;                                                                                                                                                                                                                                            
			if (sap.ushell && sap.ushell.Container) {                                                                                                                                                                                                                   
				sap.ushell.Container.getServiceAsync("UserInfo").then(function(userService) {                                                                                                                                                                              
					if (userService.getId() !== "DEFAULT_USER") {                                                                                                                                                                                                             
						that.oUserModel.setProperty("/userName",  userService.getId());                                                                                                                                                                                          
						that.oUserModel.setProperty("/loggedInUser",  userService.getId());                                                                                                                                                                                      
						                                                                                                                                                                                                                                                         
						//Set the user name for downloading the logs                                                                                                                                                                                                             
						var oLogUserHelper = LogUserHelper.getInstance();                                                                                                                                                                                                        
						oLogUserHelper.setLogUser(userService.getId());                                                                                                                                                                                                          
					}                                                                                                                                                                                                                                                         
				});                                                                                                                                                                                                                                                        
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			this._oViewHelper.oServiceModel.read("/UserlistSet", {                                                                                                                                                                                                      
				filters: [ new Filter("Fullname", FilterOperator.Contains, "") ],                                                                                                                                                                                          
				success: function (results, error) {                                                                                                                                                                                                                       
					//check results                                                                                                                                                                                                                                           
					if (results) {                                                                                                                                                                                                                                            
						this.oUserModel.setProperty("/userList", results.results);                                                                                                                                                                                               
					}                                                                                                                                                                                                                                                         
				}.bind(this)                                                                                                                                                                                                                                               
			});                                                                                                                                                                                                                                                         
			                                                                                                                                                                                                                                                            
			                                                                                                                                                                                                                                                            
			this.oUserModel.setDefaultBindingMode(sap.ui.model.BindingMode.TwoWay);                                                                                                                                                                                     
			//initialize table map                                                                                                                                                                                                                                      
			this._mTables = [];                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Creates the dialog for handling sorting, filter options in log tables                                                                                                                                                                                     
		 * @param{string}sDialogFragmentName - Name of the dialog fragment                                                                                                                                                                                           
		 * @param{string}sTableId - Name of the dialog fragment                                                                                                                                                                                                      
		 * @returns{object}oDialog - Dialog fragment object                                                                                                                                                                                                          
		 */                                                                                                                                                                                                                                                          
		createViewSettingsDialog: function (sDialogFragmentName, sTableId) {                                                                                                                                                                                         
			var oDialog = this._mViewSettingsDialogs[sDialogFragmentName + sTableId];                                                                                                                                                                                   
			if (!oDialog) {                                                                                                                                                                                                                                             
				oDialog = sap.ui.xmlfragment(sTableId, sDialogFragmentName, this);                                                                                                                                                                                         
				this._mViewSettingsDialogs[sDialogFragmentName + sTableId] = oDialog;                                                                                                                                                                                      
				oDialog.setModel(this._oI18n, "i18n");                                                                                                                                                                                                                     
				oDialog.addStyleClass("sapUiSizeCompact");                                                                                                                                                                                                                 
			}                                                                                                                                                                                                                                                           
			return oDialog;                                                                                                                                                                                                                                             
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
	     * Handles press event of LinkToLog button in toolbar                                                                                                                                                                                                     
	     * @param{object}oEvent - Event of the toolbar button                                                                                                                                                                                                     
	     */                                                                                                                                                                                                                                                       
        handleLinkToLogButtonPressed: function (oEvent) {                                                                                                                                                                                                      
            //parent button->toolbar->table                                                                                                                                                                                                                    
            sap.m.URLHelper.redirect(oEvent.getSource().data("LinkToLog"), true);                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Reacts on change user event of button in toolbar                                                                                                                                                                                                          
		 * and updates all tables                                                                                                                                                                                                                                    
		 * @param{object}oEvent - Event of the toolbar button                                                                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		onApplyUser: function (oEvent) {                                                                                                                                                                                                                             
			var that = this;                                                                                                                                                                                                                                            
			var sUserName = this.oUserModel.getData().userName;                                                                                                                                                                                                         
			                                                                                                                                                                                                                                                            
			//Set the user name for downloading the logs                                                                                                                                                                                                                
			var oLogUserHelper = LogUserHelper.getInstance();                                                                                                                                                                                                           
			oLogUserHelper.setLogUser(sUserName);                                                                                                                                                                                                                       
			                                                                                                                                                                                                                                                            
			this._oViewHelper.switchUser(sUserName);                                                                                                                                                                                                                    
			this._mTables.forEach(function (oMap) {                                                                                                                                                                                                                     
				//update the service url with the new user name if the username can be changed, or the typed in username                                                                                                                                                   
				//is the currently logged in user                                                                                                                                                                                                                          
				if (sap.ui.getCore().byId(oMap.table.getParent().getId() + "--ade-user-input") ||                                                                                                                                                                          
					that.oUserModel.getProperty("/loggedInUser") === sUserName) {                                                                                                                                                                                             
					                                                                                                                                                                                                                                                          
					//Add the item binding to the buffer if empty                                                                                                                                                                                                             
					if (!that.itemBindingBuffer[ oMap.table.getParent().getId() ]) {                                                                                                                                                                                          
						that.itemBindingBuffer[ oMap.table.getParent().getId() ] = oMap.table.getBindingPath("items");                                                                                                                                                           
					}                                                                                                                                                                                                                                                         
					                                                                                                                                                                                                                                                          
					                                                                                                                                                                                                                                                          
					var sBinding = that.itemBindingBuffer[ oMap.table.getParent().getId() ];                                                                                                                                                                                  
					var oListItem = sap.ui.xmlfragment("nw.core.flp.appdiagnostics.fragments.LogItem", that);                                                                                                                                                                 
					oMap.table.bindItems(that.changeBindingToUser(sBinding, sUserName), oListItem);                                                                                                                                                                           
				} else {                                                                                                                                                                                                                                                   
					//Save the item binding                                                                                                                                                                                                                                   
					if (oMap.table.getBindingPath("items")) {                                                                                                                                                                                                                 
						that.itemBindingBuffer[ oMap.table.getParent().getId() ] = oMap.table.getBindingPath("items");                                                                                                                                                           
					}                                                                                                                                                                                                                                                         
					oMap.table.unbindItems();                                                                                                                                                                                                                                 
					that.setMenuCountToZero(oMap.table.getParent().getId());                                                                                                                                                                                                  
				}                                                                                                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Changes the binding to another username                                                                                                                                                                                                                   
		 * @param{string}sBinding Current Binding                                                                                                                                                                                                                    
		 * @param{string}sUserName new Username to bind it to                                                                                                                                                                                                        
		 * @return{string} new binding to the user                                                                                                                                                                                                                   
		 */                                                                                                                                                                                                                                                          
		changeBindingToUser: function(sBinding, sUserName) {                                                                                                                                                                                                         
			var sResult = sBinding.substr(0, sBinding.indexOf("Username='")) + "Username='";                                                                                                                                                                            
			var sTmp = sBinding.replace(sResult, "");                                                                                                                                                                                                                   
			sResult += sUserName + sTmp.substr(sTmp.indexOf("'"), sTmp.length);                                                                                                                                                                                         
			return sResult;                                                                                                                                                                                                                                             
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Sets the menu entry of a certain log to zero                                                                                                                                                                                                              
		 * @param{string}sLogID sID of the log                                                                                                                                                                                                                       
		 */                                                                                                                                                                                                                                                          
		setMenuCountToZero: function(sLogID) {                                                                                                                                                                                                                       
			var oMenuItem = sap.ui.getCore().byId(sLogID + "-menuItem");                                                                                                                                                                                                
			var sText = oMenuItem.getText();                                                                                                                                                                                                                            
			//only apply if there is an error count                                                                                                                                                                                                                     
			if( sText.indexOf(sText.indexOf("(")) > 0){                                                                                                                                                                                                                 
				sText = sText.substr(0, (sText.indexOf("(") + 1)) + "0)";                                                                                                                                                                                                  
			}                                                                                                                                                                                                                                                           
			oMenuItem.setText(sText);                                                                                                                                                                                                                                   
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Creates a value help instance to select a username&nbsp;                                                                                                                                                                                                  
		 * @param{object}oEvent - Event                                                                                                                                                                                                                              
		 */                                                                                                                                                                                                                                                          
		handleUserValueHelp: function (oEvent) {                                                                                                                                                                                                                     
			var that = this;                                                                                                                                                                                                                                            
			//When Filter has been set reread the model again                                                                                                                                                                                                           
			if (this.oUserModel.getProperty("/userFilterSet") === true) {                                                                                                                                                                                               
				this.oUserModel.setProperty("/userFilterSet", false);                                                                                                                                                                                                      
				this._oViewHelper.oServiceModel.read("/UserlistSet", {                                                                                                                                                                                                     
				filters: [ new Filter("Fullname", FilterOperator.Contains, "") ],                                                                                                                                                                                          
					success: function (results, error) {                                                                                                                                                                                                                      
						//check results                                                                                                                                                                                                                                          
						if (results) {                                                                                                                                                                                                                                           
							this.oUserModel.setProperty("/userList", results.results);                                                                                                                                                                                              
						}                                                                                                                                                                                                                                                        
					}.bind(this)                                                                                                                                                                                                                                              
				});                                                                                                                                                                                                                                                        
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			if (!this._oUserValueHelpDialog) {                                                                                                                                                                                                                          
				var oValueHelpDialog = sap.ui.xmlfragment("nw.core.flp.appdiagnostics.fragments.UserValueHelp",that);                                                                                                                                                      
				this._oUserValueHelpDialog = oValueHelpDialog;                                                                                                                                                                                                             
				this._oUserValueHelpDialog.setModel(this._oI18n, "i18n");                                                                                                                                                                                                  
				this._configUserValueHelpDialog(oEvent);                                                                                                                                                                                                                   
				this._oUserValueHelpDialog.setModel(this.oUserModel);                                                                                                                                                                                                      
				this._oUserValueHelpDialog.open();                                                                                                                                                                                                                         
			} else {                                                                                                                                                                                                                                                    
				this._configUserValueHelpDialog(oEvent);                                                                                                                                                                                                                   
				this._oUserValueHelpDialog.open();                                                                                                                                                                                                                         
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Handles search and filters results                                                                                                                                                                                                                        
		 * @param{object}oEvent - Event                                                                                                                                                                                                                              
		 */                                                                                                                                                                                                                                                          
		handleUserSearch: function (oEvent) {                                                                                                                                                                                                                        
			var sValue = oEvent.getParameter("value");                                                                                                                                                                                                                  
			this.oUserModel.setProperty("/userFilterSet", true);                                                                                                                                                                                                        
			this._oViewHelper.oServiceModel.read("/UserlistSet", {                                                                                                                                                                                                      
				filters: [ new Filter("Fullname", FilterOperator.Contains, sValue) ],                                                                                                                                                                                      
				success: function (results, error) {                                                                                                                                                                                                                       
					&nbsp;                                                                                                                                                                                                                                                    
					//check results                                                                                                                                                                                                                                           
					if (results) {                                                                                                                                                                                                                                            
						this.oUserModel.setProperty("/userList", results.results);                                                                                                                                                                                               
					}                                                                                                                                                                                                                                                         
				}.bind(this)                                                                                                                                                                                                                                               
			});                                                                                                                                                                                                                                                         
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		handleUserValueHelpClose: function () {                                                                                                                                                                                                                      
			var oUserModel = this.oUserModel,                                                                                                                                                                                                                           
				aUsernames = oUserModel.getProperty("/userList"),                                                                                                                                                                                                          
				oInput = sap.ui.getCore().byId(	this.oUserModel.getProperty("/userListInputID"));                                                                                                                                                                          
                                                                                                                                                                                                                                                               
			var bHasSelected = aUsernames.some(function (aUsername) {                                                                                                                                                                                                   
				if (aUsername.selected) {                                                                                                                                                                                                                                  
					oInput.setValue(aUsername.Username);                                                                                                                                                                                                                      
					return true;                                                                                                                                                                                                                                              
				}                                                                                                                                                                                                                                                          
				return false;                                                                                                                                                                                                                                              
			});                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
			if (!bHasSelected) {                                                                                                                                                                                                                                        
				oInput.setValue(null);                                                                                                                                                                                                                                     
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Configures the value help dialog                                                                                                                                                                                                                          
		 * @param{object}oEvent - Event                                                                                                                                                                                                                              
		 */                                                                                                                                                                                                                                                          
		_configUserValueHelpDialog: function (oEvent) {                                                                                                                                                                                                              
			var sInputId = oEvent.getSource().getId();                                                                                                                                                                                                                  
			this.oUserModel.setProperty("/userListInputID", sInputId);                                                                                                                                                                                                  
			var sInputValue = sap.ui.getCore().byId(sInputId).getValue(),                                                                                                                                                                                               
				aUsernames = this.oUserModel.getProperty("/userList");                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
			//Select current item                                                                                                                                                                                                                                       
			aUsernames.forEach(function (aUsername) {                                                                                                                                                                                                                   
				aUsername.selected = (aUsername.Username === sInputValue);                                                                                                                                                                                                 
			});                                                                                                                                                                                                                                                         
			this.oUserModel.setProperty("/userList", aUsernames);                                                                                                                                                                                                       
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Creates an instance of sap.m.Table and binds the service to the items                                                                                                                                                                                     
		 * @param{string}sTableId - Id of the table to be created                                                                                                                                                                                                    
		 * @param{string}sServiceUrl - Relative Url of the oData service                                                                                                                                                                                             
		 * @param{string}sHeaderText - Text to be displayed in the header toolbar                                                                                                                                                                                    
         * @param{object}oCustomData - Object with custom data                                                                                                                                                                                                 
         * @param {string} sModel - Name of the model to bind to, `undefined` for the default model                                                                                                                                                            
		 * @return{object}oTable - Table of type sap.m.Table                                                                                                                                                                                                         
		 */                                                                                                                                                                                                                                                          
		createTableFromFragment: function (sTableId, sServiceUrl, sHeaderText, oCustomData, sModel) {                                                                                                                                                                
			var oProvider, oPerso, oHeaderText;                                                                                                                                                                                                                         
			var oTable = sap.ui.xmlfragment(sTableId, "nw.core.flp.appdiagnostics.fragments.LogTable", this);                                                                                                                                                           
			oTable.setBusy(true);                                                                                                                                                                                                                                       
			oTable.data("modelName",sModel);                                                                                                                                                                                                                            
			var oListItem;                                                                                                                                                                                                                                              
			if (sModel) {                                                                                                                                                                                                                                               
				oListItem = sap.ui.xmlfragment("nw.core.flp.appdiagnostics.fragments.LogItem-" + sModel, this);                                                                                                                                                            
			} else {                                                                                                                                                                                                                                                    
				oListItem = sap.ui.xmlfragment("nw.core.flp.appdiagnostics.fragments.LogItem", this);                                                                                                                                                                      
			}                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
			//create object with custom data as key-value pair                                                                                                                                                                                                          
			var oCustomDataElements = {};                                                                                                                                                                                                                               
			oCustomData.forEach(function(oCustomDataElement) {                                                                                                                                                                                                          
				oCustomDataElements[oCustomDataElement.getKey()] = oCustomDataElement.getValue();                                                                                                                                                                          
			});                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
			//fill data in the oTable                                                                                                                                                                                                                                   
			//Begin correction 3536614 - 06 Nov 2024 - enable inline count to get all results                                                                                                                                                                           
			sap.ui.require(["sap/ui/model/odata/CountMode"                                                                                                                                                                                                              
		    ],function(CountMode){                                                                                                                                                                                                                                   
				oTable.bindItems({                                                                                                                                                                                                                                         
					model: sModel,                                                                                                                                                                                                                                            
					path: sServiceUrl,                                                                                                                                                                                                                                        
					template: oListItem,                                                                                                                                                                                                                                      
					parameters: {                                                                                                                                                                                                                                             
						countMode: CountMode.Inline                                                                                                                                                                                                                              
					}                                                                                                                                                                                                                                                         
				});                                                                                                                                                                                                                                                        
		    });                                                                                                                                                                                                                                                      
		    //End correction 3536614 - 06 Nov 2024                                                                                                                                                                                                                   
	                                                                                                                                                                                                                                                              
			//set header Text                                                                                                                                                                                                                                           
			oHeaderText = this._getToolbarItemById(oTable.getHeaderToolbar(), "ade-header-text");                                                                                                                                                                       
			if (oHeaderText) {                                                                                                                                                                                                                                          
				oHeaderText.unbindProperty("text");                                                                                                                                                                                                                        
				oHeaderText.setText(sHeaderText);                                                                                                                                                                                                                          
				//acc finding                                                                                                                                                                                                                                              
				oHeaderText.setWrapping(true);                                                                                                                                                                                                                             
			}                                                                                                                                                                                                                                                           
			this.prepareUserInput(oTable, oCustomDataElements.UsernameVisible);                                                                                                                                                                                         
			this.setLinkToLog(oTable, oCustomDataElements.LinkToLog);                                                                                                                                                                                                   
			                                                                                                                                                                                                                                                            
			//check, if shell is available                                                                                                                                                                                                                              
			if (sap.ushell && sap.ushell.Container) {                                                                                                                                                                                                                   
				// Get a personalization service provider from  shell&nbsp;                                                                                                                                                                                                
				oProvider = sap.ushell.Container.getService("Personalization").getPersonalizer({                                                                                                                                                                           
					container: "ade",                                                                                                                                                                                                                                         
					item: "sTableId"                                                                                                                                                                                                                                          
				});                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
				// init and activate personalization controller                                                                                                                                                                                                            
				oPerso = new sap.m.TablePersoController({                                                                                                                                                                                                                  
					table: oTable,                                                                                                                                                                                                                                            
					persoService: oProvider                                                                                                                                                                                                                                   
				}).activate();                                                                                                                                                                                                                                             
			}                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
			//add table and personalization object to map                                                                                                                                                                                                               
			this._mTables.push({                                                                                                                                                                                                                                        
				table: oTable,                                                                                                                                                                                                                                             
				perso: oPerso                                                                                                                                                                                                                                              
			});                                                                                                                                                                                                                                                         
			return oTable;                                                                                                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Prepares the user input field and label                                                                                                                                                                                                                   
		 * sets model and hides if necessary                                                                                                                                                                                                                         
		 * @param{object}oTable - table                                                                                                                                                                                                                              
		 * @param{object}sUsernameVisible - Username visible                                                                                                                                                                                                         
		 * */                                                                                                                                                                                                                                                        
		prepareUserInput: function (oTable, sUsernameVisible) {                                                                                                                                                                                                      
			//set model for other user selection                                                                                                                                                                                                                        
			var oUserInput = this._getToolbarItemById(oTable.getHeaderToolbar(), "ade-user-input");                                                                                                                                                                     
			var oUserLabel = this._getToolbarItemById(oTable.getHeaderToolbar(), "ade-user-label");                                                                                                                                                                     
			//Check if the user input should be hidden (destroyed)                                                                                                                                                                                                      
			if (oUserInput &&&nbsp;                                                                                                                                                                                                                                     
				oUserLabel &&                                                                                                                                                                                                                                              
				sUsernameVisible === false) {                                                                                                                                                                                                                              
				oUserInput.destroy();                                                                                                                                                                                                                                      
				oUserLabel.destroy();                                                                                                                                                                                                                                      
			}                                                                                                                                                                                                                                                           
			oUserInput.setModel(this.oUserModel);                                                                                                                                                                                                                       
		},                                                                                                                                                                                                                                                           
		/* Sets the link to the log, which is available in the toolbar                                                                                                                                                                                               
		 * @param{object}oTable - table                                                                                                                                                                                                                              
		 * @param{object}sLinkToLog - link to log                                                                                                                                                                                                                    
		 * */                                                                                                                                                                                                                                                        
		setLinkToLog: function(oTable, sLinkToLog) {                                                                                                                                                                                                                 
			var oLinkToLog = this._getToolbarItemById(oTable.getHeaderToolbar(), "ade-link-to-log");                                                                                                                                                                    
            if (oLinkToLog && sLinkToLog) {                                                                                                                                                                                                                    
                if (sLinkToLog !== "") {                                                                                                                                                                                                                       
                	oLinkToLog.setVisible(true);                                                                                                                                                                                                                  
                    oLinkToLog.data("LinkToLog", sLinkToLog);&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;                                                                                                                                                                    
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Places the item in the filter dialog                                                                                                                                                                                                                      
		 * @param{object}oFilterItem - Item to be placed                                                                                                                                                                                                             
		 * @param{string}sKey - Key of the filter                                                                                                                                                                                                                    
		 * @param{string}sText - Text of the filter                                                                                                                                                                                                                  
		 */                                                                                                                                                                                                                                                          
		_placeItem: function (oFilterItem, sKey, sText) {                                                                                                                                                                                                            
			oFilterItem.addAggregation("items", new sap.m.ViewSettingsItem().setKey(sKey).setText(sText));                                                                                                                                                              
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
