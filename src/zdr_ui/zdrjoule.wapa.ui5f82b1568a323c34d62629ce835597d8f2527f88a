		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Handles the open event of group in toolbar                                                                                                                                                                                                                
		 * @param{object}oEvent - Event of the toolbar button                                                                                                                                                                                                        
		 */                                                                                                                                                                                                                                                          
		handleGroupButtonPressed: function(oEvent) {                                                                                                                                                                                                                 
			this.openViewSettingsDialog(oEvent, "group");                                                                                                                                                                                                               
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Preparation of filter dialog                                                                                                                                                                                                                              
		 * @param{object}oDialog - View Settings Dialog                                                                                                                                                                                                              
		 * @param{string}sTableId - Table ID                                                                                                                                                                                                                         
		 */                                                                                                                                                                                                                                                          
		prepareFilterValues: function(oDialog, sTableId) {                                                                                                                                                                                                           
			var aFilterValues = [],                                                                                                                                                                                                                                     
				aFilterItems = oDialog.getAggregation("filterItems"),                                                                                                                                                                                                      
				aItems = sap.ui.getCore().byId(sTableId).getItems(),                                                                                                                                                                                                       
				sValue;                                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
			//set only once per table                                                                                                                                                                                                                                   
			if (!oDialog.bFiltersApplied) {                                                                                                                                                                                                                             
				// loop over main filter items                                                                                                                                                                                                                             
				for (var i = 0; i < aFilterItems.length; i++) {                                                                                                                                                                                                            
					aFilterValues = [];                                                                                                                                                                                                                                       
					//loop over table items to extract possible values for filter                                                                                                                                                                                             
					for (var j = 0; j < aItems.length; j++) {                                                                                                                                                                                                                 
						//get actual filter value                                                                                                                                                                                                                                
						var sModelName = aItems[j].getParent().data("modelName") || undefined;                                                                                                                                                                                   
						sValue = aItems[j].getBindingContext(sModelName).getProperty(aFilterItems[i].getKey());                                                                                                                                                                  
						                                                                                                                                                                                                                                                         
						var stringifiedTime;                                                                                                                                                                                                                                     
						if (sValue.ms) {                                                                                                                                                                                                                                         
							stringifiedTime = JSON.stringify(sValue);                                                                                                                                                                                                               
							sValue = sValue.ms;                                                                                                                                                                                                                                     
						}                                                                                                                                                                                                                                                        
						                                                                                                                                                                                                                                                         
						//check if value has already been added as possible selection                                                                                                                                                                                            
						if (aFilterValues[sValue]) {                                                                                                                                                                                                                             
							continue;                                                                                                                                                                                                                                               
						}                                                                                                                                                                                                                                                        
						                                                                                                                                                                                                                                                         
						aFilterValues[sValue] = sValue;                                                                                                                                                                                                                          
							                                                                                                                                                                                                                                                        
						var sDisplayedText;                                                                                                                                                                                                                                      
						switch (aFilterItems[i].getKey()) {                                                                                                                                                                                                                      
							case "Date":                                                                                                                                                                                                                                            
								sDisplayedText = sap.ui.core.format.DateFormat.getDateInstance().format(sValue);                                                                                                                                                                       
								break;                                                                                                                                                                                                                                                 
							case "Time":                                                                                                                                                                                                                                            
								sDisplayedText = sap.ui.core.format.DateFormat.getTimeInstance().format(new Date(sValue), true);                                                                                                                                                       
								sValue = stringifiedTime;                                                                                                                                                                                                                              
								break;                                                                                                                                                                                                                                                 
							default:                                                                                                                                                                                                                                                
								sDisplayedText = sValue;                                                                                                                                                                                                                               
						}                                                                                                                                                                                                                                                        
						this._placeItem(aFilterItems[i], sValue, sDisplayedText);                                                                                                                                                                                                
					}                                                                                                                                                                                                                                                         
				}                                                                                                                                                                                                                                                          
				oDialog.bFiltersApplied = true;                                                                                                                                                                                                                            
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		                                                                                                                                                                                                                                                             
		handleViewSettingsConfirm: function (oEvent) {                                                                                                                                                                                                               
			var oTable,                                                                                                                                                                                                                                                 
				mParams = oEvent.getParameters(),                                                                                                                                                                                                                          
				oBinding,                                                                                                                                                                                                                                                  
				aFilters = [],                                                                                                                                                                                                                                             
				aSorters = [],                                                                                                                                                                                                                                             
				aGroups = [];&nbsp;                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
			//extract table ID from sort dialog                                                                                                                                                                                                                         
			var sTableId = oEvent.getSource().getId();                                                                                                                                                                                                                  
			sTableId = sTableId.substr(0, sTableId.indexOf("--view-settings-dialog"));                                                                                                                                                                                  
			var sViewId = sTableId.substr(0, sTableId.indexOf("--log-table"));                                                                                                                                                                                          
			oTable = sap.ui.getCore().byId(sTableId);                                                                                                                                                                                                                   
			oBinding = oTable.getBinding("items");                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
			mParams.filterItems.forEach(function (oItem) {                                                                                                                                                                                                              
				var sPath = oItem.getParent().getKey(),                                                                                                                                                                                                                    
					sOperator = sap.ui.model.FilterOperator.EQ,                                                                                                                                                                                                               
					sValue1 = oItem.getKey(),                                                                                                                                                                                                                                 
					oFilter;                                                                                                                                                                                                                                                  
					                                                                                                                                                                                                                                                          
				if (sPath === "Time") {                                                                                                                                                                                                                                    
					var date = new Date(JSON.parse(sValue1).ms);                                                                                                                                                                                                              
					var dateString = sap.ui.core.format.DateFormat.getTimeInstance({ pattern: "HH:mm:ss"}).format(date, true);                                                                                                                                                
					var Time = new sap.ui.model.odata.type.Time();                                                                                                                                                                                                            
					sValue1 = Time.parseValue(dateString, "string");                                                                                                                                                                                                          
				}                                                                                                                                                                                                                                                          
				oFilter = new sap.ui.model.Filter(sPath, sOperator, sValue1);                                                                                                                                                                                              
				aFilters.push(oFilter);                                                                                                                                                                                                                                    
			});                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
			// apply filter settings                                                                                                                                                                                                                                    
			oBinding.filter(aFilters);                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
			// update filter bar                                                                                                                                                                                                                                        
			sap.ui.getCore().byId(sViewId + "--ade-filter-label").setText(mParams.filterString);                                                                                                                                                                        
			                                                                                                                                                                                                                                                            
			if (aFilters.length > 0) {                                                                                                                                                                                                                                  
				sap.ui.getCore().byId(sViewId + "--ade-filter-toolbar").setVisible(true);                                                                                                                                                                                  
			} else {                                                                                                                                                                                                                                                    
				sap.ui.getCore().byId(sViewId + "--ade-filter-toolbar").setVisible(false);	                                                                                                                                                                                
			}                                                                                                                                                                                                                                                           
			                                                                                                                                                                                                                                                            
			// apply the selected sort and group settings                                                                                                                                                                                                               
			aSorters.push(new sap.ui.model.Sorter(mParams.sortItem.getKey(), mParams.sortDescending));                                                                                                                                                                  
			oTable.getBinding("items").sort(aSorters);                                                                                                                                                                                                                  
			                                                                                                                                                                                                                                                            
			if (mParams.groupItem) {                                                                                                                                                                                                                                    
				//vGroup = this.mGroupFunctions[sPath];                                                                                                                                                                                                                    
				aGroups.push(new sap.ui.model.Sorter(mParams.groupItem.getKey(), mParams.groupDescending));                                                                                                                                                                
				// apply the selected group settings                                                                                                                                                                                                                       
				oBinding.sort(aGroups);                                                                                                                                                                                                                                    
			}                                                                                                                                                                                                                                                           
		},                                                                                                                                                                                                                                                           
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Build the export table template to generate the excel --> will be replaced                                                                                                                                                                                
		 * @returns {object} bulid table layout to export the table.                                                                                                                                                                                                 
		 * @param{object} oResourceBundle - i18n to get name.                                                                                                                                                                                                        
		 * */                                                                                                                                                                                                                                                        
		prepareExportLayout: function (oResourceBundle) {                                                                                                                                                                                                            
			var oFieldsMap, aTableColumns;                                                                                                                                                                                                                              
			oFieldsMap = this.oTableMap.getData();                                                                                                                                                                                                                      
			aTableColumns = [];                                                                                                                                                                                                                                         
			for (var key in oFieldsMap) {                                                                                                                                                                                                                               
				if (oFieldsMap.hasOwnProperty(key)) {                                                                                                                                                                                                                      
					aTableColumns.push(                                                                                                                                                                                                                                       
						this._getPropertiesForExport(key, oResourceBundle)                                                                                                                                                                                                       
					);                                                                                                                                                                                                                                                        
				}                                                                                                                                                                                                                                                          
			}                                                                                                                                                                                                                                                           
			return aTableColumns;                                                                                                                                                                                                                                       
		},                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
		/**&nbsp;                                                                                                                                                                                                                                                    
		 * Find toolbar item by Id                                                                                                                                                                                                                                   
		 * @param{object}oTableToolbar - Toolbar                                                                                                                                                                                                                     
		 * @param{string}sItemId - Id of toolbar item                                                                                                                                                                                                                
		 * @returns{object}oItem - Toolbar item                                                                                                                                                                                                                      
		 * */                                                                                                                                                                                                                                                        
		_getToolbarItemById: function (oTableToolbar, sItemId) {                                                                                                                                                                                                     
			var oItem;                                                                                                                                                                                                                                                  
			var aContent = oTableToolbar.getContent();                                                                                                                                                                                                                  
			for (var i = 0; i < aContent.length; i++) {                                                                                                                                                                                                                 
				if (aContent[i].getId().indexOf(sItemId) > 0) {                                                                                                                                                                                                            
					oItem = aContent[i];                                                                                                                                                                                                                                      
					break;                                                                                                                                                                                                                                                    
				}                                                                                                                                                                                                                                                          
			}                                                                                                                                                                                                                                                           
			return oItem;                                                                                                                                                                                                                                               
		}                                                                                                                                                                                                                                                            
	});                                                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
	return {                                                                                                                                                                                                                                                      
		getInstance: function () {                                                                                                                                                                                                                                   
			if (!instance) {                                                                                                                                                                                                                                            
				instance = new TableHelper();                                                                                                                                                                                                                              
			}                                                                                                                                                                                                                                                           
			return instance;                                                                                                                                                                                                                                            
		},                                                                                                                                                                                                                                                           
		destroy: function () {                                                                                                                                                                                                                                       
			if (instance) {                                                                                                                                                                                                                                             
				//cleanup view setting dialogs (filter, sort, grouping)                                                                                                                                                                                                    
				for (var key in instance._mViewSettingsDialogs) {                                                                                                                                                                                                          
					if (key) {                                                                                                                                                                                                                                                
						instance._mViewSettingsDialogs[key].destroy();                                                                                                                                                                                                           
						instance._mViewSettingsDialogs[key] = null;                                                                                                                                                                                                              
					}                                                                                                                                                                                                                                                         
				}                                                                                                                                                                                                                                                          
				//cleanup tables and personalization                                                                                                                                                                                                                       
				for (var key in instance._mTables) {                                                                                                                                                                                                                       
					if (key) {                                                                                                                                                                                                                                                
						instance._mTables[key].table.destroy();                                                                                                                                                                                                                  
						if (instance._mTables[key].perso) {                                                                                                                                                                                                                      
							instance._mTables[key].perso.destroy();                                                                                                                                                                                                                 
						}                                                                                                                                                                                                                                                        
						instance._mTables[key] = null;                                                                                                                                                                                                                           
					}                                                                                                                                                                                                                                                         
				}                                                                                                                                                                                                                                                          
				instance = null;                                                                                                                                                                                                                                           
			}                                                                                                                                                                                                                                                           
		}                                                                                                                                                                                                                                                            
	};                                                                                                                                                                                                                                                            
});                                                                                                                                                                                                                                                            