        _loadScenariosForCapability: function (sCapabilityName, sDisplayName) {                                                                                                                                                                                
            this._sCurrentScenarioCapabilityName = sCapabilityName;                                                                                                                                                                                            
            this._sCurrentScenarioDisplayName = sDisplayName;                                                                                                                                                                                                  
            this._sScenarioSearchQuery = "";                                                                                                                                                                                                                   
            this._sScenarioSelectedStatus = "All";                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            if (this.oDialog) { this.oDialog.setBusy(true); }                                                                                                                                                                                                  
            this._showCapabilitiesBusy(0, this._fetchi18nText("msgLoadingScenariosTitle"), this._fetchi18nText("msgLoadingScenarios", [sDisplayName || sCapabilityName]));                                                                                     
                                                                                                                                                                                                                                                               
            // init empty health model so bindings don't show stale values                                                                                                                                                                                     
            var oScenHealthModel = this.getModel("scenarioHealthModel");                                                                                                                                                                                       
            if (!oScenHealthModel) {                                                                                                                                                                                                                           
                oScenHealthModel = new JSONModel({ ODataServicesActive: 0, ODataServicesTotal: 0, SAPUI5TMsActive: 0, SAPUI5TMsTotal: 0 });                                                                                                                    
                this.setModel(oScenHealthModel, "scenarioHealthModel");                                                                                                                                                                                        
            } else {                                                                                                                                                                                                                                           
                oScenHealthModel.setData({ ODataServicesActive: 0, ODataServicesTotal: 0, SAPUI5TMsActive: 0, SAPUI5TMsTotal: 0 });                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var oModel = this.getModel("capabilitiesModel");                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // load capability-level health for the rating indicators in the header                                                                                                                                                                            
            var oCapHealthPath = this._getEntitySPath(ENTITY_USAGE.FETCH_CAPABILITY_HEALTH, { CapabilityName: sCapabilityName });                                                                                                                              
            oModel.read(oCapHealthPath.path, {                                                                                                                                                                                                                 
                filters: oCapHealthPath.filters,                                                                                                                                                                                                               
                success: function (oData) {                                                                                                                                                                                                                    
                    var oRow = oData.results ? (oData.results[0] || {}) : oData;                                                                                                                                                                               
                    oScenHealthModel.setData({                                                                                                                                                                                                                 
                        ODataServicesActive: oRow.ODataServicesActive || 0,                                                                                                                                                                                    
                        ODataServicesTotal:  oRow.ODataServicesTotal  || 0,                                                                                                                                                                                    
                        SAPUI5TMsActive:     oRow.SAPUI5TMsActive     || 0,                                                                                                                                                                                    
                        SAPUI5TMsTotal:      oRow.SAPUI5TMsTotal      || 0                                                                                                                                                                                     
                    });                                                                                                                                                                                                                                        
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oErr) { console.error("CapabilityHealth read failed", oErr); }                                                                                                                                                                
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var oSPath = this._getEntitySPath(ENTITY_USAGE.FETCH_CAPABILITY_SCENARIOS, { CapabilityName: sCapabilityName });                                                                                                                                   
            oModel.read(oSPath.path, {                                                                                                                                                                                                                         
                filters: oSPath.filters,                                                                                                                                                                                                                       
                urlParameters: { "$top": "1000" },                                                                                                                                                                                                             
                success: function (oData) {                                                                                                                                                                                                                    
                    var aResults = oData.results || [];                                                                                                                                                                                                        
                    var oScenariosModel = new JSONModel({ results: aResults });                                                                                                                                                                                
                    this.setModel(oScenariosModel, "scenariosModel");                                                                                                                                                                                          
                    this._adjustScenarioSummaryModel(aResults, sDisplayName);                                                                                                                                                                                  
                    if (this.oDialog) { this.oDialog.setBusy(false); }                                                                                                                                                                                         
                    this._hideCapabilitiesBusy();                                                                                                                                                                                                              
                    var oNavContainer = sap.ui.getCore().byId("capabilityNav");                                                                                                                                                                                
                    oNavContainer.to(sap.ui.getCore().byId("pageScenario"));                                                                                                                                                                                   
                    this.appConfigModel.setProperty("/switchUserEnabled", false);                                                                                                                                                                              
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oError) {                                                                                                                                                                                                                     
                    if (this.oDialog) { this.oDialog.setBusy(false); }                                                                                                                                                                                         
                    this._hideCapabilitiesBusy();                                                                                                                                                                                                              
                    console.error("Failed to load scenarios", oError);                                                                                                                                                                                         
                    MessageToast.show(this._fetchi18nText("msgFailedToLoadScenarios"));                                                                                                                                                                        
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _adjustScenarioSummaryModel: function (aScenarios, sDisplayName) {                                                                                                                                                                                     
            var stats = { TotalScenarios: 0, TotalSuccess: 0, TotalWarning: 0, TotalError: 0, SubTitle: "" };                                                                                                                                                  
            stats.TotalScenarios = aScenarios.length;                                                                                                                                                                                                          
            aScenarios.forEach(function (s) {                                                                                                                                                                                                                  
                switch (s.ScenarioHealthState) {                                                                                                                                                                                                               
                    case "S": stats.TotalSuccess++; break;                                                                                                                                                                                                     
                    case "W": stats.TotalWarning++; break;                                                                                                                                                                                                     
                    case "E": stats.TotalError++; break;                                                                                                                                                                                                       
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
            stats.SubTitle = "Showing " + stats.TotalScenarios + " scenarios for " + (sDisplayName || "");                                                                                                                                                     
            var oSummary = this.getModel("scenarioSummaryModel");                                                                                                                                                                                              
            if (!oSummary) {                                                                                                                                                                                                                                   
                oSummary = new JSONModel(stats);                                                                                                                                                                                                               
                this.setModel(oSummary, "scenarioSummaryModel");                                                                                                                                                                                               
            } else {                                                                                                                                                                                                                                           
                oSummary.setData(stats);                                                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onSearchScenarios: function (oEvent) {                                                                                                                                                                                                                 
            this._sScenarioSearchQuery = oEvent.getParameter("query") || oEvent.getSource().getValue();                                                                                                                                                        
            this._applyScenarioFilters();                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onScenarioStatusFilterChange: function (oEvent) {                                                                                                                                                                                                      
            var oItem = oEvent.getParameter("item");                                                                                                                                                                                                           
            this._sScenarioSelectedStatus = oItem ? oItem.getKey() : "All";                                                                                                                                                                                    
            this._applyScenarioFilters();                                                                                                                                                                                                                      
