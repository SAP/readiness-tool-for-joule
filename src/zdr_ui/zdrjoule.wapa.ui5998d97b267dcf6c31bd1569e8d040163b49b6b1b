                                var mScenSeenNext = {};                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                                function fnReadScenDesc(mUrlParams) {                                                                                                                                                                                          
                                    var mSp = {                                                                                                                                                                                                                
                                        success: function (oScenData) {                                                                                                                                                                                        
                                            (oScenData.results || []).forEach(function (s) {                                                                                                                                                                   
                                                mScenDescriptions[                                                                                                                                                                                             
