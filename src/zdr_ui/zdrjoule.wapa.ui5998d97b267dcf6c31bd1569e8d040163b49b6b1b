        _apiaRenderTokens: function () {                                                                                                                                                                                                                       
            var oTokenizer = sap.ui.getCore().byId("apiaTokenizer");                                                                                                                                                                                           
            if (!oTokenizer) { return; }                                                                                                                                                                                                                       
            oTokenizer.removeAllTokens();                                                                                                                                                                                                                      
            this._apiaAPIs.forEach(function (oAPI) {                                                                                                                                                                                                           
                oTokenizer.addToken(new sap.m.Token({                                                                                                                                                                                                          
                    key:  oAPI.apiName,                                                                                                                                                                                                                        
                    text: oAPI.apiName                                                                                                                                                                                                                         
                }));                                                                                                                                                                                                                                           
            });                                                                                                                                                                                                                                                
