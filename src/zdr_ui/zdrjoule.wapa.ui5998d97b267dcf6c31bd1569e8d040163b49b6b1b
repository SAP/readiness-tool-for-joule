        // ── CRA Analysis History ──────────────────────────────────────────────                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        _craLoadAnalysisHistory: function (bShowToast) {                                                                                                                                                                                                       
            var oThis     = this;                                                                                                                                                                                                                              
            var oCraModel = this.getModel("craModel");                                                                                                                                                                                                         
            var oModel    = this.getModel("capabilitiesModel");                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            oCraModel.setProperty("/historyBusy", true);                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            var aAccumulated = [];                                                                                                                                                                                                                             
            var mSeenNext    = {};                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            function fnGetNextParameters(sNextUrl) {                                                                                                                                                                                                           
                var mParameters = {};                                                                                                                                                                                                                          
                var iQueryStart = sNextUrl.indexOf("?");                                                                                                                                                                                                       
                if (iQueryStart < 0) { return mParameters; }                                                                                                                                                                                                   
                var oParams = new URLSearchParams(sNextUrl.substring(iQueryStart + 1));                                                                                                                                                                        
                oParams.forEach(function (sValue, sName) {                                                                                                                                                                                                     
                    if (sName !== "sap-client") { mParameters[sName] = sValue; }                                                                                                                                                                               
                });                                                                                                                                                                                                                                            
                return mParameters;                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            function fnFail() {                                                                                                                                                                                                                                
                oCraModel.setProperty("/historyBusy", false);                                                                                                                                                                                                  
                MessageToast.show(oThis._fetchi18nText("craHistoryLoadError"));                                                                                                                                                                                
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            function fnReadPage(mUrlParameters) {                                                                                                                                                                                                              
                var mReadParameters = {                                                                                                                                                                                                                        
                    success: function (oData) {                                                                                                                                                                                                                
                        aAccumulated = aAccumulated.concat(oData.results || []);                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                        if (!oData.__next) {                                                                                                                                                                                                                   
                            var mStatusLabels = { "NEW": "New", "RUNNING": "Running", "DONE": "Done", "FAILED": "Failed" };                                                                                                                                    
                            var mStatusCounts = {};                                                                                                                                                                                                            
                            aAccumulated.forEach(function (oRec) {                                                                                                                                                                                             
                                if (oRec.Status) {                                                                                                                                                                                                             
                                    mStatusCounts[oRec.Status] = (mStatusCounts[oRec.Status] || 0) + 1;                                                                                                                                                        
                                }                                                                                                                                                                                                                              
                            });                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                            var aStatusOptions = [{                                                                                                                                                                                                            
                                key:  "ALL",                                                                                                                                                                                                                   
                                text: "All (" + aAccumulated.length + ")"                                                                                                                                                                                      
                            }];                                                                                                                                                                                                                                
                            ["NEW", "RUNNING", "DONE", "FAILED"].forEach(function (sStatus) {                                                                                                                                                                  
                                if (mStatusCounts[sStatus]) {                                                                                                                                                                                                  
                                    aStatusOptions.push({                                                                                                                                                                                                      
                                        key:  sStatus,                                                                                                                                                                                                         
                                        text: mStatusLabels[sStatus] + " (" + mStatusCounts[sStatus] + ")"                                                                                                                                                     
                                    });                                                                                                                                                                                                                        
                                }                                                                                                                                                                                                                              
                            });                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                            oCraModel.setProperty("/history",              aAccumulated);                                                                                                                                                                      
                            oCraModel.setProperty("/historyCount",         aAccumulated.length);                                                                                                                                                               
                            oCraModel.setProperty("/historyStatusOptions", aStatusOptions);                                                                                                                                                                    
                            oCraModel.setProperty("/historyBusy",          false);                                                                                                                                                                             
                            if (bShowToast) {                                                                                                                                                                                                                  
                                MessageToast.show(oThis._fetchi18nText("craHistoryRefreshed"));                                                                                                                                                                
                            }                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                            // reset filter if current selection is no longer present                                                                                                                                                                          
                            var sCurrentStatus = oCraModel.getProperty("/historyStatus");                                                                                                                                                                      
                            var bStillValid = aStatusOptions.some(function (o) {                                                                                                                                                                               
                                return o.key === sCurrentStatus;                                                                                                                                                                                               
                            });                                                                                                                                                                                                                                
                            if (!bStillValid) {                                                                                                                                                                                                                
                                oCraModel.setProperty("/historyStatus", "ALL");                                                                                                                                                                                
                                oThis._applyCRAHistoryFilters();                                                                                                                                                                                               
                            }                                                                                                                                                                                                                                  
                            return;                                                                                                                                                                                                                            
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        // guard: never follow same continuation twice                                                                                                                                                                                         
                        if (mSeenNext[oData.__next]) { fnFail(); return; }                                                                                                                                                                                     
                        mSeenNext[oData.__next] = true;                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                        var mNextParameters = fnGetNextParameters(oData.__next);                                                                                                                                                                               
                        if (Object.keys(mNextParameters).length === 0) { fnFail(); return; }                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                        fnReadPage(mNextParameters);                                                                                                                                                                                                           
                    },                                                                                                                                                                                                                                         
                    error: function () { fnFail(); }                                                                                                                                                                                                           
                };                                                                                                                                                                                                                                             
                mReadParameters.urlParameters = mUrlParameters;                                                                                                                                                                                                
                oModel.read("/CustomRoleAnalyses", mReadParameters);                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            fnReadPage({ "$orderby": "CreatedAt desc" });                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onPressCRAHistoryRefresh: function () {                                                                                                                                                                                                                
            this._craLoadAnalysisHistory(true);                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
