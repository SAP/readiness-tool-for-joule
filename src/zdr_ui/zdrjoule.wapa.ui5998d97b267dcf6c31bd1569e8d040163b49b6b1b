        // ── shared create-header / batch-roles / Analyze helper ─────────────                                                                                                                                                                                
        _craRunAnalysisWithRoles: function (aRoles, oCallbacks, sAction) {                                                                                                                                                                                     
            // oCallbacks: { onSuccess(oAnalysis, sNewUUID), onError() }                                                                                                                                                                                       
            sAction = sAction || "Analyze";                                                                                                                                                                                                                    
            var oModel      = this.getModel("capabilitiesModel");                                                                                                                                                                                              
            var sBatchGroup = "craRolesBatch";                                                                                                                                                                                                                 
            var sChangeSet  = "craRolesCS";                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            var aOriginalDeferredGroups = oModel.getDeferredGroups().slice();                                                                                                                                                                                  
            var aDeferredGroups = aOriginalDeferredGroups.slice();                                                                                                                                                                                             
            if (aDeferredGroups.indexOf(sBatchGroup) === -1) {                                                                                                                                                                                                 
                aDeferredGroups.push(sBatchGroup);                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
            oModel.setDeferredGroups(aDeferredGroups);                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            // Step 1: create analysis header (all fields are server-generated)                                                                                                                                                                                
            oModel.create("/CustomRoleAnalyses", {}, {                                                                                                                                                                                                         
                success: function (oCreated) {                                                                                                                                                                                                                 
                    var sUUID        = oCreated.AnalysisUUID;                                                                                                                                                                                                  
                    var sAnalysisKey = oModel.createKey("CustomRoleAnalyses", { AnalysisUUID: sUUID });                                                                                                                                                        
                    var sRolesPath   = "/" + sAnalysisKey + "/to_Roles";                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                    // Step 2: queue all role creates in one changeset                                                                                                                                                                                         
                    aRoles.forEach(function (oRole) {                                                                                                                                                                                                          
                        oModel.create(sRolesPath, { RoleName: oRole.RoleName }, {                                                                                                                                                                              
                            groupId:     sBatchGroup,                                                                                                                                                                                                          
                            changeSetId: sChangeSet                                                                                                                                                                                                            
                        });                                                                                                                                                                                                                                    
                    });                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    oModel.submitChanges({                                                                                                                                                                                                                     
                        groupId: sBatchGroup,                                                                                                                                                                                                                  
                        success: function (oData) {                                                                                                                                                                                                            
                            oModel.setDeferredGroups(aOriginalDeferredGroups);                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                            // a $batch 200 does not guarantee the inner changeset succeeded                                                                                                                                                                   
                            var bOk = true;                                                                                                                                                                                                                    
                            var aBatchParts = (oData && oData.__batchResponses) || [];                                                                                                                                                                         
                            aBatchParts.forEach(function (oPart) {                                                                                                                                                                                             
                                if (oPart.message) { bOk = false; return; }                                                                                                                                                                                    
                                if (oPart.response &&                                                                                                                                                                                                          
                                    parseInt(oPart.response.statusCode, 10) >= 400) {                                                                                                                                                                          
                                    bOk = false;                                                                                                                                                                                                               
                                    return;                                                                                                                                                                                                                    
                                }                                                                                                                                                                                                                              
                                (oPart.__changeResponses || []).forEach(function (oResp) {                                                                                                                                                                     
                                    var sStatus = oResp.statusCode ||                                                                                                                                                                                          
                                        (oResp.response && oResp.response.statusCode);                                                                                                                                                                         
                                    if (sStatus && parseInt(sStatus, 10) >= 400) {                                                                                                                                                                             
                                        bOk = false;                                                                                                                                                                                                           
                                    }                                                                                                                                                                                                                          
                                });                                                                                                                                                                                                                            
                            });                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                            if (!bOk) {                                                                                                                                                                                                                        
                                oCallbacks.onError();                                                                                                                                                                                                          
                                return;                                                                                                                                                                                                                        
                            }                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                            // Step 3: call analysis action (Analyze or AnalyzeBackground)                                                                                                                                                                     
                            var oFnHandle = oModel.callFunction("/" + sAction, {                                                                                                                                                                               
                                method:        "POST",                                                                                                                                                                                                         
                                urlParameters: { AnalysisUUID: sUUID },                                                                                                                                                                                        
                                success: function (oResult) {                                                                                                                                                                                                  
                                    var oAnalysis = oResult[sAction] || oResult;                                                                                                                                                                               
                                    oCallbacks.onSuccess(oAnalysis, oAnalysis.AnalysisUUID || sUUID);                                                                                                                                                          
                                },                                                                                                                                                                                                                             
                                error: function () { oCallbacks.onError(); }                                                                                                                                                                                   
                            });                                                                                                                                                                                                                                
                            if (oFnHandle && typeof oFnHandle.contextCreated === "function") {                                                                                                                                                                 
                                oFnHandle.contextCreated().catch(function () { oCallbacks.onError(); });                                                                                                                                                       
                            }                                                                                                                                                                                                                                  
                        },                                                                                                                                                                                                                                     
                        error: function () {                                                                                                                                                                                                                   
                            oModel.setDeferredGroups(aOriginalDeferredGroups);                                                                                                                                                                                 
                            oCallbacks.onError();                                                                                                                                                                                                              
                        }                                                                                                                                                                                                                                      
                    });                                                                                                                                                                                                                                        
                },                                                                                                                                                                                                                                             
                error: function () {                                                                                                                                                                                                                           
                    oModel.setDeferredGroups(aOriginalDeferredGroups);                                                                                                                                                                                         
                    oCallbacks.onError();                                                                                                                                                                                                                      
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onPressCRAAnalyze: function () {                                                                                                                                                                                                                       
