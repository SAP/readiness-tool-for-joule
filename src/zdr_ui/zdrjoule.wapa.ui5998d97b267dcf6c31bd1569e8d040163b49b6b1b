            console.log(`${logHeader} Initiating diagnostic execution pipeline...`, styles.info);                                                                                                                                                              
                                                                                                                                                                                                                                                               
            // 1. Strict Runtime Environment Validation                                                                                                                                                                                                        
            console.log(`${logHeader} Inspecting global window namespaces...`, styles.info);                                                                                                                                                                   
            console.log("-> window.sapdas:", window.sapdas);                                                                                                                                                                                                   
            console.log("-> window.sap?.das?.webclient:", window.sap?.das?.webclient);                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            if (!window.sap?.das?.webclient) {                                                                                                                                                                                                                 
                console.error(                                                                                                                                                                                                                                 
                    `${logHeader} CRITICAL ERROR: Joule Web Client API object path 'window.sap.das.webclient' is completely inaccessible or not yet loaded at runtime!`,                                                                                       
                    styles.error                                                                                                                                                                                                                               
                );                                                                                                                                                                                                                                             
                console.log(`${logHeader} Check if the Joule iframe is embedded correctly and has initialized.`, styles.warn);                                                                                                                                 
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            const joule = window.sap.das.webclient;                                                                                                                                                                                                            
            console.log(`${logHeader} SUCCESS: API interface secured at window.sap.das.webclient. Available methods inspected:`, styles.success, Object.keys(joule));                                                                                          
                                                                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
                const conversationTitle = this._fetchi18nText("jouleTestThreadTitle");                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                // 2. Ensuring Visibility Prior to Request Dispatch                                                                                                                                                                                            
                console.log(`${logHeader} Asserting interface visibility via joule.show()...`, styles.info);                                                                                                                                                   
                joule.show(); // Essential to ensure the iFrame runtime can handle interactions smoothly                                                                                                                                                       
                                                                                                                                                                                                                                                               
                // 3. Executing Multi-Conversation Generation&nbsp;                                                                                                                                                                                            
                console.log(`${logHeader} Dispatching async execution 'newConversation()' with parameters:`, styles.info);                                                                                                                                     
                console.log(`   - Initial Message: "${text}"`);                                                                                                                                                                                                
                console.log(`   - Conversation Title: "${conversationTitle}"`);                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                // According to the specification, newConversation automatically handles sending the initialMessage to the server.                                                                                                                             
                const threadResponse = await joule.newConversation(text, conversationTitle);                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                // 4. Comprehensive Response Trace & Layout Inspection                                                                                                                                                                                         
                console.log(`${logHeader} RECEIVING THREAD METADATA STRUCTURE FROM BACKEND:`, styles.success);                                                                                                                                                 
                if (threadResponse && typeof threadResponse === 'object') {                                                                                                                                                                                    
                    console.dir(threadResponse);                                                                                                                                                                                                               
                    console.log(`${logHeader} Visualized Thread Table Map:`, styles.info);                                                                                                                                                                     
                    console.table(threadResponse);                                                                                                                                                                                                             
                } else {                                                                                                                                                                                                                                       
                    console.warn(`${logHeader} WARNING: 'newConversation' returned a blank or non-object response:`, styles.warn, threadResponse);                                                                                                             
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // Checking if thread object context contains structural identifiers                                                                                                                                                                           
                if (threadResponse && (threadResponse.thread_id || threadResponse.id)) {                                                                                                                                                                       
                    const activeThreadId = threadResponse.thread_id || threadResponse.id;                                                                                                                                                                      
                    console.log(`${logHeader} Target routing confirmed. Active Thread Session UUID: %c${activeThreadId}`, styles.success, styles.highlight);                                                                                                   
                                                                                                                                                                                                                                                               
                    // Note: Because newConversation explicitly processes the initialMessage upon creation,                                                                                                                                                    
                    // calling sendMessage immediately afterward with the exact same text can sometimes clash or be dropped&nbsp;                                                                                                                              
                    // by the client message state engine. We log it here for structural confirmation:                                                                                                                                                         
                    console.log(`${logHeader} Thread initialized. UI should process request: "${text}" under Thread ID: ${activeThreadId}`, styles.success);                                                                                                   
                } else {                                                                                                                                                                                                                                       
                    console.warn(`${logHeader} Thread ID was not found directly in the root keys. Attempting a fallback broadcast via standard sendMessage pipeline...`, styles.warn);                                                                         
                    joule.sendMessage(text);                                                                                                                                                                                                                   
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                console.log(`${logHeader} Pipeline complete. Awaiting Network lifecycle update or UI thread rendering...`, styles.success);                                                                                                                    
                                                                                                                                                                                                                                                               
            } catch (error) {                                                                                                                                                                                                                                  
                console.error(`${logHeader} RUNTIME EXCEPTION CAUGHT during execution block:`, styles.error);                                                                                                                                                  
                if (error.name) console.error(`Error Type: ${error.name}`);                                                                                                                                                                                    
                if (error.message) console.error(`Error Message: ${error.message}`);                                                                                                                                                                           
                console.error("Full Trace Object:", error);                                                                                                                                                                                                    
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        //functions for switch user header                                                                                                                                                                                                                     
        onSelectDialogPress: function (oEvent) {                                                                                                                                                                                                               
            this._openSwitchUserContextDialog();                                                                                                                                                                                                               
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _openSwitchUserContextDialog: async function(){                                                                                                                                                                                                        
            this.oSwitchUserContextDialog ??= await sap.ui.core.Fragment.load({                                                                                                                                                                                
                name: "dr.joule.assistant.drjoule.fragment.SwitchUserContext",                                                                                                                                                                                 
                controller: this                                                                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
            this.getRootControl().addDependent(this.oSwitchUserContextDialog);                                                                                                                                                                                 
            this.oSwitchUserContextDialog.getBinding("items").filter([]); //user of this?                                                                                                                                                                      
            this.oSwitchUserContextDialog.open();                                                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onSearchUser: function (oEvent) {                                                                                                                                                                                                                      
            var sValue = oEvent.getParameter("value");                                                                                                                                                                                                         
            var oFilter = new Filter({                                                                                                                                                                                                                         
                filters: [                                                                                                                                                                                                                                     
                    new Filter("UserName", FilterOperator.Contains, sValue),                                                                                                                                                                                   
                    new Filter("FirstName", FilterOperator.Contains, sValue),                                                                                                                                                                                  
                    new Filter("LastName", FilterOperator.Contains, sValue),                                                                                                                                                                                   
                    new Filter("EmailAddress", FilterOperator.Contains, sValue)                                                                                                                                                                                
                ],                                                                                                                                                                                                                                             
                and: false                                                                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
            oEvent.getParameter("itemsBinding").filter([oFilter]);                                                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onSwitchUserContextDialogClose: function (oEvent) {                                                                                                                                                                                                    
            var aContexts = oEvent.getParameter("selectedContexts");                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            if (aContexts && aContexts.length) {                                                                                                                                                                                                               
                var oUser      = aContexts[0].getObject();                                                                                                                                                                                                     
                var sUserName  = oUser.UserName;                                                                                                                                                                                                               
                var sFirstName = oUser.FirstName    || "";                                                                                                                                                                                                     
                var sLastName  = oUser.LastName     || "";                                                                                                                                                                                                     
                var sEmail     = oUser.EmailAddress || "";                                                                                                                                                                                                     
                var sSimText   = this._fetchi18nText("btnSimulating", [sUserName]);                                                                                                                                                                            
                var sStripText = this._fetchi18nText("msgSimulationActive", [sUserName]);                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                this.appConfigModel.setProperty("/simulationMode", true);                                                                                                                                                                                      
                this.appConfigModel.setProperty("/selecteContextUserName", sUserName);                                                                                                                                                                         
                this.appConfigModel.setProperty("/contextUserFirstName",   sFirstName);                                                                                                                                                                        
                this.appConfigModel.setProperty("/contextUserLastName",    sLastName);                                                                                                                                                                         
                this.appConfigModel.setProperty("/contextUserEmail",       sEmail);                                                                                                                                                                            
                this.appConfigModel.setProperty("/simulationBtnText",  sSimText);                                                                                                                                                                              
                this.appConfigModel.setProperty("/simulationStripText", sStripText);                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                MessageToast.show(sSimText);                                                                                                                                                                                                                   
                // If currently on pageCompareUserRoles reload it with the new user context                                                                                                                                                                    
                var oNav         = sap.ui.getCore().byId("capabilityNav");                                                                                                                                                                                     
                var oCurrentPage = oNav && oNav.getCurrentPage();                                                                                                                                                                                              
                if (oCurrentPage && oCurrentPage.getId() === "pageCompareUserRoles") {                                                                                                                                                                         
                    this.onPressCompareRoles();                                                                                                                                                                                                                
                } else {                                                                                                                                                                                                                                       
                    this.refreshDataSet(sUserName);                                                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
            } else if (!this.appConfigModel.getProperty("/simulationMode")) {                                                                                                                                                                                  
                MessageToast.show(this._fetchi18nText("msgNoSelection"));                                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
            oEvent.getSource().getBinding("items").filter([]);                                                                                                                                                                                                 
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onCancelSimulationAndReloadRoles: function () {                                                                                                                                                                                                        
            this.onCancelSimulation();                                                                                                                                                                                                                         
            // Reload compare roles page with logged-on user after simulation ends                                                                                                                                                                             
            this.onPressCompareRoles();                                                                                                                                                                                                                        
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onCancelSimulation: function () {                                                                                                                                                                                                                      
            this.appConfigModel.setProperty("/simulationMode", false);                                                                                                                                                                                         
            this.appConfigModel.setProperty("/selecteContextUserName", "");                                                                                                                                                                                    
            this.appConfigModel.setProperty("/contextUserFirstName",   "");                                                                                                                                                                                    
            this.appConfigModel.setProperty("/contextUserLastName",    "");                                                                                                                                                                                    
            this.appConfigModel.setProperty("/contextUserEmail",       "");                                                                                                                                                                                    
            this.appConfigModel.setProperty("/simulationBtnText", "");                                                                                                                                                                                         
            this.appConfigModel.setProperty("/simulationStripText", "");                                                                                                                                                                                       
            this.refreshDataSet("");                                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        refreshDataSet: function (sUserName) {                                                                                                                                                                                                                 
            // Switch User button is only enabled on pageMain — so this always                                                                                                                                                                                 
            // runs from the capabilities list. _initializeCapabilitiesDataModel                                                                                                                                                                               
            // picks up the context user from appConfigModel at call time automatically.                                                                                                                                                                       
            this._initializeCapabilitiesDataModel();                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
        //functions for switch user header                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
    });                                                                                                                                                                                                                                                        
});                                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               