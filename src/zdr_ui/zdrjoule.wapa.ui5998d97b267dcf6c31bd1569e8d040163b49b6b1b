            var confirmMessage = this._fetchi18nText("confirmPromptExecutionMessage");                                                                                                                                                                         
            var submitButtonText = this._fetchi18nText("confirmPromptSubmit");                                                                                                                                                                                 
            var cancelButtonText = this._fetchi18nText("confirmPromptCancel");                                                                                                                                                                                 
