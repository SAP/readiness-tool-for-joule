            this._adjustCapabilitySummaryModel(aCapabilities);                                                                                                                                                                                                 
            this._adjustTopCapabilitiesModel(aCapabilities);                                                                                                                                                                                                   
            this.setModel(oCapabilitiesModel);                                                                                                                                                                                                                 
