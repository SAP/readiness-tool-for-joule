        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Called from the toolbar button — passes ALL unauthorized TMs at once.                                                                                                                                                                               
        onAnalyzeAllUnauthorizedTMs: function () {                                                                                                                                                                                                             
            var oDetailModel = this.getModel("scenarioDetailModel");                                                                                                                                                                                           
            var aTMs = oDetailModel ? (oDetailModel.getProperty("/TMs") || []) : [];                                                                                                                                                                           
            var aTMPairs = aTMs                                                                                                                                                                                                                                
                .filter(function (r) { return r.AuthorizationStatus === "E"; })                                                                                                                                                                                
                .map(function (r) {                                                                                                                                                                                                                            
