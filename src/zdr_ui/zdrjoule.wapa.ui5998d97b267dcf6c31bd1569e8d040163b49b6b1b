                ), "analyzeAllUnauthorizedBtn", oBundle.getText("troubleshootingActionAnalyzeTMs"), aTMSavedRows, false));                                                                                                                                     
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // TMs — Authorization: E = not authorized                                                                                                                                                                                                         
            var aUnauthorizedTMs = aTMs.filter(function (r) { return r.AuthorizationStatus === "E"; });                                                                                                                                                        
            if (aUnauthorizedTMs.length > 0) {                                                                                                                                                                                                                 
                var sTMAuthNames = aUnauthorizedTMs.map(function (r) { return r.FioriAppName ? (r.FioriAppName + " (" + r.SemanticObject + "-" + r.SemanticAction + ")") : (r.SemanticObject + "-" + r.SemanticAction); }).join(", ");                         
                aItems.push(fnSetAction(fnItem(                                                                                                                                                                                                                
                    oBundle.getText("troubleshootingCatAuthorization"), "Error",                                                                                                                                                                               
                    oBundle.getText("troubleshootingTMUnauthorizedTitle"),                                                                                                                                                                                     
                    oBundle.getText("troubleshootingTMUnauthorizedDesc", [sTMAuthNames]),                                                                                                                                                                      
                    [oBundle.getText("troubleshootingTMUnauthorizedStep1"),                                                                                                                                                                                    
                     oBundle.getText("troubleshootingTMUnauthorizedStep2"),                                                                                                                                                                                    
                     oBundle.getText("troubleshootingTMUnauthorizedStep3")]                                                                                                                                                                                    
                ), "analyzeAllUnauthorizedBtn", oBundle.getText("troubleshootingActionAnalyzeTMs"), aTMSavedRows, false));                                                                                                                                     
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            return aItems;                                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _openAPIAPage: function (aAPIs) {                                                                                                                                                                                                                      
