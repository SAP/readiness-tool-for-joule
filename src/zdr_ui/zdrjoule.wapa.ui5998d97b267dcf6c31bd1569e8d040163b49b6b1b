        _openTMAPage: function (aTMPairs) {                                                                                                                                                                                                                    
            // (Re-)create the three view models on the component.                                                                                                                                                                                             
            // The fragment binds directly to these named models — no separate                                                                                                                                                                                 
            // view instance means no propagation gap.                                                                                                                                                                                                         
            this._tmSavedSelections   = this._tmSavedSelections || [];                                                                                                                                                                                         
            this._apiaSavedSelections = this._apiaSavedSelections || [];                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            var oTMView = new JSONModel({ items: [], busy: false, noDataText: this._fetchi18nText("tmNoDataText"), savedCount: this._tmSavedSelections.length });                                                                                              
            var oBRView = new JSONModel({ items: [], busy: false, noDataText: this._fetchi18nText("tmSelectTMPrompt") });                                                                                                                                      
            var oCRView = new JSONModel({ items: [], busy: false, noDataText: this._fetchi18nText("tmSelectBRPrompt") });                                                                                                                                      
                                                                                                                                                                                                                                                               
            this.setModel(oTMView, "tmView");                                                                                                                                                                                                                  
            this.setModel(oBRView, "brView");                                                                                                                                                                                                                  
            this.setModel(oCRView, "crView");                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            this._tmActivePairs   = aTMPairs.slice();                                                                                                                                                                                                          
            this._tmSelectedTM    = null;                                                                                                                                                                                                                      
            this._tmSelectedBR    = null;                                                                                                                                                                                                                      
            this._tmSelectedCR    = null;                                                                                                                                                                                                                      
            this._tmAll           = [];                                                                                                                                                                                                                        
            this._tmBRAll         = [];                                                                                                                                                                                                                        
            this._tmCRAll         = [];                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            var oNavContainer = sap.ui.getCore().byId("capabilityNav");                                                                                                                                                                                        
            oNavContainer.to(sap.ui.getCore().byId("pageTMA"));                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            this._tmRenderTokens();                                                                                                                                                                                                                            
            this._tmLoadTargetMappings();                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _tmRenderTokens: function () {                                                                                                                                                                                                                         
            var oTokenizer = sap.ui.getCore().byId("tmTokenizer");                                                                                                                                                                                             
            if (!oTokenizer) { return; }                                                                                                                                                                                                                       
            oTokenizer.removeAllTokens();                                                                                                                                                                                                                      
            this._tmActivePairs.forEach(function (oPair) {                                                                                                                                                                                                     
                oTokenizer.addToken(new sap.m.Token({                                                                                                                                                                                                          
                    key:  oPair.semanticObject + "||" + oPair.semanticAction,                                                                                                                                                                                  
                    text: oPair.semanticObject + "-"  + oPair.semanticAction                                                                                                                                                                                   
                }));                                                                                                                                                                                                                                           
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onTMTokenDelete: function (oEvent) {                                                                                                                                                                                                                   
            var aDeleted   = oEvent.getParameter("tokens");                                                                                                                                                                                                    
            var oTokenizer = oEvent.getSource();                                                                                                                                                                                                               
            aDeleted.forEach(function (oToken) { oTokenizer.removeToken(oToken); });                                                                                                                                                                           
            this._tmActivePairs = oTokenizer.getTokens().map(function (oToken) {                                                                                                                                                                               
                var aParts = oToken.getKey().split("||");                                                                                                                                                                                                      
                return { semanticObject: aParts[0], semanticAction: aParts[1] };                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
            this._tmResetBRColumn();                                                                                                                                                                                                                           
            this._tmResetCRColumn();                                                                                                                                                                                                                           
            this._tmAll = [];                                                                                                                                                                                                                                  
            this.getModel("tmView").setData({ items: [], busy: false, noDataText: this._fetchi18nText("tmNoDataText"), savedCount: this._tmSavedSelections.length });                                                                                          
            this._tmUpdateCount("tmCount", 0);                                                                                                                                                                                                                 
            if (this._tmActivePairs.length > 0) { this._tmLoadTargetMappings(); }                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _tmLoadTargetMappings: function () {                                                                                                                                                                                                                   
            var oModel     = this.getModel("capabilitiesModel");                                                                                                                                                                                               
            var aPairs     = this._tmActivePairs;                                                                                                                                                                                                              
            var sGroupId   = "tmLoadGroup";                                                                                                                                                                                                                    
            var oTMView    = this.getModel("tmView");                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            oTMView.setData({ items: [], busy: true, noDataText: "", savedCount: this._tmSavedSelections.length });                                                                                                                                            
            this._tmUpdateCount("tmCount", 0);                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            oModel.setDeferredGroups(oModel.getDeferredGroups().concat([sGroupId]));                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            var aResults   = new Array(aPairs.length);                                                                                                                                                                                                         
            var iReadsDone = 0;                                                                                                                                                                                                                                
            var bBatchDone = false;                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            var fnTryMerge = function () {                                                                                                                                                                                                                     
                if (!bBatchDone || iReadsDone < aPairs.length) { return; }                                                                                                                                                                                     
                var oSeen = {}, aMerged = [];                                                                                                                                                                                                                  
                aResults.forEach(function (aChunk) {                                                                                                                                                                                                           
                    (aChunk || []).forEach(function (r) {                                                                                                                                                                                                      
                        var sKey = r.CatalogId + "|" + r.SemanticObject + "|" + r.SemanticAction;                                                                                                                                                              
                        if (!oSeen[sKey]) { oSeen[sKey] = true; aMerged.push(r); }                                                                                                                                                                             
                    });                                                                                                                                                                                                                                        
                });                                                                                                                                                                                                                                            
                this._tmAll = aMerged;                                                                                                                                                                                                                         
                oTMView.setData({ items: aMerged, busy: false, noDataText: this._fetchi18nText("tmNoDataText"), savedCount: this._tmSavedSelections.length });                                                                                                 
                this._tmUpdateCount("tmCount", aMerged.length);                                                                                                                                                                                                
            }.bind(this);                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            aPairs.forEach(function (oPair, i) {                                                                                                                                                                                                               
                oModel.read("/TMTargetMappings", {                                                                                                                                                                                                             
                    groupId: sGroupId,                                                                                                                                                                                                                         
                    filters: [                                                                                                                                                                                                                                 
                        new Filter("SemanticObject", FilterOperator.EQ, oPair.semanticObject),                                                                                                                                                                 
                        new Filter("SemanticAction",  FilterOperator.EQ, oPair.semanticAction)                                                                                                                                                                 
                    ],                                                                                                                                                                                                                                         
                    success: function (oData) {                                                                                                                                                                                                                
                        aResults[i] = (oData.results || []).map(function (r) {                                                                                                                                                                                 
                            var sCatalogName = r.CatalogId ? r.CatalogId.split(":").pop() : "";                                                                                                                                                                
                            return Object.assign({}, r, { CatalogName: sCatalogName });                                                                                                                                                                        
                        });                                                                                                                                                                                                                                    
                        iReadsDone++; fnTryMerge();                                                                                                                                                                                                            
                    },                                                                                                                                                                                                                                         
                    error: function () { aResults[i] = []; iReadsDone++; fnTryMerge(); }                                                                                                                                                                       
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            oModel.submitChanges({                                                                                                                                                                                                                             
                groupId: sGroupId,                                                                                                                                                                                                                             
                success: function () { bBatchDone = true; fnTryMerge(); },                                                                                                                                                                                     
                error: function () {                                                                                                                                                                                                                           
                    this._tmAll = [];                                                                                                                                                                                                                          
                    oTMView.setData({ items: [], busy: false, noDataText: this._fetchi18nText("tmFailedToLoad"), savedCount: this._tmSavedSelections.length });                                                                                                
                    this._tmUpdateCount("tmCount", 0);                                                                                                                                                                                                         
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
