sap.ui.define([                                                                                                                                                                                                                                                
    "sap/ui/core/UIComponent",                                                                                                                                                                                                                                 
    "sap/ui/core/Element",                                                                                                                                                                                                                                     
    "dr/joule/assistant/drjoule/model/models",                                                                                                                                                                                                                 
    "sap/m/Button",                                                                                                                                                                                                                                            
    "sap/m/Bar",                                                                                                                                                                                                                                               
    "sap/m/MessageToast",                                                                                                                                                                                                                                      
    "sap/m/Dialog",                                                                                                                                                                                                                                            
    "sap/m/library",                                                                                                                                                                                                                                           
    "sap/ui/model/json/JSONModel",                                                                                                                                                                                                                             
    "dr/joule/assistant/drjoule/model/formatter",                                                                                                                                                                                                              
    "dr/joule/assistant/drjoule/helper/JouleWebClientHelper",                                                                                                                                                                                                  
        "sap/ui/model/Filter",                                                                                                                                                                                                                                 
    "sap/ui/model/FilterOperator"                                                                                                                                                                                                                              
], (UIComponent, Element, models, Button, Bar, MessageToast, Dialog, mobileLibrary, JSONModel, formatter, JouleWebClientHelper, Filter, FilterOperator) => {                                                                                                   
    "use strict";                                                                                                                                                                                                                                              
    // shortcut for sap.m.ButtonType                                                                                                                                                                                                                           
    var ButtonType = mobileLibrary.ButtonType;                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
    // shortcut for sap.m.DialogType                                                                                                                                                                                                                           
    var DialogType = mobileLibrary.DialogType;                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
    // -------------------------------------------------------------------------                                                                                                                                                                               
    // Usage-pattern constants for _getEntitySPath.                                                                                                                                                                                                            
    // Pass one of these as the first argument to get the correct OData path,                                                                                                                                                                                  
    // with or without user-context simulation, automatically.                                                                                                                                                                                                 
    // -------------------------------------------------------------------------                                                                                                                                                                               
    var ENTITY_USAGE = {                                                                                                                                                                                                                                       
        FETCH_CAPABILITIES:              "FetchCapabilities",                                                                                                                                                                                                  
        FETCH_CAPABILITY_SCENARIOS:      "FetchCapabilityScenarios",                                                                                                                                                                                           
        FETCH_CAPABILITY_HEALTH:         "FetchCapabilityHealth",                                                                                                                                                                                              
        FETCH_SCENARIO_HEALTH:           "FetchScenarioHealth",                                                                                                                                                                                                
        FETCH_SCENARIO_HEALTH_SUMMARY:   "FetchScenarioHealthSummary",                                                                                                                                                                                         
        FETCH_SCENARIO_APIS:             "FetchScenarioAPIs",                                                                                                                                                                                                  
        FETCH_SCENARIO_TMS:              "FetchScenarioTargetMappings",                                                                                                                                                                                        
        FETCH_USERS:                     "FetchUsers",                                                                                                                                                                                                         
        // Role Federation sources (pageCompareUserRoles)                                                                                                                                                                                                      
        FETCH_USER_S4_ROLES:             "FetchUserS4Roles",    // primary — filtered by context user if set                                                                                                                                                   
        FETCH_CDM_V1_ROLES:              "FetchCDMV1Roles",     // all CDM V1 roles, no user filter                                                                                                                                                            
        FETCH_CDM_V2_ROLES:              "FetchCDMV2Roles"      // all CDM V2 roles, no user filter                                                                                                                                                            
    };                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
    return UIComponent.extend("dr.joule.assistant.drjoule.Component", {                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
        formatter: formatter,                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
        /**                                                                                                                                                                                                                                                    
         * Central OData path factory.                                                                                                                                                                                                                         
         *                                                                                                                                                                                                                                                     
         * @param {string} sUsagePattern  One of the ENTITY_USAGE constants.                                                                                                                                                                                   
         * @param {object} oParams        Key/value bag:                                                                                                                                                                                                       
         *   { CapabilityName, ScenarioName }  – provide what the pattern needs.                                                                                                                                                                               
         * @returns {string} The OData path ready for oModel.read().                                                                                                                                                                                           
         *                                                                                                                                                                                                                                                     
         * Context user is read from appConfigModel>/selecteContextUserName.                                                                                                                                                                                   
         * When context is active the "U" entity sets are used.                                                                                                                                                                                                
         * FETCH_USERS is always context-independent.                                                                                                                                                                                                          
         */                                                                                                                                                                                                                                                    
        _getEntitySPath: function (sUsagePattern, oParams) {                                                                                                                                                                                                   
            var p     = oParams || {};                                                                                                                                                                                                                         
            var sCap  = p.CapabilityName ? encodeURIComponent(p.CapabilityName) : "";                                                                                                                                                                          
            var sScen = p.ScenarioName   ? encodeURIComponent(p.ScenarioName)   : "";                                                                                                                                                                          
            var bCtx  = this.appConfigModel &&                                                                                                                                                                                                                 
                        !!this.appConfigModel.getProperty("/selecteContextUserName");                                                                                                                                                                          
            var sUser = bCtx ? this.appConfigModel.getProperty("/selecteContextUserName") : "";                                                                                                                                                                
                                                                                                                                                                                                                                                               
            switch (sUsagePattern) {                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_CAPABILITIES:                                                                                                                                                                                                          
                    return bCtx                                                                                                                                                                                                                                
                        ? { path: "/CapabilitiesU(p_context_user='" + sUser + "')/Set", filters: [] }                                                                                                                                                          
                        : { path: "/Capabilities", filters: [] };                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_CAPABILITY_SCENARIOS:                                                                                                                                                                                                  
                    return bCtx                                                                                                                                                                                                                                
                        ? {                                                                                                                                                                                                                                    
                            path: "/ScenariosU(p_context_user='" + sUser + "')/Set",                                                                                                                                                                           
                            filters: [ new Filter("CapabilityName", FilterOperator.EQ, p.CapabilityName) ]                                                                                                                                                     
                          }                                                                                                                                                                                                                                    
                        : { path: "/Capabilities('" + sCap + "')/to_Scenarios", filters: [] };                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_CAPABILITY_HEALTH:                                                                                                                                                                                                     
                    return bCtx                                                                                                                                                                                                                                
                        ? {                                                                                                                                                                                                                                    
                            path: "/CapabilityHealthU",                                                                                                                                                                                                        
                            filters: [                                                                                                                                                                                                                         
                                new Filter("ContextUser",    FilterOperator.EQ, sUser),                                                                                                                                                                        
                                new Filter("CapabilityName", FilterOperator.EQ, p.CapabilityName)                                                                                                                                                              
                            ]                                                                                                                                                                                                                                  
                          }                                                                                                                                                                                                                                    
                        : { path: "/CapabilityHealth('" + sCap + "')", filters: [] };                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_SCENARIO_HEALTH:                                                                                                                                                                                                       
                case ENTITY_USAGE.FETCH_SCENARIO_HEALTH_SUMMARY:                                                                                                                                                                                               
                    var sHealthKey = "CapabilityName='" + sCap + "',ScenarioName='" + sScen + "'";                                                                                                                                                             
                    return bCtx                                                                                                                                                                                                                                
                        ? {                                                                                                                                                                                                                                    
                            path: "/ScenarioHealthU",                                                                                                                                                                                                          
                            filters: [                                                                                                                                                                                                                         
                                new Filter("ContextUser",    FilterOperator.EQ, sUser),                                                                                                                                                                        
                                new Filter("CapabilityName", FilterOperator.EQ, p.CapabilityName),                                                                                                                                                             
                                new Filter("ScenarioName",   FilterOperator.EQ, p.ScenarioName)                                                                                                                                                                
                            ]                                                                                                                                                                                                                                  
                          }                                                                                                                                                                                                                                    
                        : { path: "/ScenarioHealth(" + sHealthKey + ")", filters: [] };                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_SCENARIO_APIS:                                                                                                                                                                                                         
                    var sScenarKey = "CapabilityName='" + sCap + "',ScenarioName='" + sScen + "'";                                                                                                                                                             
                    return bCtx                                                                                                                                                                                                                                
                        ? {                                                                                                                                                                                                                                    
                            path: "/APIsU(p_context_user='" + sUser + "')/Set",                                                                                                                                                                                
                            filters: [                                                                                                                                                                                                                         
                                new Filter("CapabilityName", FilterOperator.EQ, p.CapabilityName),                                                                                                                                                             
                                new Filter("ScenarioName",   FilterOperator.EQ, p.ScenarioName)                                                                                                                                                                
                            ]                                                                                                                                                                                                                                  
                          }                                                                                                                                                                                                                                    
                        : { path: "/Scenarios(" + sScenarKey + ")/to_APIs", filters: [] };                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_SCENARIO_TMS:                                                                                                                                                                                                          
                    var sScenKeyTM = "CapabilityName='" + sCap + "',ScenarioName='" + sScen + "'";                                                                                                                                                             
                    return bCtx                                                                                                                                                                                                                                
                        ? {                                                                                                                                                                                                                                    
                            path: "/TargetMappingsU(p_context_user='" + sUser + "')/Set",                                                                                                                                                                      
                            filters: [                                                                                                                                                                                                                         
                                new Filter("CapabilityName", FilterOperator.EQ, p.CapabilityName),                                                                                                                                                             
                                new Filter("ScenarioName",   FilterOperator.EQ, p.ScenarioName)                                                                                                                                                                
                            ]                                                                                                                                                                                                                                  
                          }                                                                                                                                                                                                                                    
                        : { path: "/Scenarios(" + sScenKeyTM + ")/to_TargetMappings", filters: [] };                                                                                                                                                           
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_USERS:                                                                                                                                                                                                                 
                    return { path: "/Users", filters: [] };                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                // ── Role Federation (pageCompareUserRoles) ─────────────────────                                                                                                                                                                             
                // Primary source: filter by context user when set, otherwise read all (logged-on user's roles)                                                                                                                                                
                case ENTITY_USAGE.FETCH_USER_S4_ROLES:                                                                                                                                                                                                         
                    return bCtx                                                                                                                                                                                                                                
                        ? { path: "/UserRoles", filters: [ new Filter("UserName", FilterOperator.EQ, sUser) ] }                                                                                                                                                
                        : { path: "/UserRoles", filters: [] };                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                // Secondary sources: always read full set, user-independent                                                                                                                                                                                   
                case ENTITY_USAGE.FETCH_CDM_V1_ROLES:                                                                                                                                                                                                          
                    return { path: "/AllCDMV1Roles", filters: [] };                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                case ENTITY_USAGE.FETCH_CDM_V2_ROLES:                                                                                                                                                                                                          
                    return { path: "/AllCDMV2Roles", filters: [] };                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                default:                                                                                                                                                                                                                                       
                    console.error("_getEntitySPath: unknown usage pattern", sUsagePattern);                                                                                                                                                                    
                    return { path: "", filters: [] };                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        metadata: {                                                                                                                                                                                                                                            
            manifest: "json",                                                                                                                                                                                                                                  
            interfaces: [                                                                                                                                                                                                                                      
                "sap.ui.core.IAsyncContentCreation"                                                                                                                                                                                                            
            ]                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        init: function () {                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            // call the init function of the parent                                                                                                                                                                                                            
            UIComponent.prototype.init.apply(this, arguments);                                                                                                                                                                                                 
            //initialize some variables to hold the state of the filters in the capabilities overview dialog                                                                                                                                                   
            this._sCapabilitySearchQuery = "";                                                                                                                                                                                                                 
            this._sSelectedStatus = "All";                                                                                                                                                                                                                     
            this._jouleWebPluginURL = null;                                                                                                                                                                                                                    
            this._joulePluginDetected = false;                                                                                                                                                                                                                 
            this.oJouleWebClientHelper = null;                                                                                                                                                                                                                 
            this._craResultLoadGen = 0;                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            //appConfigModel model is used to hold the state of the application configuration&nbsp;                                                                                                                                                            
            this.appConfigModel = new JSONModel();                                                                                                                                                                                                             
            this.appConfigModel.setProperty("/joulePluginFound", false); //by default we assume its not found                                                                                                                                                  
            //this.appConfigModel.setProperty("/fullScreenEnabled", true); //setting the flag for this model (Default mode true)                                                                                                                               
            this.setModel(this.appConfigModel, "appConfigModel"); //setting the model to the component so that it can be accessed in the dialog fragment                                                                                                       
                                                                                                                                                                                                                                                               
            //Switch user variables                                                                                                                                                                                                                            
            this.appConfigModel.setProperty("/simulationMode", false);                                                                                                                                                                                         
            this.appConfigModel.setProperty("/selecteContextUserName", "");                                                                                                                                                                                    
            this.appConfigModel.setProperty("/simulationBtnText", "");                                                                                                                                                                                         
            this.appConfigModel.setProperty("/simulationStripText", "");                                                                                                                                                                                       
            this.appConfigModel.setProperty("/switchUserEnabled", true);                                                                                                                                                                                       
            this.appConfigModel.setProperty("/capabilitiesLoaded", false);                                                                                                                                                                                     
            this.appConfigModel.setProperty("/noDataIllustrationSrc",                                                                                                                                                                                          
                sap.ui.require.toUrl("dr/joule/assistant/drjoule") + "/images/No_Data_Illustration.png");                                                                                                                                                      
                                                                                                                                                                                                                                                               
            this.capabilitySummaryModel = new JSONModel({                                                                                                                                                                                                      
                TotalCapabilities: 0,                                                                                                                                                                                                                          
                TotalSuccess: 0,                                                                                                                                                                                                                               
                TotalWarning: 0,                                                                                                                                                                                                                               
                TotalError: 0                                                                                                                                                                                                                                  
            });                                                                                                                                                                                                                                                
            this.setModel(this.capabilitySummaryModel, "capabilitySummaryModel");                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            // initialise formatter with i18n bundle so it works outside XML binding context                                                                                                                                                                   
            this.formatter.init(this.getModel("i18n").getResourceBundle());                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            var rendererPromise = this._getRenderer();                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            rendererPromise.then(function (oRenderer) {                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                oRenderer.addHeaderEndItem(                                                                                                                                                                                                                    
                    "sap.m.Button",                                                                                                                                                                                                                            
                    {                                                                                                                                                                                                                                          
                        id: "drJouleIcon",                                                                                                                                                                                                                     
                        icon: "sap-icon://da-2",                                                                                                                                                                                                               
                        tooltip: this._fetchi18nText("drJouleActiveTooltip"),                                                                                                                                                                                  
                        press: function () {                                                                                                                                                                                                                   
                            this._sendToDrJoule("Show some purchase orders");                                                                                                                                                                                  
                            this._detectJoulePluginAvailability();                                                                                                                                                                                             
                            var sJouleUrl = this._getJouleWebInfo().url;                                                                                                                                                                                       
                            console.log("Joule URL is : " + sJouleUrl);                                                                                                                                                                                        
                            //var jouleWebSocket = this._openJouleWebServiceSocket(sJouleUrl);                                                                                                                                                                 
                            this._openCapabilitiesOverviewDailog();                                                                                                                                                                                            
                        }.bind(this)                                                                                                                                                                                                                           
                    },                                                                                                                                                                                                                                         
                    true,   // bIsVisible                                                                                                                                                                                                                      
                    false   // bCurrentState                                                                                                                                                                                                                   
                );                                                                                                                                                                                                                                             
            }.bind(this));                                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
        onSearchCapabilities: function (oEvent) {                                                                                                                                                                                                              
            var sQuery = oEvent.getParameter("query") || oEvent.getSource().getValue();                                                                                                                                                                        
            var oTable = sap.ui.getCore().byId("idCapabilitiesTable");                                                                                                                                                                                         
            var oBinding = oTable.getBinding("items");                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            if (!oBinding) {                                                                                                                                                                                                                                   
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
            this._sCapabilitySearchQuery = sQuery;                                                                                                                                                                                                             
            this._applyCapabilityFilters();                                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onStatusFilterChange: function (oEvent) {                                                                                                                                                                                                              
            var oButton = oEvent.getParameter("item");                                                                                                                                                                                                         
            this._sSelectedStatus = oButton ? oButton.getKey() : "All";                                                                                                                                                                                        
            this._applyCapabilityFilters();                                                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _applyCapabilityFilters: function () {                                                                                                                                                                                                                 
            var oTable = sap.ui.getCore().byId("idCapabilitiesTable");                                                                                                                                                                                         
            var oBinding = oTable.getBinding("items");                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            if (!oBinding) {                                                                                                                                                                                                                                   
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var aFilters = [];                                                                                                                                                                                                                                 
            var sQuery = (this._sCapabilitySearchQuery || "").trim();                                                                                                                                                                                          
            var sStatus = this._sSelectedStatus || "All";                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            if (sQuery) {                                                                                                                                                                                                                                      
                aFilters.push(new sap.ui.model.Filter({                                                                                                                                                                                                        
                    filters: [new sap.ui.model.Filter("CapabilityDisplayName", sap.ui.model.FilterOperator.Contains, sQuery),                                                                                                                                  
                    new sap.ui.model.Filter("CapabilityName", sap.ui.model.FilterOperator.Contains, sQuery),                                                                                                                                                   
                    new sap.ui.model.Filter("Namespace", sap.ui.model.FilterOperator.Contains, sQuery),                                                                                                                                                        
                    new sap.ui.model.Filter("Version", sap.ui.model.FilterOperator.Contains, sQuery),                                                                                                                                                          
                    new sap.ui.model.Filter("OverallHealth", sap.ui.model.FilterOperator.Contains, sQuery)                                                                                                                                                     
                    ],                                                                                                                                                                                                                                         
                    and: false                                                                                                                                                                                                                                 
                }));                                                                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (sStatus !== "All") {                                                                                                                                                                                                                           
                aFilters.push(new sap.ui.model.Filter("OverallHealth", sap.ui.model.FilterOperator.EQ, sStatus));                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oBinding.filter(aFilters, sap.ui.model.FilterType.Application);                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onInfoPress: function (oEvent) {                                                                                                                                                                                                                       
            var oContext = oEvent.getSource().getBindingContext();                                                                                                                                                                                             
            var sCapabilityName = oContext.getProperty("CapabilityName");                                                                                                                                                                                      
            var sDisplayName    = oContext.getProperty("CapabilityDisplayName") || sCapabilityName;                                                                                                                                                            
            this._loadCapabilityDetail(sCapabilityName, sDisplayName);                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _loadCapabilityDetail: function (sCapabilityName, sDisplayName) {                                                                                                                                                                                      
            this._sCurrentDetailCapabilityName = sCapabilityName;                                                                                                                                                                                              
            this._sCurrentDetailDisplayName    = sDisplayName;                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Navigate immediately with a clean model                                                                                                                                                                                                         
            var oDetailModel = new sap.ui.model.json.JSONModel({                                                                                                                                                                                               
                DisplayName:              sDisplayName || sCapabilityName,                                                                                                                                                                                     
                Subtitle:                 this._fetchi18nText("capDetailSubtitle", [sCapabilityName]),                                                                                                                                                         
                OverallStatus:            "",                                                                                                                                                                                                                  
                OverallStatusText:        "",                                                                                                                                                                                                                  
                OverallStatusState:       "None",                                                                                                                                                                                                              
                OverallStatusStateRaw:    "",                                                                                                                                                                                                                  
                ODataServicesTotal:       0,                                                                                                                                                                                                                   
                ODataServicesActive:      0,                                                                                                                                                                                                                   
                ODataServicesInactive:    0,                                                                                                                                                                                                                   
                ODataServicesAuthorized:  0,                                                                                                                                                                                                                   
                ODataServicesUnauthorized:0,                                                                                                                                                                                                                   
                SAPUI5TMsTotal:           0,                                                                                                                                                                                                                   
                SAPUI5TMsActive:          0,                                                                                                                                                                                                                   
                SAPUI5TMsInactive:        0,                                                                                                                                                                                                                   
                SAPUI5TMsAuthorized:      0,                                                                                                                                                                                                                   
                SAPUI5TMsUnauthorized:    0,                                                                                                                                                                                                                   
                AuthSummaryState:         "",                                                                                                                                                                                                                  
                AuthSummary:              "",                                                                                                                                                                                                                  
                AuthSummaryDescription:   "",                                                                                                                                                                                                                  
                APIs:                     [], APIsTotal: 0,                                                                                                                                                                                                    
                TMs:                      [], TMsTotal:  0,                                                                                                                                                                                                    
                HasUnauthorizedAPIs:      false,                                                                                                                                                                                                               
                HasUnauthorizedTMs:       false,                                                                                                                                                                                                               
                HasTroubleshootingItems:  false                                                                                                                                                                                                                
            });                                                                                                                                                                                                                                                
            this.setModel(oDetailModel, "capabilityDetailModel");                                                                                                                                                                                              
            this.appConfigModel.setProperty("/switchUserEnabled", false);                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            var oNavContainer = sap.ui.getCore().byId("capabilityNav");                                                                                                                                                                                        
            oNavContainer.to(sap.ui.getCore().byId("pageCapabilityDetail"));                                                                                                                                                                                   
            this._showCapabilitiesBusy(0,                                                                                                                                                                                                                      
                this._fetchi18nText("msgLoadingScenarioDetailTitle"),                                                                                                                                                                                          
                this._fetchi18nText("msgLoadingScenarios", [sDisplayName || sCapabilityName])                                                                                                                                                                  
            );                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            var oModel = this.getModel("capabilitiesModel");                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // ── Phase 1: CapabilityHealth — summary card data ──────────────────                                                                                                                                                                             
            var oCapHealthPath = this._getEntitySPath(ENTITY_USAGE.FETCH_CAPABILITY_HEALTH, { CapabilityName: sCapabilityName });                                                                                                                              
            oModel.read(oCapHealthPath.path, {                                                                                                                                                                                                                 
                filters: oCapHealthPath.filters,                                                                                                                                                                                                               
                success: function (oData) {                                                                                                                                                                                                                    
                    var oRow = oData.results ? (oData.results[0] || {}) : oData;                                                                                                                                                                               
                    oDetailModel.setProperty("/OverallStatus",             oRow.OverallStatus             || "");                                                                                                                                              
                    oDetailModel.setProperty("/OverallStatusText",         oRow.OverallStatus             || "");                                                                                                                                              
                    oDetailModel.setProperty("/OverallStatusState",        this.formatter.formatHealthState(oRow.OverallStatusState));                                                                                                                         
                    oDetailModel.setProperty("/OverallStatusStateRaw",     oRow.OverallStatusState        || "");                                                                                                                                              
                    oDetailModel.setProperty("/ODataServicesTotal",        oRow.ODataServicesTotal        || 0);                                                                                                                                               
                    oDetailModel.setProperty("/ODataServicesActive",       oRow.ODataServicesActive       || 0);                                                                                                                                               
                    oDetailModel.setProperty("/ODataServicesInactive",     oRow.ODataServicesInactive     || 0);                                                                                                                                               
                    oDetailModel.setProperty("/ODataServicesAuthorized",   oRow.ODataServicesAuthorized   || 0);                                                                                                                                               
                    oDetailModel.setProperty("/ODataServicesUnauthorized", oRow.ODataServicesUnauthorized || 0);                                                                                                                                               
                    oDetailModel.setProperty("/SAPUI5TMsTotal",            oRow.SAPUI5TMsTotal            || 0);                                                                                                                                               
                    oDetailModel.setProperty("/SAPUI5TMsActive",           oRow.SAPUI5TMsActive           || 0);                                                                                                                                               
                    oDetailModel.setProperty("/SAPUI5TMsInactive",         oRow.SAPUI5TMsInactive         || 0);                                                                                                                                               
                    oDetailModel.setProperty("/SAPUI5TMsAuthorized",       oRow.SAPUI5TMsAuthorized       || 0);                                                                                                                                               
                    oDetailModel.setProperty("/SAPUI5TMsUnauthorized",     oRow.SAPUI5TMsUnauthorized     || 0);                                                                                                                                               
                    oDetailModel.setProperty("/AuthSummaryState",          oRow.AuthSummaryState          || "");                                                                                                                                              
                    oDetailModel.setProperty("/AuthSummary",               oRow.AuthSummary               || "");                                                                                                                                              
                    oDetailModel.setProperty("/AuthSummaryDescription",    oRow.AuthSummaryDescription    || "");                                                                                                                                              
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oErr) { console.error("CapabilityHealth read failed", oErr); }                                                                                                                                                                
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // ── Phase 2: all scenarios → then all APIs + TMs in parallel ──────                                                                                                                                                                              
            var oScenariosPath = this._getEntitySPath(ENTITY_USAGE.FETCH_CAPABILITY_SCENARIOS, { CapabilityName: sCapabilityName });                                                                                                                           
            oModel.read(oScenariosPath.path, {                                                                                                                                                                                                                 
                filters: oScenariosPath.filters,                                                                                                                                                                                                               
                success: function (oData) {                                                                                                                                                                                                                    
                    var aScenarios = oData.results || [];                                                                                                                                                                                                      
                    if (aScenarios.length === 0) {                                                                                                                                                                                                             
                        this._hideCapabilitiesBusy();                                                                                                                                                                                                          
                        return;                                                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                    var iPending = aScenarios.length * 2;                                                                                                                                                                                                      
                    var aAllAPIs = [];                                                                                                                                                                                                                         
                    var aAllTMs  = [];                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                    var fnDone = function () {                                                                                                                                                                                                                 
                        iPending--;                                                                                                                                                                                                                            
                        if (iPending === 0) {                                                                                                                                                                                                                  
                            var bHasUnauthorizedAPIs = aAllAPIs.some(function (r) { return r.AuthorizationStatus === "E"; });                                                                                                                                  
                            var bHasUnauthorizedTMs  = aAllTMs.some(function (r)  { return r.AuthorizationStatus === "E"; });                                                                                                                                  
                            var bHasTroubleshooting  = aAllAPIs.some(function (r) { return r.ActivationStatus === "E" || r.AuthorizationStatus === "E"; }) ||                                                                                                  
                                                       aAllTMs.some(function (r)  { return r.ActivationStatus === "E" || r.ActivationStatus === "W" || r.AuthorizationStatus === "E"; });                                                                      
                            oDetailModel.setProperty("/APIs",                    aAllAPIs);                                                                                                                                                                    
                            oDetailModel.setProperty("/APIsTotal",               aAllAPIs.length);                                                                                                                                                             
                            oDetailModel.setProperty("/TMs",                     aAllTMs);                                                                                                                                                                     
                            oDetailModel.setProperty("/TMsTotal",                aAllTMs.length);                                                                                                                                                              
                            oDetailModel.setProperty("/HasUnauthorizedAPIs",     bHasUnauthorizedAPIs);                                                                                                                                                        
                            oDetailModel.setProperty("/HasUnauthorizedTMs",      bHasUnauthorizedTMs);                                                                                                                                                         
                            oDetailModel.setProperty("/HasTroubleshootingItems", bHasTroubleshooting);                                                                                                                                                         
                            this._hideCapabilitiesBusy();                                                                                                                                                                                                      
                        }                                                                                                                                                                                                                                      
                    }.bind(this);                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                    aScenarios.forEach(function (oScen) {                                                                                                                                                                                                      
                        var oParams = { CapabilityName: sCapabilityName, ScenarioName: oScen.ScenarioName };                                                                                                                                                   
                                                                                                                                                                                                                                                               
                        var oAPIsPath = this._getEntitySPath(ENTITY_USAGE.FETCH_SCENARIO_APIS, oParams);                                                                                                                                                       
                        oModel.read(oAPIsPath.path, {                                                                                                                                                                                                          
                            filters: oAPIsPath.filters,                                                                                                                                                                                                        
                            success: function (oAPIsData) {                                                                                                                                                                                                    
                                (oAPIsData.results || []).forEach(function (r) { aAllAPIs.push(r); });                                                                                                                                                         
                                fnDone();                                                                                                                                                                                                                      
                            },                                                                                                                                                                                                                                 
                            error: function () { fnDone(); }                                                                                                                                                                                                   
                        });                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                        var oTMsPath = this._getEntitySPath(ENTITY_USAGE.FETCH_SCENARIO_TMS, oParams);                                                                                                                                                         
                        oModel.read(oTMsPath.path, {                                                                                                                                                                                                           
                            filters: oTMsPath.filters,                                                                                                                                                                                                         
                            success: function (oTMsData) {                                                                                                                                                                                                     
                                (oTMsData.results || []).forEach(function (r) { aAllTMs.push(r); });                                                                                                                                                           
                                fnDone();                                                                                                                                                                                                                      
                            },                                                                                                                                                                                                                                 
                            error: function () { fnDone(); }                                                                                                                                                                                                   
                        });                                                                                                                                                                                                                                    
                    }.bind(this));                                                                                                                                                                                                                             
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oErr) {                                                                                                                                                                                                                       
                    console.error("_loadCapabilityDetail: scenarios fetch failed", oErr);                                                                                                                                                                      
                    this._hideCapabilitiesBusy();                                                                                                                                                                                                              
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
