                    oDetailModel.setProperty("/HasUnauthorizedTMs",                                                                                                                                                                                            
                        aTMs.some(function (r) { return r.AuthorizationStatus === "E"; })                                                                                                                                                                      
                    );                                                                                                                                                                                                                                         
                    var sOperator = aTMs.length > 0 ? (aTMs[0].Operator || "") : "";                                                                                                                                                                           
                    var bShowOperator = aTMs.length >= 2 && (sOperator === "ALL" || sOperator === "ANY");                                                                                                                                                      
                    oDetailModel.setProperty("/TMOperatorVisible", bShowOperator);                                                                                                                                                                             
                    oDetailModel.setProperty("/TMOperatorText", bShowOperator                                                                                                                                                                                  
                        ? this._fetchi18nText(sOperator === "ANY" ? "tmOperatorAny" : "tmOperatorAll")                                                                                                                                                         
                        : "");                                                                                                                                                                                                                                 
                    fnDone();                                                                                                                                                                                                                                  
