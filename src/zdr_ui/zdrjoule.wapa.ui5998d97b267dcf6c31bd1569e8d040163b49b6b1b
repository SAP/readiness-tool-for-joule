        _loadUI5Dependencies: function (oTM, oModel, oBundle) {                                                                                                                                                                                                
            var oODataModel = this.getModel("capabilitiesModel");                                                                                                                                                                                              
            var aFilters = [                                                                                                                                                                                                                                   
                new Filter("SemanticObject", FilterOperator.EQ, oTM.SemanticObject),                                                                                                                                                                           
                new Filter("SemanticAction",  FilterOperator.EQ, oTM.SemanticAction)                                                                                                                                                                           
            ];                                                                                                                                                                                                                                                 
            if (oTM.CatalogID) {                                                                                                                                                                                                                               
                aFilters.push(new Filter("CatalogId", FilterOperator.EQ, oTM.CatalogID));                                                                                                                                                                      
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oODataModel.read("/UI5Dependencies", {                                                                                                                                                                                                             
                filters: aFilters,                                                                                                                                                                                                                             
                success: function (oData) {                                                                                                                                                                                                                    
                    var aAll = oData.results || [];                                                                                                                                                                                                            
                    var aUI5   = aAll.filter(function (r) { return r.DependencyType === "UI5"; });                                                                                                                                                             
                    var aOData = aAll.filter(function (r) { return r.DependencyType === "ODATA"; });                                                                                                                                                           
                    var aOData4= aAll.filter(function (r) { return r.DependencyType === "ODATA4"; });                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    var fnTitle = function (sKey, iTotal, iBad) {                                                                                                                                                                                              
                        return oBundle.getText(sKey) + " (" + iTotal + (iBad > 0 ? ", " + iBad + " " + oBundle.getText("activationSummaryWarning") : ", " + oBundle.getText("activationSummaryAllActive")) + ")";                                              
                    };                                                                                                                                                                                                                                         
                    var fnSub = function (aItems) {                                                                                                                                                                                                            
                        var iBad = aItems.filter(function (r) { return r.Status !== "S"; }).length;                                                                                                                                                            
                        return iBad > 0                                                                                                                                                                                                                        
                            ? oBundle.getText("activationSummarySubWarning", [aItems.length, aItems.length - iBad, iBad])                                                                                                                                      
                            : oBundle.getText("activationSummarySubOk", [aItems.length]);                                                                                                                                                                      
                    };                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                    oModel.setProperty("/ui5Items",    aUI5);                                                                                                                                                                                                  
                    oModel.setProperty("/odataItems",  aOData);                                                                                                                                                                                                
                    oModel.setProperty("/odata4Items", aOData4);                                                                                                                                                                                               
                    oModel.setProperty("/ui5Title",    fnTitle("activationSummaryUI5Title",   aUI5.length,   aUI5.filter(function (r) { return r.Status !== "S"; }).length));                                                                                  
                    oModel.setProperty("/odataTitle",  fnTitle("activationSummaryODataTitle", aOData.length, aOData.filter(function (r) { return r.Status !== "S"; }).length));                                                                                
                    oModel.setProperty("/odata4Title", fnTitle("activationSummaryOData4Title",aOData4.length,aOData4.filter(function (r) { return r.Status !== "S"; }).length));                                                                               
                    oModel.setProperty("/ui5Subtitle",    aUI5.length   > 0 ? fnSub(aUI5)   : "");                                                                                                                                                             
                    oModel.setProperty("/odataSubtitle",  aOData.length > 0 ? fnSub(aOData)  : "");                                                                                                                                                            
                    oModel.setProperty("/odata4Subtitle", aOData4.length> 0 ? fnSub(aOData4) : "");                                                                                                                                                            
                    oModel.setProperty("/busy", false);                                                                                                                                                                                                        
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oErr) {                                                                                                                                                                                                                       
                    console.error("UI5Dependencies load failed", oErr);                                                                                                                                                                                        
                    oModel.setProperty("/busy", false);                                                                                                                                                                                                        
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
