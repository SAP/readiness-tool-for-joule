                            this.oSubmitDialog.close();                                                                                                                                                                                                        
                        }.bind(this)                                                                                                                                                                                                                           
                    })                                                                                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            this.oSubmitDialog.open();                                                                                                                                                                                                                         
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
