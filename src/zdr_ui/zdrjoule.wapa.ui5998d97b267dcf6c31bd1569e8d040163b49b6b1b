        _buildTroubleshootingItems: function (aAPIs, aTMs, aApiSaved, aTMSaved) {                                                                                                                                                                              
            var oBundle = this.getModel("i18n").getResourceBundle();                                                                                                                                                                                           
            var aItems = [];                                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // Build a lookup set of affected API names (uppercase for safe matching)                                                                                                                                                                          
            var oAffectedAPIs = {};                                                                                                                                                                                                                            
            aAPIs.filter(function (r) { return r.AuthorizationStatus === "E"; })                                                                                                                                                                               
                 .forEach(function (r) { oAffectedAPIs[r.OdataServiceName.toUpperCase()] = true; });                                                                                                                                                           
                                                                                                                                                                                                                                                               
            // Build a lookup set of affected TM pairs                                                                                                                                                                                                         
            var oAffectedTMs = {};                                                                                                                                                                                                                             
            aTMs.filter(function (r) { return r.ActivationStatus === "E" || r.ActivationStatus === "W" || r.AuthorizationStatus === "E"; })                                                                                                                    
                .forEach(function (r) { oAffectedTMs[r.SemanticObject + "|" + r.SemanticAction] = true; });                                                                                                                                                    
                                                                                                                                                                                                                                                               
            // Build saved rows for API items                                                                                                                                                                                                                  
            var aApiSavedRows = (aApiSaved || [])                                                                                                                                                                                                              
                .filter(function (s) { return oAffectedAPIs[s.api.ApiName.toUpperCase()]; })                                                                                                                                                                   
                .map(function (s) {                                                                                                                                                                                                                            
                    return {                                                                                                                                                                                                                                   
                        col1: s.api.ApiName    || "",                                                                                                                                                                                                          
                        col2: s.api.ApiVersion || "",                                                                                                                                                                                                          
                        col3: s.businessRole.RoleName || "",                                                                                                                                                                                                   
                        col4: s.compositeRole ? (s.compositeRole.CompositeRoleName || "") : ""                                                                                                                                                                 
                    };                                                                                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            // Build saved rows for TM items                                                                                                                                                                                                                   
            var aTMSavedRows = (aTMSaved || [])                                                                                                                                                                                                                
                .filter(function (s) {                                                                                                                                                                                                                         
                    var tm = s.targetMapping;                                                                                                                                                                                                                  
                    return oAffectedTMs[tm.SemanticObject + "|" + tm.SemanticAction];                                                                                                                                                                          
                })                                                                                                                                                                                                                                             
                .map(function (s) {                                                                                                                                                                                                                            
                    var tm = s.targetMapping;                                                                                                                                                                                                                  
                    return {                                                                                                                                                                                                                                   
                        col1: tm.SemanticObject + "-" + tm.SemanticAction,                                                                                                                                                                                     
                        col2: tm.CatalogName || tm.CatalogId || "",                                                                                                                                                                                            
                        col3: s.businessRole.RoleName || "",                                                                                                                                                                                                   
                        col4: s.compositeRole ? (s.compositeRole.CompositeRoleName || "") : ""                                                                                                                                                                 
                    };                                                                                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            var fnItem = function (sCatLabel, sCatState, sTitle, sDesc, aSteps) {                                                                                                                                                                              
                var sPlain = sDesc + "\n" + aSteps.map(function (s, i) { return "  " + (i + 1) + ". " + s; }).join("\n");                                                                                                                                      
                var sHtml  = "<p>" + sDesc + "</p><ol>" + aSteps.map(function (s) { return "<li>" + s + "</li>"; }).join("") + "</ol>";                                                                                                                        
                return { categoryLabel: sCatLabel, categoryState: sCatState, title: sTitle, stepsHtml: sHtml, plainText: sPlain, actionId: "", actionLabel: "", savedRows: [], isApiType: false };                                                             
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            var fnSetAction = function (oItem, sActionId, sActionLabel, aSavedRows, bIsApiType) {                                                                                                                                                              
                oItem.actionId    = sActionId;                                                                                                                                                                                                                 
                oItem.actionLabel = sActionLabel;                                                                                                                                                                                                              
                oItem.savedRows   = aSavedRows || [];                                                                                                                                                                                                          
                oItem.isApiType   = !!bIsApiType;                                                                                                                                                                                                              
                return oItem;                                                                                                                                                                                                                                  
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // OData APIs — Activation (E = Inactive)                                                                                                                                                                                                          
            var aInactiveAPIs = aAPIs.filter(function (r) { return r.ActivationStatus === "E"; });                                                                                                                                                             
            if (aInactiveAPIs.length > 0) {                                                                                                                                                                                                                    
                var sNames = aInactiveAPIs.map(function (r) { return r.OdataServiceName; }).join(", ");                                                                                                                                                        
                aItems.push(fnItem(                                                                                                                                                                                                                            
                    oBundle.getText("troubleshootingCatActivation"), "Error",                                                                                                                                                                                  
                    oBundle.getText("troubleshootingODataInactiveTitle"),                                                                                                                                                                                      
                    oBundle.getText("troubleshootingODataInactiveDesc", [sNames]),                                                                                                                                                                             
                    [oBundle.getText("troubleshootingODataInactiveStep1"),                                                                                                                                                                                     
                     oBundle.getText("troubleshootingODataInactiveStep2"),                                                                                                                                                                                     
                     oBundle.getText("troubleshootingODataInactiveStep3")]                                                                                                                                                                                     
                ));                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // OData APIs — Authorization (E = No Authorization)                                                                                                                                                                                               
            var aUnauthorizedAPIs = aAPIs.filter(function (r) { return r.AuthorizationStatus === "E"; });                                                                                                                                                      
            if (aUnauthorizedAPIs.length > 0) {                                                                                                                                                                                                                
                var sAuthNames = aUnauthorizedAPIs.map(function (r) { return r.OdataServiceName; }).join(", ");                                                                                                                                                
                aItems.push(fnSetAction(fnItem(                                                                                                                                                                                                                
                    oBundle.getText("troubleshootingCatAuthorization"), "Error",                                                                                                                                                                               
                    oBundle.getText("troubleshootingODataUnauthorizedTitle"),                                                                                                                                                                                  
                    oBundle.getText("troubleshootingODataUnauthorizedDesc", [sAuthNames]),                                                                                                                                                                     
                    [oBundle.getText("troubleshootingODataUnauthorizedStep1"),                                                                                                                                                                                 
                     oBundle.getText("troubleshootingODataUnauthorizedStep2"),                                                                                                                                                                                 
                     oBundle.getText("troubleshootingODataUnauthorizedStep3")]                                                                                                                                                                                 
                ), "analyzeAllUnauthorizedAPIsBtn", oBundle.getText("troubleshootingActionAnalyzeAPIs"), aApiSavedRows, true));                                                                                                                                
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // TMs — Activation: E = fully inactive                                                                                                                                                                                                            
            var aInactiveTMs = aTMs.filter(function (r) { return r.ActivationStatus === "E"; });                                                                                                                                                               
            if (aInactiveTMs.length > 0) {                                                                                                                                                                                                                     
                var sTMNames = aInactiveTMs.map(function (r) { return r.FioriAppName ? (r.FioriAppName + " (" + r.SemanticObject + "-" + r.SemanticAction + ")") : (r.SemanticObject + "-" + r.SemanticAction); }).join(", ");                                 
                aItems.push(fnSetAction(fnItem(                                                                                                                                                                                                                
                    oBundle.getText("troubleshootingCatActivation"), "Error",                                                                                                                                                                                  
                    oBundle.getText("troubleshootingTMInactiveTitle"),                                                                                                                                                                                         
                    oBundle.getText("troubleshootingTMInactiveDesc", [sTMNames]),                                                                                                                                                                              
                    [oBundle.getText("troubleshootingTMInactiveStep1"),                                                                                                                                                                                        
                     oBundle.getText("troubleshootingTMInactiveStep2"),                                                                                                                                                                                        
                     oBundle.getText("troubleshootingTMInactiveStep3")]                                                                                                                                                                                        
                ), "analyzeAllUnauthorizedBtn", oBundle.getText("troubleshootingActionAnalyzeTMs"), aTMSavedRows, false));                                                                                                                                     
