        onDBSyncExport: function () {                                                                                                                                                                                                                          
            var oDbSyncModel = this.getModel("dbSyncModel");                                                                                                                                                                                                   
            var oModel = this.getModel("capabilitiesModel");                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            oDbSyncModel.setProperty("/exportBusy",         true);                                                                                                                                                                                             
            oDbSyncModel.setProperty("/exportStatusVisible", false);                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            oModel.callFunction("/export_excel", {                                                                                                                                                                                                             
                method: "POST",                                                                                                                                                                                                                                
                success: function (oData) {                                                                                                                                                                                                                    
                    oDbSyncModel.setProperty("/exportBusy", false);                                                                                                                                                                                            
                    var oResult = oData.export_excel || oData;                                                                                                                                                                                                 
                    var sBase64   = oResult.file_content || "";                                                                                                                                                                                                
                    var sFileName = oResult.file_name    || "CapabilityData.xlsx";                                                                                                                                                                             
                    var sMime     = oResult.mime_type    || "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";                                                                                                                               
                    var iRows     = oResult.rows_exported || 0;                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                    if (!sBase64) {                                                                                                                                                                                                                            
                        oDbSyncModel.setProperty("/exportStatusText",    this._fetchi18nText("dbSyncExportErrorEmpty"));                                                                                                                                       
                        oDbSyncModel.setProperty("/exportStatusType",    "Error");                                                                                                                                                                             
                        oDbSyncModel.setProperty("/exportStatusVisible", true);                                                                                                                                                                                
                        return;                                                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Convert Base64 to Blob and trigger download                                                                                                                                                                                             
                    var sBinary = atob(sBase64);                                                                                                                                                                                                               
                    var aBytes  = new Uint8Array(sBinary.length);                                                                                                                                                                                              
                    for (var i = 0; i < sBinary.length; i++) { aBytes[i] = sBinary.charCodeAt(i); }                                                                                                                                                            
                    var oBlob = new Blob([aBytes], { type: sMime });                                                                                                                                                                                           
                    var sUrl  = URL.createObjectURL(oBlob);                                                                                                                                                                                                    
                    var oLink = document.createElement("a");                                                                                                                                                                                                   
                    oLink.href     = sUrl;                                                                                                                                                                                                                     
                    oLink.download = sFileName;                                                                                                                                                                                                                
                    document.body.appendChild(oLink);                                                                                                                                                                                                          
                    oLink.click();                                                                                                                                                                                                                             
                    document.body.removeChild(oLink);                                                                                                                                                                                                          
                    URL.revokeObjectURL(sUrl);                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    oDbSyncModel.setProperty("/exportStatusText",    this._fetchi18nText("dbSyncExportSuccess", [iRows]));                                                                                                                                     
                    oDbSyncModel.setProperty("/exportStatusType",    "Success");                                                                                                                                                                               
                    oDbSyncModel.setProperty("/exportStatusVisible", true);                                                                                                                                                                                    
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oError) {                                                                                                                                                                                                                     
                    oDbSyncModel.setProperty("/exportBusy", false);                                                                                                                                                                                            
                    var sMsg = this._dbSyncExtractError(oError);                                                                                                                                                                                               
                    oDbSyncModel.setProperty("/exportStatusText",    this._fetchi18nText("dbSyncExportError", [sMsg]));                                                                                                                                        
                    oDbSyncModel.setProperty("/exportStatusType",    "Error");                                                                                                                                                                                 
                    oDbSyncModel.setProperty("/exportStatusVisible", true);                                                                                                                                                                                    
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onDBSyncFileChange: function (oEvent) {                                                                                                                                                                                                                
            var oUploader = oEvent.getSource();                                                                                                                                                                                                                
            var aFiles = oUploader.oFileUpload && oUploader.oFileUpload.files;                                                                                                                                                                                 
            if (aFiles && aFiles.length > 0) {                                                                                                                                                                                                                 
                this._dbSyncFile = aFiles[0];                                                                                                                                                                                                                  
                this.getModel("dbSyncModel").setProperty("/fileSelected", true);                                                                                                                                                                               
            } else {                                                                                                                                                                                                                                           
                this._dbSyncFile = null;                                                                                                                                                                                                                       
                this.getModel("dbSyncModel").setProperty("/fileSelected", false);                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onDBSyncImport: function () {                                                                                                                                                                                                                          
            if (!this._dbSyncFile) { return; }                                                                                                                                                                                                                 
            var oDbSyncModel = this.getModel("dbSyncModel");                                                                                                                                                                                                   
            var sFileName    = this._dbSyncFile.name;                                                                                                                                                                                                          
            var oReader      = new FileReader();                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            oDbSyncModel.setProperty("/statusText",    this._fetchi18nText("dbSyncStatusEncoding"));                                                                                                                                                           
            oDbSyncModel.setProperty("/statusType",    "None");                                                                                                                                                                                                
            oDbSyncModel.setProperty("/statusVisible", true);                                                                                                                                                                                                  
            oDbSyncModel.setProperty("/tableBusy",     false);                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            oReader.onload = function (oEvt) {                                                                                                                                                                                                                 
                var sDataUrl  = oEvt.target.result;                                                                                                                                                                                                            
                var sBase64   = sDataUrl.indexOf(";base64,") > -1                                                                                                                                                                                              
                    ? sDataUrl.split(";base64,")[1]                                                                                                                                                                                                            
                    : sDataUrl;                                                                                                                                                                                                                                
                oDbSyncModel.setProperty("/statusText", this._fetchi18nText("dbSyncStatusImporting"));                                                                                                                                                         
                this._dbSyncCallImport(sBase64, sFileName);                                                                                                                                                                                                    
            }.bind(this);                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            oReader.readAsDataURL(this._dbSyncFile);                                                                                                                                                                                                           
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _dbSyncCallImport: function (sBase64, sFileName) {                                                                                                                                                                                                     
            var oModel       = this.getModel("capabilitiesModel");                                                                                                                                                                                             
            var oDbSyncModel = this.getModel("dbSyncModel");                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            oModel.callFunction("/import_excel", {                                                                                                                                                                                                             
                method: "POST",                                                                                                                                                                                                                                
                urlParameters: {                                                                                                                                                                                                                               
                    file_content: sBase64,                                                                                                                                                                                                                     
                    file_name:    sFileName                                                                                                                                                                                                                    
                },                                                                                                                                                                                                                                             
                success: function () {                                                                                                                                                                                                                         
                    oDbSyncModel.setProperty("/statusText",    this._fetchi18nText("dbSyncStatusSuccess"));                                                                                                                                                    
                    oDbSyncModel.setProperty("/statusType",    "Success");                                                                                                                                                                                     
                    oDbSyncModel.setProperty("/statusVisible", true);                                                                                                                                                                                          
                    this._dbSyncRefreshLog();                                                                                                                                                                                                                  
                    var oUploader = sap.ui.getCore().byId("dbSyncFileUploader");                                                                                                                                                                               
                    if (oUploader) { oUploader.clear(); }                                                                                                                                                                                                      
                    oDbSyncModel.setProperty("/fileSelected", false);                                                                                                                                                                                          
                    this._dbSyncFile = null;                                                                                                                                                                                                                   
                    this._pendingCapabilitiesRefresh = true;                                                                                                                                                                                                   
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oError) {                                                                                                                                                                                                                     
                    var sMsg = this._dbSyncExtractError(oError);                                                                                                                                                                                               
                    oDbSyncModel.setProperty("/statusText",    this._fetchi18nText("dbSyncStatusError", [sMsg]));                                                                                                                                              
                    oDbSyncModel.setProperty("/statusType",    "Error");                                                                                                                                                                                       
                    oDbSyncModel.setProperty("/statusVisible", true);                                                                                                                                                                                          
                    this._dbSyncRefreshLog();                                                                                                                                                                                                                  
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _dbSyncRefreshLog: function () {                                                                                                                                                                                                                       
            var oTable = sap.ui.getCore().byId("dbSyncLogTable");                                                                                                                                                                                              
            if (oTable && oTable.getBinding("items")) {                                                                                                                                                                                                        
                oTable.getBinding("items").refresh();                                                                                                                                                                                                          
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _dbSyncExtractError: function (oError) {                                                                                                                                                                                                               
            try {                                                                                                                                                                                                                                              
                var oBody = JSON.parse(oError.responseText);                                                                                                                                                                                                   
                return oBody.error.message.value || oError.message;                                                                                                                                                                                            
            } catch (e) {                                                                                                                                                                                                                                      
                return oError.message || oError.statusText || "Unknown error";                                                                                                                                                                                 
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
