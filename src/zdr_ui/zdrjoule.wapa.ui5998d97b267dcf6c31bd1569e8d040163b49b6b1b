                            { label: "Role Name",      property: "RoleName",      width: 30 },                                                                                                                                                                 
                            { label: "Wildcard Auth",  property: "WildcardAuth",  width: 15 },                                                                                                                                                                 
                            { label: "Composite Role", property: "CompositeRole", width: 30 }                                                                                                                                                                  
                        ]                                                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                oSheet.build().finally(function () { oSheet.destroy(); });                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
