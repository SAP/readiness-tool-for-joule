        onPressCRAUpload: function () {                                                                                                                                                                                                                        
            if (!this._craUploadFile) { return; }                                                                                                                                                                                                              
            var oThis   = this;                                                                                                                                                                                                                                
            var oFile   = this._craUploadFile;                                                                                                                                                                                                                 
            var oReader = new FileReader();                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            oReader.onload = function (oEvt) {                                                                                                                                                                                                                 
                var sDataUrl = oEvt.target.result;                                                                                                                                                                                                             
                var sBase64  = sDataUrl.indexOf(";base64,") > -1                                                                                                                                                                                               
                    ? sDataUrl.split(";base64,")[1]                                                                                                                                                                                                            
                    : sDataUrl;                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                oThis.getModel("capabilitiesModel").callFunction("/UploadRolesFromExcel", {                                                                                                                                                                    
                    method: "POST",                                                                                                                                                                                                                            
                    urlParameters: {                                                                                                                                                                                                                           
                        FileName:    oFile.name,                                                                                                                                                                                                               
                        FileContent: sBase64                                                                                                                                                                                                                   
                    },                                                                                                                                                                                                                                         
                    success: function (oData) {                                                                                                                                                                                                                
                        var oResult        = oData.UploadRolesFromExcel || oData;                                                                                                                                                                              
                        var aImportedRoles = JSON.parse(oResult.RolesJson || "[]");                                                                                                                                                                            
                        var oCraModel      = oThis.getModel("craModel");                                                                                                                                                                                       
                        var aRoles         = oCraModel.getProperty("/roles");                                                                                                                                                                                  
                        var iAdded = 0, iSkipped = 0;                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                        aImportedRoles.forEach(function (r) {                                                                                                                                                                                                  
                            var sRoleName = (r.RoleName || r.ROLE_NAME || r.role_name || "").trim();                                                                                                                                                           
                            if (!sRoleName) { return; }                                                                                                                                                                                                        
                            var sKey = sRoleName.toUpperCase();                                                                                                                                                                                                
                            if (!aRoles.some(function (e) { return e.RoleName.toUpperCase() === sKey; })) {                                                                                                                                                    
                                aRoles.push({ RoleName: sRoleName, RoleDescription: r.RoleDescription || r.ROLE_DESCRIPTION || r.role_description || "" });                                                                                                    
                                iAdded++;                                                                                                                                                                                                                      
                            } else { iSkipped++; }                                                                                                                                                                                                             
                        });                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                        oCraModel.setProperty("/roles", aRoles);                                                                                                                                                                                               
                        oCraModel.setProperty("/roleCount", aRoles.length);                                                                                                                                                                                    
                        oThis._craRenderTokens();                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                        var iDuplicates = iSkipped + (parseInt(oResult.DuplicateCount, 10) || 0);                                                                                                                                                              
                        MessageToast.show(oThis._fetchi18nText("craUploadSuccess", [iAdded, iDuplicates]));                                                                                                                                                    
                                                                                                                                                                                                                                                               
                        var oUploader = sap.ui.getCore().byId("craFileUploader");                                                                                                                                                                              
                        if (oUploader) { oUploader.clear(); }                                                                                                                                                                                                  
                        oCraModel.setProperty("/fileSelected", false);                                                                                                                                                                                         
                        oThis._craUploadFile = null;                                                                                                                                                                                                           
                    },                                                                                                                                                                                                                                         
                    error: function () {                                                                                                                                                                                                                       
                        MessageToast.show(oThis._fetchi18nText("craUploadError"));                                                                                                                                                                             
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
            };                                                                                                                                                                                                                                                 
            oReader.readAsDataURL(oFile);                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onCRATokenDelete: function (oEvent) {                                                                                                                                                                                                                  
