        onCompareRolesSearch: function (oEvent) {                                                                                                                                                                                                              
            var sQuery   = (oEvent.getParameter("newValue") || "").toLowerCase().trim();                                                                                                                                                                       
            var oModel   = this.getModel("compareRolesModel");                                                                                                                                                                                                 
            var aAll     = oModel.getProperty("/allMergedRoles") || [];                                                                                                                                                                                        
            var aFiltered = sQuery                                                                                                                                                                                                                             
                ? aAll.filter(function (r) {                                                                                                                                                                                                                   
                    return (r.RoleName  || "").toLowerCase().includes(sQuery) ||                                                                                                                                                                               
                           (r.RoleText  || "").toLowerCase().includes(sQuery);                                                                                                                                                                                 
                  })                                                                                                                                                                                                                                           
                : aAll;                                                                                                                                                                                                                                        
            oModel.setProperty("/mergedRoles", aFiltered);                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // Thin wrappers — one per sortable column                                                                                                                                                                                                             
        onCompareRolesSortByRoleName: function () { this._compareRolesSort("RoleName"); },                                                                                                                                                                     
        onCompareRolesSortByS0:       function () { this._compareRolesSort("s0StatusText"); },                                                                                                                                                                 
        onCompareRolesSortByS1:       function () { this._compareRolesSort("s1StatusText"); },                                                                                                                                                                 
        onCompareRolesSortByS2:       function () { this._compareRolesSort("s2StatusText"); },                                                                                                                                                                 
                                                                                                                                                                                                                                                               
        _compareRolesSort: function (sSortKey) {                                                                                                                                                                                                               
            var oModel = this.getModel("compareRolesModel");                                                                                                                                                                                                   
            if (!oModel) { return; }                                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            // Toggle direction: if same key was last sorted ascending → switch to descending                                                                                                                                                                  
            var sCurrent    = oModel.getProperty("/sort/activeKey");                                                                                                                                                                                           
            var bDesc       = (sCurrent === sSortKey) ? !oModel.getProperty("/sort/" + sSortKey + "/desc") : false;                                                                                                                                            
                                                                                                                                                                                                                                                               
            // Reset all icons then set active                                                                                                                                                                                                                 
            ["RoleName", "s0StatusText", "s1StatusText", "s2StatusText"].forEach(function (k) {                                                                                                                                                                
                oModel.setProperty("/sort/" + k + "/icon", "sap-icon://sort");                                                                                                                                                                                 
                oModel.setProperty("/sort/" + k + "/desc", false);                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            oModel.setProperty("/sort/" + sSortKey + "/icon", bDesc ? "sap-icon://sort-descending" : "sap-icon://sort-ascending");                                                                                                                             
            oModel.setProperty("/sort/" + sSortKey + "/desc", bDesc);                                                                                                                                                                                          
            oModel.setProperty("/sort/activeKey", sSortKey);                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            var aAll = (oModel.getProperty("/allMergedRoles") || []).slice();                                                                                                                                                                                  
            aAll.sort(function (a, b) {                                                                                                                                                                                                                        
                var sA = (a[sSortKey] || "").toLowerCase();                                                                                                                                                                                                    
                var sB = (b[sSortKey] || "").toLowerCase();                                                                                                                                                                                                    
                if (sA < sB) { return bDesc ?  1 : -1; }                                                                                                                                                                                                       
                if (sA > sB) { return bDesc ? -1 :  1; }                                                                                                                                                                                                       
                return 0;                                                                                                                                                                                                                                      
            });                                                                                                                                                                                                                                                
            oModel.setProperty("/allMergedRoles", aAll);                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            // Re-apply current search filter                                                                                                                                                                                                                  
            var oSearch   = sap.ui.getCore().byId("compareRolesSearch");                                                                                                                                                                                       
            var sQuery    = oSearch ? (oSearch.getValue() || "").toLowerCase().trim() : "";                                                                                                                                                                    
            var aFiltered = sQuery                                                                                                                                                                                                                             
                ? aAll.filter(function (r) {                                                                                                                                                                                                                   
                    return (r.RoleName || "").toLowerCase().includes(sQuery) ||                                                                                                                                                                                
                           (r.RoleText || "").toLowerCase().includes(sQuery);                                                                                                                                                                                  
                  })                                                                                                                                                                                                                                           
                : aAll;                                                                                                                                                                                                                                        
            oModel.setProperty("/mergedRoles", aFiltered);                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _loadRolesFederation: function (oModel) {                                                                                                                                                                                                              
            var aSources     = this._rolesSourceRegistry;                                                                                                                                                                                                      
            var oBundle      = this.getModel("i18n").getResourceBundle();                                                                                                                                                                                      
            var oODataModel  = this.getModel("capabilitiesModel");                                                                                                                                                                                             
            var sContextUser = this.appConfigModel.getProperty("/selecteContextUserName") || "";                                                                                                                                                               
                                                                                                                                                                                                                                                               
            var oPrimary     = aSources[0];                                                                                                                                                                                                                    
            var aSecondaries = aSources.slice(1);                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            // ── Step 1: read primary source via _getEntitySPath (context-user aware) ──                                                                                                                                                                      
            var oPrimaryPath = this._getEntitySPath(ENTITY_USAGE[oPrimary.usagePattern], {});                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oODataModel.read(oPrimaryPath.path, {                                                                                                                                                                                                              
                filters: oPrimaryPath.filters,                                                                                                                                                                                                                 
                success: function (oData) {                                                                                                                                                                                                                    
                    var aResults = oData.results || [];                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    if (aResults.length === 0) {                                                                                                                                                                                                               
                        // Primary returned no roles — stop, show error                                                                                                                                                                                        
                        oModel.setProperty("/sources/0/state",       "Error");                                                                                                                                                                                 
                        oModel.setProperty("/sources/0/statusText",  oBundle.getText(oPrimary.noRolesKey));                                                                                                                                                    
                        oModel.setProperty("/sources/0/statusState", "Error");                                                                                                                                                                                 
                        oModel.setProperty("/hasError",  true);                                                                                                                                                                                                
                        oModel.setProperty("/errorText", oBundle.getText(oPrimary.noRolesKey));                                                                                                                                                                
                        oModel.setProperty("/busy",      false);                                                                                                                                                                                               
                        return;                                                                                                                                                                                                                                
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    // Primary succeeded — build role name set and text map                                                                                                                                                                                    
                    var aRoleTextMap = {};                                                                                                                                                                                                                     
                    var aPrimaryRoles = aResults.map(function (r) {                                                                                                                                                                                            
                        if (oPrimary.roleTextProp && r[oPrimary.roleTextProp]) {                                                                                                                                                                               
                            aRoleTextMap[r[oPrimary.roleNameProp]] = r[oPrimary.roleTextProp];                                                                                                                                                                 
                        }                                                                                                                                                                                                                                      
                        return r[oPrimary.roleNameProp];                                                                                                                                                                                                       
                    });                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                    oModel.setProperty("/sources/0/state",       "Success");                                                                                                                                                                                   
                    oModel.setProperty("/sources/0/statusText",  oBundle.getText(oPrimary.successKey, [aResults.length]));                                                                                                                                     
                    oModel.setProperty("/sources/0/statusState", "Success");                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                    // Pre-build merged rows from primary roles (col 0 always "Yes")                                                                                                                                                                           
                    var sPresent = oBundle.getText("compareRolesStatusYes");                                                                                                                                                                                   
                    var sMissing = oBundle.getText("compareRolesStatusNo");                                                                                                                                                                                    
                    var sNA      = oBundle.getText("compareRolesStatusNA");                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                    var aMerged = aPrimaryRoles.map(function (sRole) {                                                                                                                                                                                         
                        var oRow = { RoleName: sRole, RoleText: aRoleTextMap[sRole] || "" };                                                                                                                                                                   
                        oRow["s0StatusText"] = sPresent;                                                                                                                                                                                                       
                        oRow["s0State"]      = "Success";                                                                                                                                                                                                      
                        // Secondary columns start as "loading" — shown as None until resolved                                                                                                                                                                 
                        aSecondaries.forEach(function (oSec, j) {                                                                                                                                                                                              
                            oRow["s" + (j + 1) + "StatusText"] = "";                                                                                                                                                                                           
                            oRow["s" + (j + 1) + "State"]      = "None";                                                                                                                                                                                       
                        });                                                                                                                                                                                                                                    
                        return oRow;                                                                                                                                                                                                                           
                    });                                                                                                                                                                                                                                        
                    oModel.setProperty("/mergedRoles",    aMerged);                                                                                                                                                                                            
                    oModel.setProperty("/allMergedRoles", aMerged.slice());                                                                                                                                                                                    
                    oModel.setProperty("/primaryCount",   aMerged.length);                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                    // ── Step 2: read secondaries sequentially ────────────────                                                                                                                                                                               
                    var fnReadSecondary = function (iSecIdx) {                                                                                                                                                                                                 
                        if (iSecIdx >= aSecondaries.length) {                                                                                                                                                                                                  
                            oModel.setProperty("/busy",               false);                                                                                                                                                                                  
                            oModel.setProperty("/loadingStatusTitle", oBundle.getText("compareRolesLoadedStatus", [oModel.getProperty("/userName")]));                                                                                                         
                            return;                                                                                                                                                                                                                            
                        }                                                                                                                                                                                                                                      
                        var oSec     = aSecondaries[iSecIdx];                                                                                                                                                                                                  
                        var iColIdx  = iSecIdx + 1;                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                        // Signal "in progress" before firing the read                                                                                                                                                                                         
                        oModel.setProperty("/sources/" + iColIdx + "/state",       "None");                                                                                                                                                                    
                        oModel.setProperty("/sources/" + iColIdx + "/statusText",  oBundle.getText(oSec.busyKey));                                                                                                                                             
                        oModel.setProperty("/sources/" + iColIdx + "/statusState", "None");                                                                                                                                                                    
                                                                                                                                                                                                                                                               
                        var oSecPath = this._getEntitySPath(ENTITY_USAGE[oSec.usagePattern], {});                                                                                                                                                              
                        oODataModel.read(oSecPath.path, {                                                                                                                                                                                                      
                            filters: oSecPath.filters,                                                                                                                                                                                                         
                            success: function (oSecData) {                                                                                                                                                                                                     
                                var aSecNames = (oSecData.results || []).map(function (r) { return r[oSec.roleNameProp]; });                                                                                                                                   
                                var oSecSet   = {};                                                                                                                                                                                                            
                                aSecNames.forEach(function (s) { oSecSet[s] = true; });                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                                // Update only the relevant column for each row                                                                                                                                                                                
                                var iPrimaryCount = oModel.getProperty("/primaryCount");                                                                                                                                                                       
                                var aRows = oModel.getProperty("/mergedRoles");                                                                                                                                                                                
                                var iMatchCount = 0;                                                                                                                                                                                                           
                                aRows.forEach(function (oRow) {                                                                                                                                                                                                
                                    var bFound = !!oSecSet[oRow.RoleName];                                                                                                                                                                                     
                                    if (bFound) { iMatchCount++; }                                                                                                                                                                                             
                                    oRow["s" + iColIdx + "StatusText"] = bFound ? sPresent  : sMissing;                                                                                                                                                        
                                    oRow["s" + iColIdx + "State"]      = bFound ? "Success" : "Error";                                                                                                                                                         
                                });                                                                                                                                                                                                                            
                                oModel.setProperty("/mergedRoles", aRows);                                                                                                                                                                                     
                                // Also update allMergedRoles for search                                                                                                                                                                                       
                                var aAllRows = oModel.getProperty("/allMergedRoles");                                                                                                                                                                          
                                aAllRows.forEach(function (oRow) {                                                                                                                                                                                             
                                    var bFound = !!oSecSet[oRow.RoleName];                                                                                                                                                                                     
                                    oRow["s" + iColIdx + "StatusText"] = bFound ? sPresent  : sMissing;                                                                                                                                                        
                                    oRow["s" + iColIdx + "State"]      = bFound ? "Success" : "Error";                                                                                                                                                         
                                });                                                                                                                                                                                                                            
                                oModel.setProperty("/allMergedRoles", aAllRows);                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                                oModel.setProperty("/sources/" + iColIdx + "/state",       "Success");                                                                                                                                                         
                                oModel.setProperty("/sources/" + iColIdx + "/statusText",  oBundle.getText(oSec.exposureCountKey || "compareRolesExposureCountCDMV1", [iMatchCount]));                                                                         
                                oModel.setProperty("/sources/" + iColIdx + "/statusState", "Success");                                                                                                                                                         
                                                                                                                                                                                                                                                               
                                fnReadSecondary(iSecIdx + 1);                                                                                                                                                                                                  
                            },                                                                                                                                                                                                                                 
                            error: function () {                                                                                                                                                                                                               
                                // Secondary unreachable — mark column as neutral "—", continue                                                                                                                                                                
                                var aRows = oModel.getProperty("/mergedRoles");                                                                                                                                                                                
                                aRows.forEach(function (oRow) {                                                                                                                                                                                                
                                    oRow["s" + iColIdx + "StatusText"] = sNA;                                                                                                                                                                                  
                                    oRow["s" + iColIdx + "State"]      = "None";                                                                                                                                                                               
                                });                                                                                                                                                                                                                            
                                oModel.setProperty("/mergedRoles", aRows);                                                                                                                                                                                     
                                var aAllRows = oModel.getProperty("/allMergedRoles");                                                                                                                                                                          
                                aAllRows.forEach(function (oRow) {                                                                                                                                                                                             
                                    oRow["s" + iColIdx + "StatusText"] = sNA;                                                                                                                                                                                  
                                    oRow["s" + iColIdx + "State"]      = "None";                                                                                                                                                                               
                                });                                                                                                                                                                                                                            
                                oModel.setProperty("/allMergedRoles", aAllRows);                                                                                                                                                                               
                                oModel.setProperty("/sources/" + iColIdx + "/state",       "Error");                                                                                                                                                           
                                oModel.setProperty("/sources/" + iColIdx + "/statusText",  oBundle.getText(oSec.errorKey));                                                                                                                                    
                                oModel.setProperty("/sources/" + iColIdx + "/statusState", "Error");                                                                                                                                                           
                                fnReadSecondary(iSecIdx + 1);                                                                                                                                                                                                  
                            }                                                                                                                                                                                                                                  
                        });                                                                                                                                                                                                                                    
                    }.bind(this);                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                    fnReadSecondary(0);                                                                                                                                                                                                                        
                }.bind(this),                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                error: function () {                                                                                                                                                                                                                           
                    oModel.setProperty("/sources/0/state",       "Error");                                                                                                                                                                                     
                    oModel.setProperty("/sources/0/statusText",  oBundle.getText(oPrimary.errorKey));                                                                                                                                                          
                    oModel.setProperty("/sources/0/statusState", "Error");                                                                                                                                                                                     
                    oModel.setProperty("/hasError",  true);                                                                                                                                                                                                    
                    oModel.setProperty("/errorText", oBundle.getText(oPrimary.errorKey));                                                                                                                                                                      
                    oModel.setProperty("/busy",      false);                                                                                                                                                                                                   
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
