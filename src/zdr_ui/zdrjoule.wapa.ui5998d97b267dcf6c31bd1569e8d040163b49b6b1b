                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        // Safety guard: never follow the same continuation twice                                                                                                                                                                              
                        if (mSeenNext[oData.__next]) {                                                                                                                                                                                                         
                            fnFail();                                                                                                                                                                                                                          
