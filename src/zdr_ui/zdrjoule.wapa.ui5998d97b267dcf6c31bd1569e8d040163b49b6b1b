        _getJouleWebClientURL: function () {                                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 1: Check if window exists                                                                                                                                                                                                                  
            // ---------------------------------------------------------------------                                                                                                                                                                           
            if (typeof window === "undefined") {                                                                                                                                                                                                               
                console.warn("Window object is not available.");                                                                                                                                                                                               
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 2: Read sap-ushell-config safely                                                                                                                                                                                                           
            // ---------------------------------------------------------------------                                                                                                                                                                           
            var oUshellConfig = window["sap-ushell-config"];                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            if (!oUshellConfig || typeof oUshellConfig !== "object") {                                                                                                                                                                                         
                console.warn("sap-ushell-config is missing or invalid.");                                                                                                                                                                                      
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 3: Check bootstrapPlugins object                                                                                                                                                                                                           
            // ---------------------------------------------------------------------                                                                                                                                                                           
            var oBootstrapPlugins = oUshellConfig.bootstrapPlugins;                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
            if (!oBootstrapPlugins || typeof oBootstrapPlugins !== "object") {                                                                                                                                                                                 
                console.warn("bootstrapPlugins is missing or invalid.");                                                                                                                                                                                       
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 4: Loop through all plugins                                                                                                                                                                                                                
            // ---------------------------------------------------------------------                                                                                                                                                                           
            for (var sPluginKey in oBootstrapPlugins) {                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                // Ensure property belongs directly to object                                                                                                                                                                                                  
                if (!Object.prototype.hasOwnProperty.call(oBootstrapPlugins, sPluginKey)) {                                                                                                                                                                    
                    continue;                                                                                                                                                                                                                                  
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                var oPlugin = oBootstrapPlugins[sPluginKey];                                                                                                                                                                                                   
                                                                                                                                                                                                                                                               
                // Validate plugin object                                                                                                                                                                                                                      
                if (!oPlugin || typeof oPlugin !== "object") {                                                                                                                                                                                                 
                    continue;                                                                                                                                                                                                                                  
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                // -----------------------------------------------------------------                                                                                                                                                                           
                // Step 5: Check component field safely                                                                                                                                                                                                        
                // -----------------------------------------------------------------                                                                                                                                                                           
                if (                                                                                                                                                                                                                                           
                    typeof oPlugin.component === "string" &&                                                                                                                                                                                                   
                    oPlugin.component === "sap.das.webclientplugin.s4"                                                                                                                                                                                         
                ) {                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                    // -------------------------------------------------------------                                                                                                                                                                           
                    // Step 6: Return URL safely if available                                                                                                                                                                                                  
                    // -------------------------------------------------------------                                                                                                                                                                           
                    if (                                                                                                                                                                                                                                       
                        typeof oPlugin.url === "string" &&                                                                                                                                                                                                     
                        oPlugin.url.trim() !== ""                                                                                                                                                                                                              
                    ) {                                                                                                                                                                                                                                        
                        return oPlugin.url;                                                                                                                                                                                                                    
                    }                                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
                    console.warn("Matching plugin found but URL is missing.");                                                                                                                                                                                 
                    return null;                                                                                                                                                                                                                               
                }                                                                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // ---------------------------------------------------------------------                                                                                                                                                                           
            // Step 7: Plugin not found                                                                                                                                                                                                                        
            // ---------------------------------------------------------------------                                                                                                                                                                           
            console.warn("Plugin sap.das.webclientplugin.s4 not found.");                                                                                                                                                                                      
            return null;                                                                                                                                                                                                                                       
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _getBootstrapJsUrl: function (sInputUrl) {                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            // Validate input                                                                                                                                                                                                                                  
            // -----------------------------------------------------------------                                                                                                                                                                               
            if (                                                                                                                                                                                                                                               
                typeof sInputUrl !== "string" ||                                                                                                                                                                                                               
                sInputUrl.trim() === ""                                                                                                                                                                                                                        
            ) {                                                                                                                                                                                                                                                
                console.warn("Invalid input URL.");                                                                                                                                                                                                            
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // Remove trailing spaces                                                                                                                                                                                                                          
            var sUrl = sInputUrl.trim();                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            // Check whether URL ends with "/s4"                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            if (!sUrl.endsWith("/s4")) {                                                                                                                                                                                                                       
                console.warn("URL does not end with '/s4'.");                                                                                                                                                                                                  
                return null;                                                                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // -----------------------------------------------------------------                                                                                                                                                                               
            // Replace "/s4" with "/bootstrap.js"                                                                                                                                                                                                              
            // -----------------------------------------------------------------                                                                                                                                                                               
            var sBootstrapUrl = sUrl.replace(/\/s4$/, "/bootstrap.js");                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
            return sBootstrapUrl;                                                                                                                                                                                                                              
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _openJouleWebServiceSocket: function (webClientUrl) {                                                                                                                                                                                                  
            if (!webClientUrl || typeof webClientUrl !== "string") {                                                                                                                                                                                           
                console.log("Web client URL is not available. Cannot open WebSocket.");                                                                                                                                                                        
                return;                                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // Extract origin                                                                                                                                                                                                                                  
            const url = new URL(webClientUrl);                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Build websocket endpoint                                                                                                                                                                                                                        
            const wsUrl =                                                                                                                                                                                                                                      
                `wss://${url.host}/api/protected/connect-ws/clientapi/ws`;                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
            console.log("Opening WebSocket:", wsUrl);                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            // Create socket                                                                                                                                                                                                                                   
            const socket = new WebSocket(wsUrl);                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
            // Optional event handlers                                                                                                                                                                                                                         
            socket.onopen = function () {                                                                                                                                                                                                                      
                console.log("WebSocket connected");                                                                                                                                                                                                            
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            socket.onmessage = function (event) {                                                                                                                                                                                                              
                console.log("Message received:", event.data);                                                                                                                                                                                                  
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            socket.onerror = function (error) {                                                                                                                                                                                                                
                console.error("WebSocket error:", error);                                                                                                                                                                                                      
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            socket.onclose = function (event) {                                                                                                                                                                                                                
                console.log("WebSocket closed:", event.code, event.reason);                                                                                                                                                                                    
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            return socket;                                                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _sendToDrJoule: async function (text) {                                                                                                                                                                                                                
