        _loadScenarioDetail: function (sCapabilityName, sScenarioName, sDescription, sHealth) {                                                                                                                                                                
            this._sCurrentDetailCapability = sCapabilityName;                                                                                                                                                                                                  
            this._sCurrentDetailScenario   = sScenarioName;                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            var oTitle    = sap.ui.getCore().byId("scenarioDetailTitle");                                                                                                                                                                                      
            var oSubtitle = sap.ui.getCore().byId("scenarioDetailSubtitle");                                                                                                                                                                                   
            var oStatus   = sap.ui.getCore().byId("scenarioDetailStatus");                                                                                                                                                                                     
            if (oTitle)    { oTitle.setText(sScenarioName); }                                                                                                                                                                                                  
            if (oSubtitle) { oSubtitle.setText(sDescription); }                                                                                                                                                                                                
            if (oStatus) {                                                                                                                                                                                                                                     
                oStatus.setText(this.formatter.formatHealthText(sHealth));                                                                                                                                                                                     
                oStatus.setState(this.formatter.formatHealthState(sHealth));                                                                                                                                                                                   
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var oModel = this.getModel("capabilitiesModel");                                                                                                                                                                                                   
            var oScenParams = { CapabilityName: sCapabilityName, ScenarioName: sScenarioName };                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var oDetailModel = new JSONModel({                                                                                                                                                                                                                 
                APIs: [], TMs: [],                                                                                                                                                                                                                             
                OverallStatus: "", OverallStatusState: "None", OverallStatusStateRaw: "",                                                                                                                                                                      
                ODataServicesTotal: 0, ODataServicesActive: 0, ODataServicesInactive: 0,                                                                                                                                                                       
                ODataServicesAuthorized: 0, ODataServicesUnauthorized: 0,                                                                                                                                                                                      
                SAPUI5TMsTotal: 0, SAPUI5TMsActive: 0, SAPUI5TMsInactive: 0,                                                                                                                                                                                   
                SAPUI5TMsAuthorized: 0, SAPUI5TMsUnauthorized: 0,                                                                                                                                                                                              
                ActSummaryState: "", ActSummary: "", ActSummaryDescription: "", ActSummaryPercentage: 0,                                                                                                                                                       
                AuthSummaryState: "", AuthSummary: "", AuthSummaryDescription: "", AuthSummaryPercentage: 0,                                                                                                                                                   
                HasUnauthorizedTMs: false,                                                                                                                                                                                                                     
                HasUnauthorizedAPIs: false,                                                                                                                                                                                                                    
                HasTroubleshootingItems: false,                                                                                                                                                                                                                
                TMOperatorVisible: false,                                                                                                                                                                                                                      
                TMOperatorText: ""                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
            this.setModel(oDetailModel, "scenarioDetailModel");                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // navigate first, then show busy on the new page                                                                                                                                                                                                  
            var oNavContainer = sap.ui.getCore().byId("capabilityNav");                                                                                                                                                                                        
            oNavContainer.to(sap.ui.getCore().byId("pageScenarioDetail"));                                                                                                                                                                                     
            this.appConfigModel.setProperty("/switchUserEnabled", false);                                                                                                                                                                                      
            if (this.oDialog) { this.oDialog.setBusy(true); }                                                                                                                                                                                                  
            this._showCapabilitiesBusy(0, this._fetchi18nText("msgLoadingScenarioDetailTitle"), this._fetchi18nText("msgLoadingScenarioDetail", [sScenarioName]));                                                                                             
                                                                                                                                                                                                                                                               
            // counter: clear busy only after all 3 reads finish                                                                                                                                                                                               
            var iPending = 3;                                                                                                                                                                                                                                  
            var fnDone = function () {                                                                                                                                                                                                                         
                iPending--;                                                                                                                                                                                                                                    
                if (iPending === 0) {                                                                                                                                                                                                                          
                    var aAPIs = oDetailModel.getProperty("/APIs") || [];                                                                                                                                                                                       
                    var aTMs  = oDetailModel.getProperty("/TMs")  || [];                                                                                                                                                                                       
