        onExportScenarioDetail: function () {                                                                                                                                                                                                                  
            var oModel = this.getModel("scenarioDetailModel");                                                                                                                                                                                                 
            if (!oModel) { return; }                                                                                                                                                                                                                           
            var oData        = oModel.getData();                                                                                                                                                                                                               
            var sScenId      = this._sCurrentDetailScenario   || "";                                                                                                                                                                                           
            var sCapability  = this._sCurrentDetailCapability || "";                                                                                                                                                                                           
            var oSubtitle    = sap.ui.getCore().byId("scenarioDetailSubtitle");                                                                                                                                                                                
            var sDescription = oSubtitle ? oSubtitle.getText() : "";                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            var fnHealth = function (s) {                                                                                                                                                                                                                      
                return s === "S" ? "Success" : s === "W" ? "Warning" : s === "E" ? "Error" : (s || "");                                                                                                                                                        
            };                                                                                                                                                                                                                                                 
            var fnStatus = function (s) {                                                                                                                                                                                                                      
                return s === "S" ? "Active" : s === "W" ? "Warning" : s === "E" ? "Inactive" : (s || "");                                                                                                                                                      
            };                                                                                                                                                                                                                                                 
            var fnAuth = function (s) {                                                                                                                                                                                                                        
                return s === "S" ? "Authorized" : s === "W" ? "Partial" : s === "E" ? "No Authorization" : (s || "");                                                                                                                                          
            };                                                                                                                                                                                                                                                 
            var fnFrac = function (a, t) {                                                                                                                                                                                                                     
                return (a || 0) + " of " + (t || 0);                                                                                                                                                                                                           
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            // Derive authorized counts from the arrays (top-level may not carry them)                                                                                                                                                                         
            var iODataAuth = (oData.APIs || []).filter(function (o) { return o.AuthorizationStatus === "S"; }).length;                                                                                                                                         
            var iTMAuth    = (oData.TMs  || []).filter(function (o) { return o.AuthorizationStatus === "S"; }).length;                                                                                                                                         
                                                                                                                                                                                                                                                               
            var aRows = [];                                                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            // ── Summary section ─────────────────────────────────────────────────                                                                                                                                                                            
            aRows.push({ Section: "Summary", Name: "Scenario ID",           Detail: sScenId,       Info: "" });                                                                                                                                                
            aRows.push({ Section: "Summary", Name: "Description",           Detail: sDescription,  Info: "" });                                                                                                                                                
            aRows.push({ Section: "Summary", Name: "Capability",            Detail: sCapability,   Info: "" });                                                                                                                                                
            aRows.push({ Section: "Summary", Name: "Overall Status",        Detail: fnHealth(oData.OverallStatus),                                         Info: "" });                                                                                        
            aRows.push({ Section: "Summary", Name: "OData Services Active", Detail: fnFrac(oData.ODataServicesActive, oData.ODataServicesTotal) + " active",  Info: fnFrac(iODataAuth,             oData.ODataServicesTotal) + " authorized" });               
            aRows.push({ Section: "Summary", Name: "SAPUI5 Apps Active",    Detail: fnFrac(oData.SAPUI5TMsActive,    oData.SAPUI5TMsTotal)     + " active",  Info: fnFrac(iTMAuth,                oData.SAPUI5TMsTotal)     + " authorized" });                
                                                                                                                                                                                                                                                               
            // ── OData APIs ───────────────────────────────────────────────────────                                                                                                                                                                           
            (oData.APIs || []).forEach(function (o) {                                                                                                                                                                                                          
                aRows.push({                                                                                                                                                                                                                                   
                    Section: "OData API",                                                                                                                                                                                                                      
                    Name:    o.OdataServiceName || "",                                                                                                                                                                                                         
                    Detail:  o.Namespace        || "",                                                                                                                                                                                                         
                    Info:    o.ApiVersion       || "",                                                                                                                                                                                                         
                    Status:  fnStatus(o.ActivationStatus),                                                                                                                                                                                                     
                    Auth:    fnAuth(o.AuthorizationStatus)                                                                                                                                                                                                     
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // ── SAPUI5 Apps (Target Mappings) ────────────────────────────────────                                                                                                                                                                           
            (oData.TMs || []).forEach(function (o) {                                                                                                                                                                                                           
                var sIntent = (o.SemanticObject && o.SemanticAction)                                                                                                                                                                                           
                    ? o.SemanticObject + "-" + o.SemanticAction                                                                                                                                                                                                
                    : (o.SemanticObject || "");                                                                                                                                                                                                                
                aRows.push({                                                                                                                                                                                                                                   
                    Section: "SAPUI5 App",                                                                                                                                                                                                                     
                    Name:    o.FioriAppName || "",                                                                                                                                                                                                             
                    Detail:  sIntent,                                                                                                                                                                                                                          
                    Info:    o.CatalogID   || "",                                                                                                                                                                                                              
                    Status:  fnStatus(o.ActivationStatus),                                                                                                                                                                                                     
                    Auth:    fnAuth(o.AuthorizationStatus)                                                                                                                                                                                                     
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var sSafe = sScenId.replace(/[^a-zA-Z0-9_-]/g, "_");                                                                                                                                                                                               
            sap.ui.require(["sap/ui/export/Spreadsheet"], function (Spreadsheet) {                                                                                                                                                                             
                var oSheet = new Spreadsheet({                                                                                                                                                                                                                 
                    worker:     false,                                                                                                                                                                                                                         
                    dataSource: aRows,                                                                                                                                                                                                                         
                    fileName:   "ScenarioDetail" + (sSafe ? "_" + sSafe : "") + ".xlsx",                                                                                                                                                                       
                    workbook: {                                                                                                                                                                                                                                
                        context: {                                                                                                                                                                                                                             
                            title:    sScenId + (sDescription ? " — " + sDescription : ""),                                                                                                                                                                    
                            sheetName: "Scenario Detail"                                                                                                                                                                                                       
                        },                                                                                                                                                                                                                                     
                        columns: [                                                                                                                                                                                                                             
                            { label: "Section",               property: "Section", width: 15 },                                                                                                                                                                
                            { label: "Name",                  property: "Name",    width: 45 },                                                                                                                                                                
                            { label: "Namespace / Intent",    property: "Detail",  width: 35 },                                                                                                                                                                
                            { label: "Version / Catalog ID",  property: "Info",    width: 22 },                                                                                                                                                                
                            { label: "Status",                property: "Status",  width: 15 },                                                                                                                                                                
                            { label: "Authorization",         property: "Auth",    width: 20 }                                                                                                                                                                 
                        ]                                                                                                                                                                                                                                      
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                oSheet.build().finally(function () { oSheet.destroy(); });                                                                                                                                                                                     
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
