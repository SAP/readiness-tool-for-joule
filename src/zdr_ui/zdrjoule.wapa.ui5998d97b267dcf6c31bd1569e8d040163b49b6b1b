                    oDetailModel.setProperty("/AuthSummaryPercentage",      oRow.AuthSummaryPercentage || 0);                                                                                                                                                  
                    fnDone();                                                                                                                                                                                                                                  
                }.bind(this),                                                                                                                                                                                                                                  
                error: function (oErr) { console.error("ScenarioHealth read failed", oErr); fnDone(); }                                                                                                                                                        
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var oAPIsPath = this._getEntitySPath(ENTITY_USAGE.FETCH_SCENARIO_APIS, oScenParams);                                                                                                                                                               
            oModel.read(oAPIsPath.path, {                                                                                                                                                                                                                      
                filters: oAPIsPath.filters,                                                                                                                                                                                                                    
                success: function (oData) {                                                                                                                                                                                                                    
                    var aAPIs = oData.results || [];                                                                                                                                                                                                           
                    oDetailModel.setProperty("/APIs", aAPIs);                                                                                                                                                                                                  
                    oDetailModel.setProperty("/HasUnauthorizedAPIs",                                                                                                                                                                                           
                        aAPIs.some(function (r) { return r.AuthorizationStatus === "E"; })                                                                                                                                                                     
                    );                                                                                                                                                                                                                                         
                    fnDone();                                                                                                                                                                                                                                  
                },                                                                                                                                                                                                                                             
                error: function (oErr) { console.error("to_APIs failed", oErr); fnDone(); }                                                                                                                                                                    
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var oTMsPath = this._getEntitySPath(ENTITY_USAGE.FETCH_SCENARIO_TMS, oScenParams);                                                                                                                                                                 
            oModel.read(oTMsPath.path, {                                                                                                                                                                                                                       
