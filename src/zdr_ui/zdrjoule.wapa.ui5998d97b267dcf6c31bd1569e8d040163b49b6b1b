                fnInitModel(sContextUser, sContextEmail);                                                                                                                                                                                                      
            } else {                                                                                                                                                                                                                                           
                // No context user — resolve current logged-on user from /Users?$filter=CurrentUser eq true                                                                                                                                                    
                var oODataModel = this.getModel("capabilitiesModel");                                                                                                                                                                                          
                oODataModel.read("/Users", {                                                                                                                                                                                                                   
                    filters: [new Filter("CurrentUser", FilterOperator.EQ, true)],                                                                                                                                                                             
                    success: function (oData) {                                                                                                                                                                                                                
                        var oUser  = (oData.results || [])[0] || {};                                                                                                                                                                                           
                        var sName  = oUser.UserName     || oBundle.getText("compareRolesCurrentUser");                                                                                                                                                         
                        var sEmail = oUser.EmailAddress || "";                                                                                                                                                                                                 
                        fnInitModel(sName, sEmail);                                                                                                                                                                                                            
                    },                                                                                                                                                                                                                                         
                    error: function () {                                                                                                                                                                                                                       
                        fnInitModel(oBundle.getText("compareRolesCurrentUser"), "");                                                                                                                                                                           
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
