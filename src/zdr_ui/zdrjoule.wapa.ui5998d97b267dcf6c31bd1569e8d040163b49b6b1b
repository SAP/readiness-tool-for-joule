        _craLoadAnalysisResults: function (sAnalysisUUID, aPersistedRoles, iGen, sExpectedUUID, iExpectedResultCount) {                                                                                                                                        
            var oThis        = this;                                                                                                                                                                                                                           
            var oCraModel    = this.getModel("craModel");                                                                                                                                                                                                      
            var oModel       = this.getModel("capabilitiesModel");                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            function fnIsCurrentLoad() {                                                                                                                                                                                                                       
                var oSelected = oCraModel.getProperty("/selectedAnalysis");                                                                                                                                                                                    
                return oThis._craResultLoadGen === iGen &&                                                                                                                                                                                                     
                    !!oSelected &&                                                                                                                                                                                                                             
                    oSelected.AnalysisUUID === sExpectedUUID;                                                                                                                                                                                                  
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oCraModel.setProperty("/results",     []);                                                                                                                                                                                                         
            oCraModel.setProperty("/resultCount", 0);                                                                                                                                                                                                          
            oCraModel.setProperty("/matrix",      null);                                                                                                                                                                                                       
            oCraModel.setProperty("/coverageStats",       { full: 0, partial: 0, none: 0 });                                                                                                                                                                   
            oCraModel.setProperty("/resultLoading",      true);                                                                                                                                                                                                
            oCraModel.setProperty("/resultLoadProgress", 0);                                                                                                                                                                                                   
            oCraModel.setProperty("/resultLoadText",     "");                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            var sKey         = oModel.createKey("CustomRoleAnalyses", {                                                                                                                                                                                        
                AnalysisUUID: sAnalysisUUID                                                                                                                                                                                                                    
            });                                                                                                                                                                                                                                                
            var sPath        = "/" + sKey + "/to_Results";                                                                                                                                                                                                     
            var aAccumulated = [];                                                                                                                                                                                                                             
            var mSeenNext    = {};                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
            function fnGetNextParameters(sNextUrl) {                                                                                                                                                                                                           
                var mParameters = {};                                                                                                                                                                                                                          
                var iQueryStart = sNextUrl.indexOf("?");                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
                if (iQueryStart < 0) {                                                                                                                                                                                                                         
                    return mParameters;                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                var oParams = new URLSearchParams(                                                                                                                                                                                                             
                    sNextUrl.substring(iQueryStart + 1)                                                                                                                                                                                                        
                );                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                oParams.forEach(function (sValue, sName) {                                                                                                                                                                                                     
                    // sap-client is already handled by the OData model                                                                                                                                                                                        
                    if (sName !== "sap-client") {                                                                                                                                                                                                              
                        mParameters[sName] = sValue;                                                                                                                                                                                                           
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                return mParameters;                                                                                                                                                                                                                            
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            function fnFail() {                                                                                                                                                                                                                                
                if (!fnIsCurrentLoad()) { return; }                                                                                                                                                                                                            
                oCraModel.setProperty("/results",     []);                                                                                                                                                                                                     
                oCraModel.setProperty("/resultCount", 0);                                                                                                                                                                                                      
                oCraModel.setProperty("/matrix",      null);                                                                                                                                                                                                   
                oCraModel.setProperty("/detailBusy",  false);                                                                                                                                                                                                  
                oCraModel.setProperty("/resultLoading",      false);                                                                                                                                                                                           
                oCraModel.setProperty("/resultLoadProgress", 0);                                                                                                                                                                                               
                oCraModel.setProperty("/resultLoadText",     "");                                                                                                                                                                                              
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            function fnReadPage(mUrlParameters) {                                                                                                                                                                                                              
                var mReadParameters = {                                                                                                                                                                                                                        
                    success: function (oData) {                                                                                                                                                                                                                
                        if (!fnIsCurrentLoad()) { return; }                                                                                                                                                                                                    
                        aAccumulated = aAccumulated.concat(                                                                                                                                                                                                    
                            oData.results || []                                                                                                                                                                                                                
                        );                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                        var iTotal  = iExpectedResultCount;                                                                                                                                                                                                    
                        var iLoaded = aAccumulated.length;                                                                                                                                                                                                     
                        if (iTotal > 0 && iLoaded > iTotal) { return; }                                                                                                                                                                                        
                        oCraModel.setProperty("/resultLoadProgress",                                                                                                                                                                                           
                            iTotal > 0 ? Math.min(100, Math.round((iLoaded / iTotal) * 100)) : 0);                                                                                                                                                             
                        oCraModel.setProperty("/resultLoadText",                                                                                                                                                                                               
                            iTotal > 0                                                                                                                                                                                                                         
                                ? oThis._fetchi18nText("craResultLoadCount",                                                                                                                                                                                   
                                    [iLoaded.toLocaleString(), iTotal.toLocaleString()])                                                                                                                                                                       
                                : "");                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                        if (!oData.__next) {                                                                                                                                                                                                                   
                            oCraModel.setProperty("/resultLoadProgress", 100);                                                                                                                                                                                 
                            oCraModel.setProperty("/resultLoadText",                                                                                                                                                                                           
                                oThis._fetchi18nText("craResultLoadingPreparing"));                                                                                                                                                                            
                            oCraModel.setProperty("/results",     aAccumulated);                                                                                                                                                                               
                            oCraModel.setProperty("/resultCount", aAccumulated.length);                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                            // Coverage statistics from raw results (no enrichment needed)                                                                                                                                                                     
                            var oCovStats = { full: 0, partial: 0, none: 0 };                                                                                                                                                                                  
                            aAccumulated.forEach(function (r) {                                                                                                                                                                                                
                                if      (r.Coverage === "FULL")    { oCovStats.full++; }                                                                                                                                                                       
                                else if (r.Coverage === "PARTIAL") { oCovStats.partial++; }                                                                                                                                                                    
                                else if (r.Coverage === "NONE")    { oCovStats.none++; }                                                                                                                                                                       
                            });                                                                                                                                                                                                                                
                            oCraModel.setProperty("/coverageStats", oCovStats);                                                                                                                                                                                
                                                                                                                                                                                                                                                               
                            // ── Description enrichment (non-critical) ──────────                                                                                                                                                                             
                            var mRoleDescriptions    = {};                                                                                                                                                                                                     
                            var mScenDescriptions    = {};                                                                                                                                                                                                     
                            var mCapDescriptions     = {};                                                                                                                                                                                                     
                            var iPendingEnrichments  = 3;                                                                                                                                                                                                      
                            var bMatrixBuilt         = false;                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                            function fnBuildMatrix() {                                                                                                                                                                                                         
                                if (!fnIsCurrentLoad()) { return; }                                                                                                                                                                                            
                                var oMatrix = oThis._craBuildRoleScenarioMatrix(                                                                                                                                                                               
                                    aAccumulated,                                                                                                                                                                                                              
                                    aPersistedRoles || [],                                                                                                                                                                                                     
                                    mRoleDescriptions,                                                                                                                                                                                                         
