        _adjustTopCapabilitiesModel: function (aCapabilities) {                                                                                                                                                                                                
            var aTop5 = aCapabilities                                                                                                                                                                                                                          
                .filter(function (c) { return c.OverallHealth === "S"; })                                                                                                                                                                                      
                .sort(function (a, b) { return (b.ScenarioCount || 0) - (a.ScenarioCount || 0); })                                                                                                                                                             
                .slice(0, 5);                                                                                                                                                                                                                                  
            var oTop5Model = this.getModel("topCapabilitiesModel");                                                                                                                                                                                            
            if (!oTop5Model) {                                                                                                                                                                                                                                 
                oTop5Model = new JSONModel({ items: aTop5 });                                                                                                                                                                                                  
                this.setModel(oTop5Model, "topCapabilitiesModel");                                                                                                                                                                                             
            } else {                                                                                                                                                                                                                                           
                oTop5Model.setProperty("/items", aTop5);                                                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _adjustCapabilitySummaryModel: function (aCapabilities) {                                                                                                                                                                                              
            var stats = {                                                                                                                                                                                                                                      
                TotalCapabilities: 0,                                                                                                                                                                                                                          
                TotalSuccess: 0,                                                                                                                                                                                                                               
                TotalWarning: 0,                                                                                                                                                                                                                               
                TotalError: 0                                                                                                                                                                                                                                  
            };                                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
            stats.TotalCapabilities = aCapabilities.length;                                                                                                                                                                                                    
                                                                                                                                                                                                                                                               
            aCapabilities.forEach(capability => {                                                                                                                                                                                                              
                switch (capability.OverallHealth) {                                                                                                                                                                                                            
                    case "S":                                                                                                                                                                                                                                  
                        stats.TotalSuccess++;                                                                                                                                                                                                                  
                        break;                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    case "W":                                                                                                                                                                                                                                  
                        stats.TotalWarning++;                                                                                                                                                                                                                  
                        break;                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                    case "E":                                                                                                                                                                                                                                  
                        stats.TotalError++;                                                                                                                                                                                                                    
                        break;                                                                                                                                                                                                                                 
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            this.capabilitySummaryModel.setData(stats);                                                                                                                                                                                                        
            return stats;                                                                                                                                                                                                                                      
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
