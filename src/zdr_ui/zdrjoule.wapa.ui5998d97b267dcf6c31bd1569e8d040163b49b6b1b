        onAPIASaveSelection: function () {                                                                                                                                                                                                                     
            var oAPI  = this._apiaSelectedAPI;                                                                                                                                                                                                                 
            var oRole = this._apiaSelectedRole;                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            if (!oAPI)  { MessageToast.show(this._fetchi18nText("apiaMsgSelectAPIBeforeSave"));  return; }                                                                                                                                                     
            if (!oRole) { MessageToast.show(this._fetchi18nText("apiaMsgSelectBRBeforeSave")); return; }                                                                                                                                                       
                                                                                                                                                                                                                                                               
            var oComposite = this._apiaSelectedComposite || null;                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            // Dedup key: ApiName + ApiVersion + RoleName + CompositeRoleName                                                                                                                                                                                  
            var sKey = [                                                                                                                                                                                                                                       
                oAPI.ApiName,                                                                                                                                                                                                                                  
                oAPI.ApiVersion,                                                                                                                                                                                                                               
                oRole.RoleName,                                                                                                                                                                                                                                
                oComposite ? oComposite.CompositeRoleName : ""                                                                                                                                                                                                 
            ].join("|");                                                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            if (this._apiaSavedSelections.some(function (s) { return s.key === sKey; })) {                                                                                                                                                                     
                MessageToast.show(this._fetchi18nText("apiaMsgDuplicateSaved")); return;                                                                                                                                                                       
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            this._apiaSavedSelections.push({                                                                                                                                                                                                                   
                key:           sKey,                                                                                                                                                                                                                           
                api:           Object.assign({}, oAPI),                                                                                                                                                                                                        
                businessRole:  Object.assign({}, oRole),                                                                                                                                                                                                       
                compositeRole: oComposite ? Object.assign({}, oComposite) : null                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var oApiView = this.getModel("apiaApiView");                                                                                                                                                                                                       
            if (oApiView) { oApiView.setProperty("/savedCount", this._apiaSavedSelections.length); }                                                                                                                                                           
            MessageToast.show(oComposite                                                                                                                                                                                                                       
                ? this._fetchi18nText("apiaMsgSavedWithCR", [oAPI.ApiName, oRole.RoleName, oComposite.CompositeRoleName])                                                                                                                                      
                : this._fetchi18nText("apiaMsgSaved",       [oAPI.ApiName, oRole.RoleName]));                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onAPIADownloadExcel: function () {                                                                                                                                                                                                                     
