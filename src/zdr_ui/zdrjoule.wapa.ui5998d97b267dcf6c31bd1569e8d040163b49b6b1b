        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _craBuildCoverageMatrix: function (aResults, aSelectedRoles) {                                                                                                                                                                                         
            // 1. role column order from canonical selected-roles list                                                                                                                                                                                         
            var aRoles = (aSelectedRoles || []).map(function (r) {                                                                                                                                                                                             
                return r.RoleName;                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 2. unique scenarios sorted by CapabilityName, ScenarioName                                                                                                                                                                                      
            var mScenSeen  = {};                                                                                                                                                                                                                               
            var aScenarios = [];                                                                                                                                                                                                                               
            aResults.forEach(function (r) {                                                                                                                                                                                                                    
                var sKey = r.CapabilityName + "\x00" + r.ScenarioName;                                                                                                                                                                                         
                if (!mScenSeen[sKey]) {                                                                                                                                                                                                                        
                    mScenSeen[sKey] = true;                                                                                                                                                                                                                    
                    aScenarios.push({ CapabilityName: r.CapabilityName, ScenarioName: r.ScenarioName });                                                                                                                                                       
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
            aScenarios.sort(function (a, b) {                                                                                                                                                                                                                  
                if (a.CapabilityName !== b.CapabilityName) {                                                                                                                                                                                                   
                    return a.CapabilityName < b.CapabilityName ? -1 : 1;                                                                                                                                                                                       
                }                                                                                                                                                                                                                                              
                return a.ScenarioName < b.ScenarioName ? -1 : 1;                                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 3. flat lookup: "RoleName\x00CapabilityName\x00ScenarioName" → result row                                                                                                                                                                       
            var mLookup = {};                                                                                                                                                                                                                                  
            aResults.forEach(function (r) {                                                                                                                                                                                                                    
                mLookup[r.RoleName + "\x00" + r.CapabilityName + "\x00" + r.ScenarioName] = r;                                                                                                                                                                 
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // 4. build matrix rows                                                                                                                                                                                                                            
            var aRows = aScenarios.map(function (oScen) {                                                                                                                                                                                                      
                var aCells = aRoles.map(function (sRole) {                                                                                                                                                                                                     
                    var oResult = mLookup[                                                                                                                                                                                                                     
                        sRole + "\x00" + oScen.CapabilityName + "\x00" + oScen.ScenarioName                                                                                                                                                                    
                    ];                                                                                                                                                                                                                                         
                    if (!oResult) { return null; }                                                                                                                                                                                                             
                    return {                                                                                                                                                                                                                                   
                        RoleName:    sRole,                                                                                                                                                                                                                    
                        Coverage:    oResult.Coverage,                                                                                                                                                                                                         
                        RequiredTM:  oResult.RequiredTM,                                                                                                                                                                                                       
                        CoveredTM:   oResult.CoveredTM,                                                                                                                                                                                                        
                        RequiredAPI: oResult.RequiredAPI,                                                                                                                                                                                                      
                        CoveredAPI:  oResult.CoveredAPI                                                                                                                                                                                                        
                    };                                                                                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                return {                                                                                                                                                                                                                                       
                    CapabilityName: oScen.CapabilityName,                                                                                                                                                                                                      
                    ScenarioName:   oScen.ScenarioName,                                                                                                                                                                                                        
                    cells:          aCells                                                                                                                                                                                                                     
                };                                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            return { roles: aRoles, rows: aRows };                                                                                                                                                                                                             
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _craUpdateMatrixColumns: function (aScenarios) {                                                                                                                                                                                                       
            var oThis     = this;                                                                                                                                                                                                                              
            var oTable    = sap.ui.getCore().byId("craMatrixTable");                                                                                                                                                                                           
            var oCraModel = this.getModel("craModel");                                                                                                                                                                                                         
            if (!oTable) { return; }                                                                                                                                                                                                                           
            var oMatrix = oCraModel.getProperty("/matrix");                                                                                                                                                                                                    
            if (!oMatrix) { return; }                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            var bShowIds = oCraModel.getProperty("/showTechnicalIds") || false;                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // Pre-build lookup: "cap\x00scen" → original index in full scenario array                                                                                                                                                                         
            var mScenIdx = {};                                                                                                                                                                                                                                 
            oMatrix.scenarios.forEach(function (oScen, i) {                                                                                                                                                                                                    
                mScenIdx[oScen.CapabilityName + "\x00" + oScen.ScenarioName] = i;                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // Remove all columns except the fixed Role column at index 0                                                                                                                                                                                      
            oTable.getColumns().slice(1).forEach(function (oCol) {                                                                                                                                                                                             
                oTable.removeColumn(oCol);                                                                                                                                                                                                                     
                oCol.destroy();                                                                                                                                                                                                                                
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var aScenariosToRender = aScenarios || oMatrix.scenarios;                                                                                                                                                                                          
            aScenariosToRender.forEach(function (oScen) {                                                                                                                                                                                                      
                var iOrigIdx = mScenIdx[oScen.CapabilityName + "\x00" + oScen.ScenarioName];                                                                                                                                                                   
                if (iOrigIdx === undefined) { return; }                                                                                                                                                                                                        
                                                                                                                                                                                                                                                               
                // Column header: two lines centered                                                                                                                                                                                                           
                // Line 1: Scenario — description-first with optional ID suffix                                                                                                                                                                                
                var sScenDisp = oScen.ScenarioDescription;                                                                                                                                                                                                     
                var sScenId   = oScen.ScenarioName;                                                                                                                                                                                                            
                var sScenLine;                                                                                                                                                                                                                                 
                if (!sScenDisp || sScenDisp === sScenId) {                                                                                                                                                                                                     
                    sScenLine = sScenId;                                                                                                                                                                                                                       
                } else {                                                                                                                                                                                                                                       
                    sScenLine = bShowIds ? sScenDisp + " (" + sScenId + ")" : sScenDisp;                                                                                                                                                                       
                }                                                                                                                                                                                                                                              
                var sScenTooltip = (sScenDisp && sScenDisp !== sScenId)                                                                                                                                                                                        
                    ? sScenDisp + " · " + sScenId                                                                                                                                                                                                              
                    : sScenId;                                                                                                                                                                                                                                 
                                                                                                                                                                                                                                                               
                // Line 2: Capability                                                                                                                                                                                                                          
                var sCapDisp = oScen.CapabilityDisplayName;                                                                                                                                                                                                    
                var sCapId   = oScen.CapabilityName;                                                                                                                                                                                                           
                var sCapLine;                                                                                                                                                                                                                                  
                if (!sCapDisp || sCapDisp === sCapId) {                                                                                                                                                                                                        
                    sCapLine = sCapId;                                                                                                                                                                                                                         
                } else {                                                                                                                                                                                                                                       
                    sCapLine = bShowIds ? sCapDisp + " (" + sCapId + ")" : sCapDisp;                                                                                                                                                                           
                }                                                                                                                                                                                                                                              
                var sCapTooltip = (sCapDisp && sCapDisp !== sCapId)                                                                                                                                                                                            
                    ? sCapDisp + " · " + sCapId                                                                                                                                                                                                                
                    : sCapId;                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
                var oColLabel = new sap.m.VBox({                                                                                                                                                                                                               
                    alignItems: "Center",                                                                                                                                                                                                                      
                    items: [                                                                                                                                                                                                                                   
                        new sap.m.Text({                                                                                                                                                                                                                       
                            text:     sScenLine,                                                                                                                                                                                                               
                            tooltip:  sScenTooltip,                                                                                                                                                                                                            
                            wrapping: false                                                                                                                                                                                                                    
                        }),                                                                                                                                                                                                                                    
                        new sap.m.Text({                                                                                                                                                                                                                       
                            text:     sCapLine,                                                                                                                                                                                                                
                            tooltip:  sCapTooltip,                                                                                                                                                                                                             
                            wrapping: false                                                                                                                                                                                                                    
                        })                                                                                                                                                                                                                                     
                    ]                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                // Cell line 1: clickable inverted ObjectStatus                                                                                                                                                                                                
                var oStatus = new sap.m.ObjectStatus({ inverted: false });                                                                                                                                                                                     
                oStatus.addStyleClass("craCellStatus");                                                                                                                                                                                                        
                oStatus.bindProperty("text", {                                                                                                                                                                                                                 
                    path:      "craModel>cells/" + iOrigIdx + "/Coverage",                                                                                                                                                                                     
                    formatter: function (v) {                                                                                                                                                                                                                  
                        if (v === "FULL")    { return "Covered"; }                                                                                                                                                                                             
                        if (v === "PARTIAL") { return "Partially Covered"; }                                                                                                                                                                                   
                        if (v === "NONE")    { return "Not Covered"; }                                                                                                                                                                                         
                        return "—";                                                                                                                                                                                                                            
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                oStatus.bindProperty("state", {                                                                                                                                                                                                                
                    path:      "craModel>cells/" + iOrigIdx + "/Coverage",                                                                                                                                                                                     
                    formatter: function (v) {                                                                                                                                                                                                                  
                        if (v === "FULL")    { return "Success"; }                                                                                                                                                                                             
                        if (v === "PARTIAL") { return "Warning"; }                                                                                                                                                                                             
                        if (v === "NONE")    { return "Error"; }                                                                                                                                                                                               
                        return "None";                                                                                                                                                                                                                         
                    }                                                                                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                oStatus.bindProperty("icon", {                                                                                                                                                                                                                 
