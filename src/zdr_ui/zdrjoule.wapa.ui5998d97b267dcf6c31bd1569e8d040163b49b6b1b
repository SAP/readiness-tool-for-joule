        _apiaLoadAPIs: function () {                                                                                                                                                                                                                           
            var oModel   = this.getModel("capabilitiesModel");                                                                                                                                                                                                 
            var aAPIs    = this._apiaAPIs;                                                                                                                                                                                                                     
            var oApiView = this.getModel("apiaApiView");                                                                                                                                                                                                       
                                                                                                                                                                                                                                                               
            oApiView.setData({ items: [], busy: true, noDataText: "", savedCount: this._apiaSavedSelections.length });                                                                                                                                         
            this._apiaUpdateCount("apiaApiCount", 0);                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            var aResults   = new Array(aAPIs.length);                                                                                                                                                                                                          
            var iReadsDone = 0;                                                                                                                                                                                                                                
            var bBatchDone = false;                                                                                                                                                                                                                            
            var sGroupId   = "apiaLoadGroup";                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oModel.setDeferredGroups(oModel.getDeferredGroups().concat([sGroupId]));                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            var fnTryMerge = function () {                                                                                                                                                                                                                     
                if (!bBatchDone || iReadsDone < aAPIs.length) { return; }                                                                                                                                                                                      
                var oSeen = {}, aMerged = [];                                                                                                                                                                                                                  
                aResults.forEach(function (aChunk) {                                                                                                                                                                                                           
                    (aChunk || []).forEach(function (r) {                                                                                                                                                                                                      
                        if (!oSeen[r.ApiName]) { oSeen[r.ApiName] = true; aMerged.push(r); }                                                                                                                                                                   
                    });                                                                                                                                                                                                                                        
                });                                                                                                                                                                                                                                            
                this._apiaAllApis = aMerged;                                                                                                                                                                                                                   
                oApiView.setData({ items: aMerged, busy: false, noDataText: this._fetchi18nText("apiaNoDataText"), savedCount: this._apiaSavedSelections.length });                                                                                            
                this._apiaUpdateCount("apiaApiCount", aMerged.length);                                                                                                                                                                                         
            }.bind(this);                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            aAPIs.forEach(function (oAPI, i) {                                                                                                                                                                                                                 
                oModel.read("/APIAAPIs", {                                                                                                                                                                                                                     
                    groupId: sGroupId,                                                                                                                                                                                                                         
                    filters: [new Filter("ApiName", FilterOperator.EQ, oAPI.apiName)],                                                                                                                                                                         
                    success: function (oData) {                                                                                                                                                                                                                
                        aResults[i] = oData.results || [];                                                                                                                                                                                                     
                        iReadsDone++; fnTryMerge();                                                                                                                                                                                                            
                    },                                                                                                                                                                                                                                         
                    error: function () { aResults[i] = []; iReadsDone++; fnTryMerge(); }                                                                                                                                                                       
                });                                                                                                                                                                                                                                            
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            oModel.submitChanges({                                                                                                                                                                                                                             
                groupId: sGroupId,                                                                                                                                                                                                                             
                success: function () { bBatchDone = true; fnTryMerge(); },                                                                                                                                                                                     
                error: function () {                                                                                                                                                                                                                           
                    this._apiaAllApis = [];                                                                                                                                                                                                                    
                    oApiView.setData({ items: [], busy: false, noDataText: this._fetchi18nText("apiaFailedToLoad"), savedCount: this._apiaSavedSelections.length });                                                                                           
                    this._apiaUpdateCount("apiaApiCount", 0);                                                                                                                                                                                                  
                }.bind(this)                                                                                                                                                                                                                                   
            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
