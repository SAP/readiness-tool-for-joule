            });                                                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _craTriggerAutoResize: function () {                                                                                                                                                                                                                   
            var oThis  = this;                                                                                                                                                                                                                                 
            var oTable = sap.ui.getCore().byId("craMatrixTable");                                                                                                                                                                                              
            if (!oTable || oThis._bCRAAutoResizePending) { return; }                                                                                                                                                                                           
            oThis._bCRAAutoResizePending = true;                                                                                                                                                                                                               
            var oDelegate = {                                                                                                                                                                                                                                  
                onAfterRendering: function () {                                                                                                                                                                                                                
                    oTable.removeEventDelegate(oDelegate);                                                                                                                                                                                                     
                    requestAnimationFrame(function () {                                                                                                                                                                                                        
                        requestAnimationFrame(function () {                                                                                                                                                                                                    
                            oThis._bCRAAutoResizePending = false;                                                                                                                                                                                              
                            var iColCount = oTable.getColumns().length;                                                                                                                                                                                        
                            for (var i = 0; i < iColCount; i++) {                                                                                                                                                                                              
                                oTable.autoResizeColumn(i);                                                                                                                                                                                                    
                            }                                                                                                                                                                                                                                  
                        });                                                                                                                                                                                                                                    
                    });                                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
            };                                                                                                                                                                                                                                                 
            oTable.addEventDelegate(oDelegate);                                                                                                                                                                                                                
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        // ── CRA Analysis History ──────────────────────────────────────────────                                                                                                                                                                              
                                                                                                                                                                                                                                                               
        _craBuildRoleScenarioMatrix: function (aResults, aPersistedRoles, mRoleDescriptions, mScenDescriptions, mCapDescriptions) {                                                                                                                            
            var aRoles = (aPersistedRoles || []).map(function (r) {                                                                                                                                                                                            
                return {                                                                                                                                                                                                                                       
                    RoleName:        r.RoleName,                                                                                                                                                                                                               
                    RoleDescription: mRoleDescriptions ? (mRoleDescriptions[r.RoleName] || "") : ""                                                                                                                                                            
                };                                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var mScenSeen  = {};                                                                                                                                                                                                                               
            var aScenarios = [];                                                                                                                                                                                                                               
            aResults.forEach(function (r) {                                                                                                                                                                                                                    
                var sKey = r.CapabilityName + "\x00" + r.ScenarioName;                                                                                                                                                                                         
                if (!mScenSeen[sKey]) {                                                                                                                                                                                                                        
                    mScenSeen[sKey] = true;                                                                                                                                                                                                                    
                    aScenarios.push({                                                                                                                                                                                                                          
                        CapabilityName:       r.CapabilityName,                                                                                                                                                                                                
                        CapabilityDisplayName: mCapDescriptions                                                                                                                                                                                                
                            ? (mCapDescriptions[r.CapabilityName] || "")                                                                                                                                                                                       
                            : "",                                                                                                                                                                                                                              
                        ScenarioName:         r.ScenarioName,                                                                                                                                                                                                  
                        ScenarioDescription:  mScenDescriptions                                                                                                                                                                                                
                            ? (mScenDescriptions[r.CapabilityName + "\x00" + r.ScenarioName] || "")                                                                                                                                                            
                            : ""                                                                                                                                                                                                                               
                    });                                                                                                                                                                                                                                        
                }                                                                                                                                                                                                                                              
            });                                                                                                                                                                                                                                                
            aScenarios.sort(function (a, b) {                                                                                                                                                                                                                  
                if (a.CapabilityName !== b.CapabilityName) {                                                                                                                                                                                                   
                    return a.CapabilityName < b.CapabilityName ? -1 : 1;                                                                                                                                                                                       
                }                                                                                                                                                                                                                                              
                return a.ScenarioName < b.ScenarioName ? -1 : 1;                                                                                                                                                                                               
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var mLookup = {};                                                                                                                                                                                                                                  
            aResults.forEach(function (r) {                                                                                                                                                                                                                    
                mLookup[r.RoleName + "\x00" + r.CapabilityName + "\x00" + r.ScenarioName] = r;                                                                                                                                                                 
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            var aRows = aRoles.map(function (oRole) {                                                                                                                                                                                                          
                var aCells = aScenarios.map(function (oScen) {                                                                                                                                                                                                 
                    var oResult = mLookup[                                                                                                                                                                                                                     
                        oRole.RoleName + "\x00" + oScen.CapabilityName + "\x00" + oScen.ScenarioName                                                                                                                                                           
                    ];                                                                                                                                                                                                                                         
                    if (!oResult) { return null; }                                                                                                                                                                                                             
                    return {                                                                                                                                                                                                                                   
                        RoleName:       oRole.RoleName,                                                                                                                                                                                                        
                        CapabilityName: oScen.CapabilityName,                                                                                                                                                                                                  
                        ScenarioName:   oScen.ScenarioName,                                                                                                                                                                                                    
                        Coverage:       oResult.Coverage,                                                                                                                                                                                                      
                        RequiredTM:     oResult.RequiredTM,                                                                                                                                                                                                    
                        CoveredTM:      oResult.CoveredTM,                                                                                                                                                                                                     
                        RequiredAPI:    oResult.RequiredAPI,                                                                                                                                                                                                   
                        CoveredAPI:     oResult.CoveredAPI                                                                                                                                                                                                     
                    };                                                                                                                                                                                                                                         
                });                                                                                                                                                                                                                                            
                return {                                                                                                                                                                                                                                       
                    RoleName:        oRole.RoleName,                                                                                                                                                                                                           
                    RoleDescription: oRole.RoleDescription,                                                                                                                                                                                                    
                    cells:           aCells                                                                                                                                                                                                                    
                };                                                                                                                                                                                                                                             
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            return { scenarios: aScenarios, rows: aRows };                                                                                                                                                                                                     
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        _applyAllCRAFilters: function () {                                                                                                                                                                                                                     
            var oCraModel = this.getModel("craModel");                                                                                                                                                                                                         
            var oMatrix   = oCraModel.getProperty("/matrix");                                                                                                                                                                                                  
            if (!oMatrix) { return; }                                                                                                                                                                                                                          
                                                                                                                                                                                                                                                               
            var aRoleKeys = oCraModel.getProperty("/matrixFilters/roleKeys")       || [];                                                                                                                                                                      
            var aCapKeys  = oCraModel.getProperty("/matrixFilters/capabilityKeys") || [];                                                                                                                                                                      
            var aScenKeys = oCraModel.getProperty("/matrixFilters/scenarioKeys")   || [];                                                                                                                                                                      
            var aCovKeys  = oCraModel.getProperty("/matrixFilters/coverageKeys")   || [];                                                                                                                                                                      
                                                                                                                                                                                                                                                               
            // Step 1: Capability + Scenario keys → visible scenario columns                                                                                                                                                                                   
            var aVisScens = oMatrix.scenarios.filter(function (oScen) {                                                                                                                                                                                        
                var bCap  = aCapKeys.length  === 0 || aCapKeys.indexOf(oScen.CapabilityName) >= 0;                                                                                                                                                             
                var bScen = aScenKeys.length === 0 ||                                                                                                                                                                                                          
                    aScenKeys.indexOf(oScen.CapabilityName + "\x00" + oScen.ScenarioName) >= 0;                                                                                                                                                                
                return bCap && bScen;                                                                                                                                                                                                                          
            });                                                                                                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // Step 2: Role keys → visible row objects (needed for coverage step)                                                                                                                                                                              
            var aAllRows = oMatrix.rows;                                                                                                                                                                                                                       
            var aVisRows = aRoleKeys.length === 0                                                                                                                                                                                                              
                ? aAllRows                                                                                                                                                                                                                                     
                : aAllRows.filter(function (r) { return aRoleKeys.indexOf(r.RoleName) >= 0; });                                                                                                                                                                
                                                                                                                                                                                                                                                               
            // Step 3: Coverage filter — prunes columns first, then rows                                                                                                                                                                                       
            if (aCovKeys.length > 0) {                                                                                                                                                                                                                         
                // Build original-index lookup once                                                                                                                                                                                                            
                var mScenIdx = {};                                                                                                                                                                                                                             
                oMatrix.scenarios.forEach(function (oScen, i) {                                                                                                                                                                                                
                    mScenIdx[oScen.CapabilityName + "\x00" + oScen.ScenarioName] = i;                                                                                                                                                                          
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                // Keep column if at least one visible row has a matching coverage in it                                                                                                                                                                       
                var aFinalScens = aVisScens.filter(function (oScen) {                                                                                                                                                                                          
                    var iIdx = mScenIdx[oScen.CapabilityName + "\x00" + oScen.ScenarioName];                                                                                                                                                                   
                    if (iIdx === undefined) { return false; }                                                                                                                                                                                                  
                    return aVisRows.some(function (oRow) {                                                                                                                                                                                                     
                        var oCell = oRow.cells[iIdx];                                                                                                                                                                                                          
                        return oCell && aCovKeys.indexOf(oCell.Coverage) >= 0;                                                                                                                                                                                 
                    });                                                                                                                                                                                                                                        
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                // Keep row if at least one kept column has a matching coverage in it                                                                                                                                                                          
                var aFinalRows = aVisRows.filter(function (oRow) {                                                                                                                                                                                             
                    return aFinalScens.some(function (oScen) {                                                                                                                                                                                                 
                        var iIdx = mScenIdx[oScen.CapabilityName + "\x00" + oScen.ScenarioName];                                                                                                                                                               
                        if (iIdx === undefined) { return false; }                                                                                                                                                                                              
                        var oCell = oRow.cells[iIdx];                                                                                                                                                                                                          
                        return oCell && aCovKeys.indexOf(oCell.Coverage) >= 0;                                                                                                                                                                                 
                    });                                                                                                                                                                                                                                        
                });                                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                               
                aVisScens = aFinalScens;                                                                                                                                                                                                                       
                aVisRows  = aFinalRows;                                                                                                                                                                                                                        
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            // Step 4: Apply column visibility                                                                                                                                                                                                                 
            this._craTriggerAutoResize();                                                                                                                                                                                                                      
            this._craUpdateMatrixColumns(aVisScens);                                                                                                                                                                                                           
                                                                                                                                                                                                                                                               
            // Step 5: Apply row filter — explicitly distinguish "no filter" from "zero matches"                                                                                                                                                               
            var oTable   = sap.ui.getCore().byId("craMatrixTable");                                                                                                                                                                                            
            var oBinding = oTable ? oTable.getBinding("rows") : null;                                                                                                                                                                                          
            if (!oBinding) { return; }                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            var bRowFilterActive = aRoleKeys.length > 0 || aCovKeys.length > 0;                                                                                                                                                                                
            if (!bRowFilterActive) {                                                                                                                                                                                                                           
                // No row-related filters: show all rows                                                                                                                                                                                                       
                oBinding.filter([], sap.ui.model.FilterType.Application);                                                                                                                                                                                      
            } else if (aVisRows.length === 0) {                                                                                                                                                                                                                
                // Filters active but nothing matches — show empty table (never falls back to all rows)                                                                                                                                                        
                oBinding.filter(                                                                                                                                                                                                                               
                    [new Filter("RoleName", FilterOperator.EQ, "\x00")],                                                                                                                                                                                       
                    sap.ui.model.FilterType.Application                                                                                                                                                                                                        
                );                                                                                                                                                                                                                                             
            } else {                                                                                                                                                                                                                                           
                oBinding.filter(                                                                                                                                                                                                                               
                    [new Filter({                                                                                                                                                                                                                              
                        filters: aVisRows.map(function (r) {                                                                                                                                                                                                   
                            return new Filter("RoleName", FilterOperator.EQ, r.RoleName);                                                                                                                                                                      
                        }),                                                                                                                                                                                                                                    
                        and: false                                                                                                                                                                                                                             
                    })],                                                                                                                                                                                                                                       
                    sap.ui.model.FilterType.Application                                                                                                                                                                                                        
                );                                                                                                                                                                                                                                             
            }                                                                                                                                                                                                                                                  
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
