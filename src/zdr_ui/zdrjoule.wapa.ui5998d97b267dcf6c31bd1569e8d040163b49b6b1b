        _applyCRAHistoryFilters: function () {                                                                                                                                                                                                                 
            var oTable   = sap.ui.getCore().byId("craHistoryTable");                                                                                                                                                                                           
            if (!oTable) { return; }                                                                                                                                                                                                                           
            var oBinding = oTable.getBinding("items");                                                                                                                                                                                                         
            if (!oBinding) { return; }                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            var aFilters = [];                                                                                                                                                                                                                                 
            var sQuery   = (this._sCRAHistorySearchQuery || "").trim();                                                                                                                                                                                        
            var sStatus  = this.getModel("craModel").getProperty("/historyStatus") || "ALL";                                                                                                                                                                   
                                                                                                                                                                                                                                                               
            if (sQuery) {                                                                                                                                                                                                                                      
                aFilters.push(new Filter({                                                                                                                                                                                                                     
                    filters: [                                                                                                                                                                                                                                 
                        new Filter("CreatedBy", FilterOperator.Contains, sQuery),                                                                                                                                                                              
                        new Filter("Status",    FilterOperator.Contains, sQuery)                                                                                                                                                                               
                    ],                                                                                                                                                                                                                                         
                    and: false                                                                                                                                                                                                                                 
                }));                                                                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            if (sStatus !== "ALL") {                                                                                                                                                                                                                           
                aFilters.push(new Filter("Status", FilterOperator.EQ, sStatus));                                                                                                                                                                               
            }                                                                                                                                                                                                                                                  
                                                                                                                                                                                                                                                               
            oBinding.filter(aFilters, sap.ui.model.FilterType.Application);                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
