        _applyScenarioFilters: function () {                                                                                                                                                                                                                   
            var oTable = sap.ui.getCore().byId("idScenariosTable");                                                                                                                                                                                            
            if (!oTable) { return; }                                                                                                                                                                                                                           
            var oBinding = oTable.getBinding("items");                                                                                                                                                                                                         
            if (!oBinding) { return; }                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
            var aFilters = [];                                                                                                                                                                                                                                 
            var sQuery = (this._sScenarioSearchQuery || "").trim();                                                                                                                                                                                            
            var sStatus = this._sScenarioSelectedStatus || "All";                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            if (sQuery) {                                                                                                                                                                                                                                      
                aFilters.push(new sap.ui.model.Filter({                                                                                                                                                                                                        
                    filters: [                                                                                                                                                                                                                                 
                        new sap.ui.model.Filter("ScenarioName", sap.ui.model.FilterOperator.Contains, sQuery),                                                                                                                                                 
                        new sap.ui.model.Filter("ScenarioDescription", sap.ui.model.FilterOperator.Contains, sQuery),                                                                                                                                          
                        new sap.ui.model.Filter("Namespace", sap.ui.model.FilterOperator.Contains, sQuery),                                                                                                                                                    
                        new sap.ui.model.Filter("TargetFunction", sap.ui.model.FilterOperator.Contains, sQuery)                                                                                                                                                
                    ],                                                                                                                                                                                                                                         
                    and: false                                                                                                                                                                                                                                 
                }));                                                                                                                                                                                                                                           
            }                                                                                                                                                                                                                                                  
            if (sStatus !== "All") {                                                                                                                                                                                                                           
                aFilters.push(new sap.ui.model.Filter("ScenarioHealthState", sap.ui.model.FilterOperator.EQ, sStatus));                                                                                                                                        
            }                                                                                                                                                                                                                                                  
            oBinding.filter(aFilters, sap.ui.model.FilterType.Application);                                                                                                                                                                                    
        },                                                                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
        onRefreshScenarios: function () {                                                                                                                                                                                                                      
