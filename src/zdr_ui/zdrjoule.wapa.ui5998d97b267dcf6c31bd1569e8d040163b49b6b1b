        _initializeCapabilitiesDataModel: function () {                                                                                                                                                                                                        
            var oModel = this.getModel("capabilitiesModel");                                                                                                                                                                                                   
            oModel.setSizeLimit(1000);                                                                                                                                                                                                                         
            var oCapPath = this._getEntitySPath(ENTITY_USAGE.FETCH_CAPABILITIES);                                                                                                                                                                              
                                                                                                                                                                                                                                                               
            // Fetch count first so we can show a meaningful BusyDialog message                                                                                                                                                                                
            oModel.read(oCapPath.path, {                                                                                                                                                                                                                       
                filters: oCapPath.filters,                                                                                                                                                                                                                     
                urlParameters: { "$top": "0", "$inlinecount": "allpages" },                                                                                                                                                                                    
                success: function (oCountData) {                                                                                                                                                                                                               
