            // TMs — Activation: W = partially inactive (dependency)                                                                                                                                                                                           
            var aWarningTMs = aTMs.filter(function (r) { return r.ActivationStatus === "W"; });                                                                                                                                                                
            if (aWarningTMs.length > 0) {                                                                                                                                                                                                                      
                var sTMWarnNames = aWarningTMs.map(function (r) { return r.FioriAppName ? (r.FioriAppName + " (" + r.SemanticObject + "-" + r.SemanticAction + ")") : (r.SemanticObject + "-" + r.SemanticAction); }).join(", ");                              
                aItems.push(fnSetAction(fnItem(                                                                                                                                                                                                                
