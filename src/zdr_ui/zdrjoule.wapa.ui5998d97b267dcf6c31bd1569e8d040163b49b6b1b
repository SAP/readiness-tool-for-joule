                            // 3. Capability display names from /Capabilities                                                                                                                                                                                  
                            if (aUniqueCaps.length > 0) {                                                                                                                                                                                                      
                                var sCapFilterDisp = aUniqueCaps.map(function (c) {                                                                                                                                                                            
                                    return "CapabilityName eq '" + c + "'";                                                                                                                                                                                    
                                }).join(" or ");                                                                                                                                                                                                               
                                                                                                                                                                                                                                                               
                                var mCapDispSeenNext = {};                                                                                                                                                                                                     
                                                                                                                                                                                                                                                               
                                function fnReadCapDisp(mUrlParams) {                                                                                                                                                                                           
                                    var mCp = {                                                                                                                                                                                                                
                                        success: function (oCapData) {                                                                                                                                                                                         
                                            (oCapData.results || []).forEach(function (c) {                                                                                                                                                                    
                                                mCapDescriptions[c.CapabilityName] = c.CapabilityDisplayName || "";                                                                                                                                            
                                            });                                                                                                                                                                                                                
                                            if (!oCapData.__next) {                                                                                                                                                                                            
