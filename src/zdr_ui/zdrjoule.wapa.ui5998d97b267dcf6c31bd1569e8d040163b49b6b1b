                            return;                                                                                                                                                                                                                            
                        }                                                                                                                                                                                                                                      
                                                                                                                                                                                                                                                               
                        fnReadPage(mNextParameters);                                                                                                                                                                                                           
                    },                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                               
                    error: function () {                                                                                                                                                                                                                       
                        fnFail();                                                                                                                                                                                                                              
                    }                                                                                                                                                                                                                                          
                };                                                                                                                                                                                                                                             
                                                                                                                                                                                                                                                               
                if (mUrlParameters) {                                                                                                                                                                                                                          
                    mReadParameters.urlParameters = mUrlParameters;                                                                                                                                                                                            
                }                                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                               
                oModel.read(sPath, mReadParameters);                                                                                                                                                                                                           
